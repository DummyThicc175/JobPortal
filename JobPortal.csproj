<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**;artifacts\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Backend\Data\Scripts\ConsolidateCv.Before.sql" LogicalName="JobPortal.Migrations.ConsolidateCv.Before.sql" />
    <EmbeddedResource Include="Backend\Data\Scripts\ConsolidateCv.After.sql" LogicalName="JobPortal.Migrations.ConsolidateCv.After.sql" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.24" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="8.0.24" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.24" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.24" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.24">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="8.0.23" />
  </ItemGroup>

  <ItemGroup>
    <!-- Preserve MVC/Identity virtual paths while keeping all views in Frontend. -->
    <Content Remove="Frontend\**\*.cshtml" />
    <Content Include="Frontend\**\*.cshtml" Link="%(RecursiveDir)%(Filename)%(Extension)" />

    <!-- Custom web root: copy assets and uploaded files for both run and publish. -->
    <Content Remove="Frontend\wwwroot\**\*" />
    <None Remove="Frontend\wwwroot\**\*" />
    <Content Include="Frontend\wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Remove="Backend\Storage\cvs\**\*.pdf" />
    <Content Include="Backend\Storage\cvs\**\*.pdf" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
