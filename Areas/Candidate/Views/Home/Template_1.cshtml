@model JobPortal.Models.CreateCVViewModel
<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <style>
        body { font-family: Arial, sans-serif; color:#222; }
        .header { background:#0b63d3; color:#fff; padding:20px; }
    </style>
</head>
<body>
    <div class="header">
        <h1>@Model.FullName</h1>
        <div>@Model.Title</div>
    </div>

    <section style="padding:16px">
        <h3>Tóm tắt</h3>
        <p>@Model.Summary</p>

        <h3>Kỹ năng</h3>
        <ul>
            @if(Model.Skills != null) {
                foreach(var s in Model.Skills) { <li>@s</li>; }
            }
        </ul>
    </section>
</body>
</html>