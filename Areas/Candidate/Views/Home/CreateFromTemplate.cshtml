@model JobPortal.Models.CreateCVViewModel
@{
    ViewData["Title"] = "Tạo CV";
}
<div class="container">
    <div class="row">
        <div class="col-md-5">
            <form id="cvForm" method="post" asp-action="SaveGeneratedCV" asp-area="Candidate">
                <input type="hidden" name="TemplateViewPath" value="@Model.TemplateViewPath" />
                <div class="mb-2"><label>Họ và tên</label>
                    <input name="FullName" class="form-control" value="@Model.FullName" /></div>
                <div class="mb-2"><label>Tiêu đề</label>
                    <input name="Title" class="form-control" /></div>
                <div class="mb-2"><label>Tóm tắt</label>
                    <textarea name="Summary" class="form-control"></textarea></div>

                <button type="button" id="btnPreview" class="btn btn-outline-primary">Xem trước</button>
                <button type="submit" class="btn btn-primary">Lưu</button>
            </form>
        </div>

        <div class="col-md-7">
            <iframe id="previewFrame" style="width:100%;height:700px;border:1px solid #ddd"></iframe>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.getElementById('btnPreview').addEventListener('click', async function(){
    var form = new FormData(document.getElementById('cvForm'));
    const resp = await fetch('@Url.Action("TemplatePreview","Home", new { area = "Candidate" })', { method: 'POST', body: form, headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value }});
    const html = await resp.text();
    document.getElementById('previewFrame').srcdoc = html;
});
</script>
}
