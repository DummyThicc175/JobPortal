@model JobPortal.Models.EditCVViewModel

@{
    ViewData["Title"] = "Thiết kế CV";
    Layout = "~/Views/Shared/_LayoutCV.cshtml";
}

<!-- Thư viện hỗ trợ Cắt ảnh & Icon -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    .edit-container {
        margin-top: 0;
        height: calc(100vh - 60px);
        overflow: hidden;
    }

    .sidebar-edit {
        background: #f4f7fa;
        border-right: 1px solid #e0e0e0;
        overflow-y: auto;
        padding: 25px;
        height: 100%;
    }

    .preview-section {
        background: #525659;
        overflow-y: auto;
        padding: 50px;
        display: flex;
        justify-content: center;
        height: 100%;
    }

    .cv-paper {
        width: 210mm;
        min-height: 297mm;
        background: white;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        transform: scale(0.75);
        transform-origin: top center;
        margin-bottom: 50px;
    }

    .section-title {
        border-left: 4px solid #7a0012;
        padding-left: 10px;
        margin: 20px 0 15px 0;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 15px;
        color: #7a0012;
    }

    .form-control {
        border: 1px solid #dce0e4;
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 14px;
        transition: all 0.2s;
    }

        .form-control:focus {
            border-color: #7a0012;
            box-shadow: 0 0 0 3px rgba(122, 0, 18, 0.1);
        }

    .img-container {
        background-color: #f7f7f7;
        width: 100%;
        height: 350px;
        text-align: center;
        overflow: hidden;
    }

    .cursor-pointer {
        cursor: pointer;
    }

    /* Accordion Style cho Kinh nghiệm */
    .exp-item {
        transition: all 0.3s;
    }

    .exp-header {
        background-color: #fff;
        cursor: pointer;
        user-select: none;
    }

        .exp-header:hover {
            background-color: #f8f9fa;
        }
</style>

<div class="container-fluid edit-container">
    <div class="row h-100">
        <!-- BÊN TRÁI: FORM NHẬP LIỆU -->
        <div class="col-md-4 col-lg-3 sidebar-edit">
            <div class="section-title">Thông tin cơ bản</div>

            <div class="bg-white p-3 rounded-3 shadow-sm border mb-4">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label-sm">Tiêu đề hồ sơ</label>
                        <input type="text" id="inJob" class="form-control" placeholder="VD: Nhân viên kinh doanh" oninput="updateCV()">
                    </div>

                    <div class="col-12">
                        <label class="form-label-sm">Họ và tên</label>
                        <input type="text" id="inName" class="form-control" value="@Model.FullName" oninput="updateCV()">
                    </div>

                    <div class="col-12">
                        <label class="form-label-sm">Ảnh hồ sơ</label>
                        <div class="d-flex align-items-center gap-3 bg-light p-2 rounded-3 border">
                            <img id="edit-avatar-preview" src="https://via.placeholder.com/80" class="rounded-circle border" style="width: 70px; height: 70px; object-fit: cover;">
                            <div class="flex-grow-1">
                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="triggerFileInput()">
                                    <i class="bi bi-upload me-1"></i>Tải lên
                                </button>
                                <div id="avatar-action-buttons" class="d-none mt-1">
                                    <small class="text-primary cursor-pointer me-2" onclick="triggerFileInput()">Sửa</small>
                                    <small class="text-danger cursor-pointer" onclick="deleteAvatar()">Xóa</small>
                                </div>
                            </div>
                        </div>
                        <input type="file" id="inAvatar" class="d-none" accept="image/*">
                    </div>

                    <div class="col-6">
                        <label class="form-label-sm">Email</label>
                        <input type="email" id="inEmail" class="form-control" placeholder="Email..." oninput="updateCV()">
                    </div>
                    <div class="col-6">
                        <label class="form-label-sm">Số điện thoại</label>
                        <input type="text" id="inPhone" class="form-control" placeholder="SĐT..." oninput="updateCV()">
                    </div>

                    <div class="col-12">
                        <label class="form-label-sm">Địa chỉ</label>
                        <input type="text" id="inAddress" class="form-control" placeholder="Địa chỉ..." oninput="updateCV()">
                    </div>

                    <div class="col-12">
                        <label class="form-label-sm">Mục tiêu nghề nghiệp</label>
                        <textarea id="inSummary" class="form-control" rows="4" oninput="updateCV()">@Model.Summary</textarea>
                    </div>
                </div>
            </div>

            <div class="section-title">Kinh nghiệm làm việc</div>
            <div id="exp-container">
                <!-- Mục kinh nghiệm mẫu -->
                <div class="exp-item bg-white border rounded-3 mb-3 shadow-sm overflow-hidden">
                    <div class="exp-header d-flex justify-content-between align-items-center p-3 border-bottom bg-light" onclick="toggleExp(this)">
                        <span class="fw-bold" style="font-size: 14px;"><i class="bi bi-chevron-down me-2"></i>Kinh nghiệm làm việc</span>
                        <button class="btn btn-sm btn-outline-danger border-0" onclick="removeExp(this, event)"><i class="bi bi-trash"></i></button>
                    </div>
                    <div class="p-3 exp-content">
                        <div class="mb-3">
                            <label class="form-label-sm">Tên công ty</label>
                            <input type="text" class="form-control inExpCompany" placeholder="Điền tên công ty" oninput="updateCV()">
                            <small class="text-danger d-none mt-1">Thông tin bắt buộc</small>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label-sm">Vị trí công việc</label>
                                <input type="text" class="form-control inExpRole" placeholder="VD: Nhân viên kinh doanh" oninput="updateCV()">
                            </div>
                            <div class="col-6">
                                <label class="form-label-sm">Thời gian</label>
                                <div class="d-flex gap-1">
                                    <input type="text" class="form-control inExpStart" placeholder="Bắt đầu" oninput="updateCV()">
                                    <input type="text" class="form-control inExpEnd" placeholder="Kết thúc" oninput="updateCV()">
                                </div>
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label-sm">Mô tả công việc</label>
                            <textarea class="form-control inExpDesc" rows="4" placeholder="Mô tả chi tiết công việc..." oninput="updateCV()"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-primary fw-bold cursor-pointer mb-4 small" onclick="addExp()">
                <i class="bi bi-plus-lg me-1"></i> Thêm kinh nghiệm làm việc
            </div>

            <hr>
            <button class="btn btn-primary w-100 py-2 fw-bold shadow-lg mb-5" onclick="saveCV()">LƯU CV NGAY</button>
        </div>

        <!-- BÊN PHẢI: BẢN XEM TRƯỚC -->
        <div class="col-md-8 col-lg-9 preview-section">
            <div id="cv-preview" class="cv-paper">
                @await Html.PartialAsync(Model.TemplatePath, Model)
            </div>
        </div>
    </div>
</div>

<!-- MODAL CẮT ẢNH (Giữ nguyên như cũ) -->
<div class="modal fade" id="cropperModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold">Cập nhật ảnh đại diện</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="img-container mb-3">
                    <img id="image-to-crop" src="">
                </div>
                <div class="row">
                    <div class="col-6">
                        <label class="small text-muted">Phóng thu</label>
                        <input type="range" class="form-range" id="zoomRange" min="0.1" max="3" step="0.1" value="1">
                    </div>
                    <div class="col-6">
                        <label class="small text-muted">Xoay</label>
                        <input type="range" class="form-range" id="rotateRange" min="-180" max="180" step="1" value="0">
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Huỷ</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" onclick="cropAndSave()">Hoàn tất</button>
            </div>
        </div>
    </div>
</div>

<script>
    // nhỏ: lấy id model/template từ Razor để gửi khi lưu (không thay đổi ảnh)
    var templateId = @Model.TemplateId;
    var modelId = @Model.Id;

    let cropper;
    let cropperModal;

    window.addEventListener('DOMContentLoaded', function () {
        const modalEl = document.getElementById('cropperModal');
        if (modalEl) cropperModal = new bootstrap.Modal(modalEl);

        const fileInput = document.getElementById('inAvatar');
        if (fileInput) {
            fileInput.onchange = function() { initCropper(this); };
        }

        // Chạy cập nhật lần đầu khi load trang
        updateCV();
    });

    function triggerFileInput() {
        document.getElementById('inAvatar').click();
    }

    function initCropper(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                const imageToCrop = document.getElementById('image-to-crop');
                imageToCrop.src = e.target.result;
                cropperModal.show();
                if (cropper) cropper.destroy();
                setTimeout(() => {
                    cropper = new Cropper(imageToCrop, {
                        aspectRatio: 1, // Để 1:1 cho ảnh tròn hoặc 180/200 tùy template
                        viewMode: 1,
                        dragMode: 'move',
                        autoCropArea: 0.8
                    });
                    document.getElementById('zoomRange').oninput = function() { cropper.zoomTo(this.value); };
                    document.getElementById('rotateRange').oninput = function() { cropper.rotateTo(this.value); };
                }, 400);
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function cropAndSave() {
        if (!cropper) return;
        const canvas = cropper.getCroppedCanvas({ width: 400, height: 400 });
        const croppedImageUrl = canvas.toDataURL('image/png');

        // 1. Cập nhật ảnh nhỏ bên cột trái
        document.getElementById('edit-avatar-preview').src = croppedImageUrl;

        // 2. Cập nhật ảnh vào CV bên phải (File T1)
        // Tìm cả 2 ID phổ biến để tránh lỗi
        const cvAvatar = document.getElementById('display-avatar') || document.getElementById('preview-avatar');
        if (cvAvatar) {
            cvAvatar.src = croppedImageUrl;
            cvAvatar.style.display = 'block'; // Quan trọng: Hiện ảnh nếu trước đó bị ẩn
        }

        // 3. Ẩn icon người dùng mặc định (nếu có)
        const placeholderIcon = document.getElementById('avatar-placeholder-icon');
        if (placeholderIcon) placeholderIcon.style.display = 'none';

        document.getElementById('avatar-action-buttons').classList.remove('d-none');
        cropperModal.hide();
    }

    function updateCV() {
        // Cập nhật Họ tên và Công việc
        const nameVal = document.getElementById('inName').value;
        const jobVal = document.getElementById('inJob').value;

        // Gán vào bản xem trước
        if(document.getElementById('display-name'))
            document.getElementById('display-name').innerText = nameVal || "HỌ VÀ TÊN";

        if(document.getElementById('display-job'))
            document.getElementById('display-job').innerText = jobVal || "VỊ TRÍ ỨNG TUYỂN";

        // Cập nhật Liên hệ (Email, SĐT, Địa chỉ)
        const email = document.getElementById('inEmail').value;
        const phone = document.getElementById('inPhone').value;
        const address = document.getElementById('inAddress').value;

        // Gánh trực tiếp vào ID trong T1 (nếu tồn tại)
        const dispPhone = document.getElementById('display-phone');
        const dispEmail = document.getElementById('display-email');
        const dispAddress = document.getElementById('display-address');

        if(dispPhone) dispPhone.innerText = phone || "Chưa cập nhật";
        if(dispEmail) dispEmail.innerText = email || "Chưa cập nhật";
        if(dispAddress) dispAddress.innerText = address || "Chưa cập nhật";

        // Cập nhật Giới thiệu bản thân
        if(document.getElementById('display-summary'))
            document.getElementById('display-summary').innerText = document.getElementById('inSummary').value || "Mục tiêu nghề nghiệp...";

        // Xử lý danh sách Kinh nghiệm làm việc
        updateExperienceList();
    }

    function updateExperienceList() {
        let html = "";
        document.querySelectorAll('.exp-item').forEach(item => {
            const role = item.querySelector('.inExpRole').value;
            const company = item.querySelector('.inExpCompany').value;
            const start = item.querySelector('.inExpStart').value;
            const end = item.querySelector('.inExpEnd').value;
            const desc = item.querySelector('.inExpDesc').value;

            if(role || company) {
                // escape desc newlines already handled when assigning innerHTML
                const safeDesc = (desc || '').replace(/\n/g, '<br>');
                html += `
                <div class="mb-4">
                    <div class="fw-bold text-uppercase" style="font-size:13px; color:#000;">${role || 'Vị trí'}</div>
                    <div class="d-flex justify-content-between">
                        <div class="text-danger small fw-bold">${company || 'Công ty'}</div>
                        <div class="text-muted" style="font-size:11px;">${start}${end ? ' - ' + end : ''}</div>
                    </div>
                    <div class="text-muted small mt-1" style="line-height:1.4;">${safeDesc}</div>
                </div>`;
            }
        });

        const expDisp = document.getElementById('display-exp-list');
        if(expDisp) expDisp.innerHTML = html || "Chưa có kinh nghiệm làm việc";
    }

    // Các hàm bổ trợ
    function toggleExp(header) {
        const content = header.nextElementSibling;
        content.classList.toggle('d-none');
    }

    function removeExp(btn, event) {
        event.stopPropagation();
        const container = document.getElementById('exp-container');
        if(container.children.length > 1) {
            btn.closest('.exp-item').remove();
            updateCV();
        }
    }

        function updateExperienceList() {
        let html = "";
        // Lặp qua các item đang nhập ở cột bên trái
        document.querySelectorAll('#exp-container .exp-item-input').forEach(item => {
            // Lưu ý: Kiểm tra class 'exp-item-input' hoặc selector đúng của bạn ở cột nhập liệu
            const role = item.querySelector('.inExpRole')?.value || '';
            const company = item.querySelector('.inExpCompany')?.value || '';
            const start = item.querySelector('.inExpStart')?.value || '';
            const end = item.querySelector('.inExpEnd')?.value || '';
            const desc = item.querySelector('.inExpDesc')?.value || '';

            if (role || company) {
                const duration = (start && end) ? `${start} - ${end}` : (start || end || '');

                // CẤU TRÚC NÀY PHẢI KHỚP 100% VỚI FILE .CSHTML BẠN GỬI
                html += `
                <div class="exp-item">
                    <div class="exp-title">${role || 'VỊ TRÍ CÔNG VIỆC'}</div>
                    <div class="exp-info">${company || 'Tên công ty'} | ${duration}</div>
                    <div class="text-block">${desc.replace(/\n/g, '<br>')}</div>
                </div>`;
            }
        });

        const expDisp = document.getElementById('display-exp-list');
        if (expDisp) {
            expDisp.innerHTML = html;
        }
    }

    // --- SaveCV: gửi JSON lên HomeController.SaveCV để lưu vào DB ---
    function saveCV() {
        // Thu thập experiences
        const experiences = [];
        document.querySelectorAll('#exp-container .exp-item').forEach(item => {
            experiences.push({
                Company: item.querySelector('.inExpCompany').value || '',
                Role: item.querySelector('.inExpRole').value || '',
                Duration: (item.querySelector('.inExpStart').value || '') + ((item.querySelector('.inExpStart').value || item.querySelector('.inExpEnd').value) ? ' - ' : '') + (item.querySelector('.inExpEnd').value || ''),
                Description: item.querySelector('.inExpDesc').value || ''
            });
        });

        // Lấy avatar hiện tại (có thể là dataURL hoặc đường dẫn server)
        const cvAvatarEl = document.getElementById('display-avatar') || document.getElementById('preview-avatar');
        const avatarPath = cvAvatarEl ? cvAvatarEl.src : (document.getElementById('edit-avatar-preview').src || '');

        const payload = {
            Id: modelId || 0,
            TemplateId: templateId || 0,
            FullName: document.getElementById('inName').value || '',
            JobTitle: document.getElementById('inJob').value || '',
            Email: document.getElementById('inEmail').value || '',
            Phone: document.getElementById('inPhone').value || '',
            Address: document.getElementById('inAddress').value || '',
            Summary: document.getElementById('inSummary').value || '',
            AvatarPath: avatarPath || '',
            Website: '',
            Educations: [],          // nếu có mục Education bạn có thể thu thập tương tự
            Experiences: experiences,
            Languages: [],           // nếu bạn thêm ngoại ngữ, thu thập vào đây
            ITSKills: [],            // nếu bạn thêm tin học, thu thập vào đây
            References: [],          // nếu có người liên hệ, thu thập vào đây
            Interests: '',           // map từ inSkills nếu có
            Activities: '',          // map từ activity-container nếu có
            Certifications: ''       // map từ inCert nếu có
        };

        // Gửi AJAX POST JSON
        fetch('/Candidate/Home/SaveCV', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(json => {
            if (json && json.success) {
                alert('Lưu CV thành công.');
                if (json.id) modelId = json.id; // cập nhật modelId nếu server trả về
            } else {
                alert((json && json.message) ? json.message : 'Lưu thất bại.');
                console.error('SaveCV response:', json);
            }
        })
        .catch(err => {
            console.error('SaveCV error:', err);
            alert('Lỗi khi lưu CV. Kiểm tra console/network.');
        });
    }
</script>