@model JobPortal.Models.EditCVViewModel

<div class="container-fluid bg-light">
    <div class="row" style="height: 100vh;">
        <!-- CỘT TRÁI: FORM NHẬP LIỆU -->
        <div class="col-md-5 bg-white shadow-sm overflow-auto p-4">
            <h4 class="fw-bold mb-4">Thông tin CV</h4>

            <!-- Thông tin cơ bản -->
            <div class="mb-4 border-bottom pb-3">
                <h6><i class="bi bi-person-circle"></i> Thông tin cá nhân</h6>
                <input type="text" id="inName" class="form-control mb-2" placeholder="Họ và tên" asp-for="FullName">
                <input type="text" id="inJob" class="form-control mb-2" placeholder="Vị trí ứng tuyển">
                <textarea id="inSummary" class="form-control" rows="3" placeholder="Giới thiệu bản thân"></textarea>
            </div>

            <!-- Kinh nghiệm làm việc -->
            <div id="exp-container" class="mb-4">
                <h6><i class="bi bi-briefcase"></i> Kinh nghiệm làm việc</h6>
                <!-- Item mẫu đầu tiên -->
                <div class="exp-item border rounded p-2 mb-2 bg-light position-relative">
                    <input type="text" class="form-control mb-1 inExpCompany" placeholder="Tên công ty" oninput="updateExpPreview()">
                    <input type="text" class="form-control mb-1 inExpRole" placeholder="Vị trí (VD: Dev .NET)" oninput="updateExpPreview()">
                    <textarea class="form-control inExpDesc" placeholder="Mô tả chi tiết công việc" oninput="updateExpPreview()"></textarea>
                </div>
            </div>

            <!-- Nút thêm kinh nghiệm -->
            <button type="button" class="btn btn-outline-primary btn-sm w-100 mb-3" onclick="addExperience()">+ Thêm kinh nghiệm</button>

            <button type="button" class="btn btn-success w-100 py-2 mt-3" onclick="saveFullCV()">HOÀN TẤT & LƯU CV</button>
        </div>

        <!-- CỘT PHẢI: BẢN XEM TRƯỚC (LIVE PREVIEW) -->
        <div class="col-md-7 d-flex justify-content-center align-items-start p-5" style="background: #525659; overflow-y: auto;">
            <div id="cv-preview-paper" class="bg-white shadow-lg p-5" style="width: 210mm; min-height: 297mm;">
                <!-- Load nội dung Template từ Partial View -->
                @Html.Partial(Model.TemplatePath, Model)
            </div>
        </div>
    </div>
</div>

<!-- SCRIPT "GÕ ĐÂU HIỆN ĐÓ" NÂNG CẤP -->
<script>
    // 1. Đồng bộ thông tin cơ bản
    document.getElementById('inName').addEventListener('input', function() {
        document.querySelector('.cv-name').innerText = this.value || "HỌ TÊN CỦA BẠN";
    });

    document.getElementById('inJob').addEventListener('input', function() {
        document.querySelector('.cv-job').innerText = this.value || "Vị trí ứng tuyển";
    });

    // 2. Hàm thêm mới khối kinh nghiệm
    function addExperience() {
        const container = document.getElementById('exp-container');
        const newItem = `
            <div class="exp-item border rounded p-2 mb-2 bg-light position-relative">
                <button type="button" class="btn-close position-absolute end-0 top-0 m-1" style="font-size: 10px;" onclick="this.parentElement.remove(); updateExpPreview();"></button>
                <input type="text" class="form-control mb-1 inExpCompany" placeholder="Tên công ty" oninput="updateExpPreview()">
                <input type="text" class="form-control mb-1 inExpRole" placeholder="Vị trí (VD: Dev .NET)" oninput="updateExpPreview()">
                <textarea class="form-control inExpDesc" placeholder="Mô tả chi tiết công việc" oninput="updateExpPreview()"></textarea>
            </div>`;
        container.insertAdjacentHTML('beforeend', newItem);
    }

    // 3. Hàm cập nhật nội dung kinh nghiệm sang Preview
    function updateExpPreview() {
        let html = "";
        document.querySelectorAll('.exp-item').forEach(item => {
            let company = item.querySelector('.inExpCompany').value;
            let role = item.querySelector('.inExpRole').value;
            let desc = item.querySelector('.inExpDesc').value;

            if (company || role) {
                html += `
                    <div class="cv-item mb-3">
                        <div class="fw-bold" style="color: #333;">${role}</div>
                        <div class="text-primary italic">${company}</div>
                        <div style="font-size: 0.9em; color: #666;">${desc}</div>
                    </div>`;
            }
        });
        document.querySelector('.cv-exp-list').innerHTML = html;
    }

    // 4. Hàm lưu CV (Gửi về Controller)
    async function saveFullCV() {
        const data = {
            FullName: document.getElementById('inName').value,
            JobTitle: document.getElementById('inJob').value,
            Summary: document.getElementById('inSummary').value,
            Experiences: []
        };

        document.querySelectorAll('.exp-item').forEach(item => {
            data.Experiences.push({
                Company: item.querySelector('.inExpCompany').value,
                Role: item.querySelector('.inExpRole').value,
                Description: item.querySelector('.inExpDesc').value
            });
        });

        console.log("Dữ liệu gửi đi:", data);
        alert("Đã nhấn lưu! Kiểm tra console log để xem dữ liệu.");
        // Tại đây bạn dùng fetch() để gửi data qua SaveCV Action trong Controller
    }
</script>