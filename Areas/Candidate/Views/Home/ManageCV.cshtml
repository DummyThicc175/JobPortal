@model IEnumerable<JobPortal.Models.CV>

@{
    ViewData["Title"] = "Trang trí CV - JobHub";
    Layout = "~/Views/Shared/_LayoutCV.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    :root {
        --primary-jobhub: #4460ef;
        --soft-bg: #f8fafc;
    }

    .manage-container {
        max-width: 1300px;
        margin: 20px auto;
        padding: 0 15px;
    }

    /* Sidebar Style */
    .sidebar-card {
        border-radius: 16px;
        background: #fff;
        padding: 24px;
        border: 1px solid #edf2f7;
        margin-bottom: 20px;
    }

    .sidebar-menu a {
        display: flex;
        gap: 12px;
        align-items: center;
        padding: 12px 16px;
        border-radius: 12px;
        color: #64748b;
        text-decoration: none;
        transition: 0.3s;
    }

        .sidebar-menu a.active {
            background: #f0f7ff;
            color: var(--primary-jobhub);
            font-weight: 700;
        }

        .sidebar-menu a:hover:not(.active) {
            background: #f8fafc;
            color: #1e293b;
        }

    /* Grid & Card Style */
    .grid-cols {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 24px;
    }

    .template-card {
        border-radius: 16px;
        overflow: hidden;
        background: #fff;
        border: 1px solid #e2e8f0;
        transition: all 0.3s ease;
        position: relative;
    }

        .template-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
            border-color: var(--primary-jobhub);
        }

    .badge-new {
        position: absolute;
        right: 10px;
        top: 10px;
        background: #ff4757;
        color: #fff;
        padding: 4px 12px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 11px;
        z-index: 10;
    }

    /* Filter Pill Style */
    .pill {
        cursor: pointer;
        padding: 8px 20px;
        border-radius: 50px;
        background: #fff;
        border: 1px solid #e2e8f0;
        font-size: 14px;
        font-weight: 600;
        transition: 0.3s;
        margin-right: 8px;
    }

        .pill.active {
            background: var(--primary-jobhub);
            color: #fff;
            border-color: var(--primary-jobhub);
        }
</style>

<div class="manage-container">
    <div class="row">
        <!-- SIDEBAR -->
        <div class="col-lg-3">
            <div class="sidebar-card text-center">
                <div class="position-relative d-inline-block mb-3">
                    <img src="https://ui-avatars.com/api/?name=Thao+Anh&background=4460ef&color=fff" class="rounded-circle shadow-sm" width="90" />
                    <span class="position-absolute bottom-0 end-0 bg-success border border-white rounded-circle" style="width:15px; height:15px;"></span>
                </div>
                <h5 class="fw-bold mb-1">Thảo Anh</h5>
                <p class="text-muted small">Lập trình viên</p>

                <div class="sidebar-menu text-start mt-4">
                    <a href="#"><i class="fa-regular fa-circle-user"></i> Hồ sơ của tôi</a>
                    <a class="active" href="#"><i class="fa-solid fa-wand-magic-sparkles"></i> Trang trí CV</a>
                    <a href="#"><i class="fa-solid fa-briefcase"></i> Quản lý việc làm</a>
                    <a href="#"><i class="fa-solid fa-gear"></i> Cài đặt</a>
                </div>
            </div>

            <div class="sidebar-card">
                <h6 class="fw-bold mb-3"><i class="fa-solid fa-cloud-arrow-up me-2"></i>Tải CV PDF sẵn có</h6>
                <form asp-action="UploadCV" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <input type="file" name="fileCV" class="form-control form-control-sm">
                    </div>
                    <button class="btn btn-primary w-100 rounded-pill btn-sm fw-bold">Tải lên ngay</button>
                </form>
            </div>
        </div>

        <!-- MAIN CONTENT -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <div>
                    <h2 class="fw-bold mb-1">Mẫu CV chuẩn JobHub</h2>
                    <p class="text-muted mb-0">Tăng 80% cơ hội được gọi phỏng vấn</p>
                </div>
                <div class="filter-buttons">
                    <button class="pill active" data-filter="all">Tất cả</button>
                    <button class="pill" data-filter="Đơn giản">Đơn giản</button>
                    <button class="pill" data-filter="Hiện đại">Hiện đại</button>
                    <button class="pill" data-filter="Chuyên nghiệp">Chuyên nghiệp</button>
                </div>
            </div>

            <div id="templatesGrid" class="grid-cols">
                @if (ViewBag.Templates != null)
                {
                    foreach (var item in (List<JobPortal.Models.CVTemplate>)ViewBag.Templates)
                    {
                        <div class="template-card" data-category="@item.Category">
                            @if (item.Name != null && item.Name.Contains("NEW"))
                            {
                                <div class="badge-new">NEW</div>
                            }

                            <div class="template-img-container" style="height: 300px; overflow: hidden; background: #f8fafc;">
                                @if (!string.IsNullOrEmpty(item.Thumbnail))
                                {
                                    <img src="@(item.Thumbnail.StartsWith("http") ? item.Thumbnail : Url.Content("~/" + item.Thumbnail))"
                                         class="img-fluid w-100 h-100 object-fit-cover"
                                         alt="@item.Name" />
                                }
                                else
                                {
                                    <img src="https://placehold.co/400x600?text=No+Image" class="img-fluid w-100 h-100 object-fit-cover" />
                                }
                            </div>

                            <div class="card-body p-3 text-center">
                                <p class="template-name fw-bold mb-3 text-truncate">@item.Name</p>
                                <a href="/Candidate/Home/EditCV/@item.Id" class="btn btn-outline-primary" style="cursor: pointer; display: inline-block;">
                                    Dùng mẫu này
                                </a>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const pills = document.querySelectorAll('.pill');
            const cards = document.querySelectorAll('.template-card');

            pills.forEach(pill => {
                pill.addEventListener('click', function() {
                    // 1. Chuyển trạng thái màu sắc cho nút được bấm
                    pills.forEach(p => p.classList.remove('active'));
                    this.classList.add('active');

                    // 2. Lấy giá trị cần lọc
                    const filterValue = this.getAttribute('data-filter');

                    // 3. Thực hiện ẩn/hiện card
                    cards.forEach(card => {
                        const cardCategory = card.getAttribute('data-category');

                        if (filterValue === 'all' || cardCategory === filterValue) {
                            card.style.display = 'block';
                            // Hiệu ứng hiện nhẹ nhàng
                            card.style.opacity = '0';
                            setTimeout(() => {
                                card.style.opacity = '1';
                                card.style.transition = '0.3s ease-in-out';
                            }, 10);
                        } else {
                            card.style.display = 'none';
                        }
                    });
                });
            });
        });
    </script>
}