@model JobPortal.Models.JobPost
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Chi tiết công việc";
}

<style>
    body {
        background-color: #f9fafb;
    }

    .job-detail-header {
        background: linear-gradient(135deg, #0066ff 0%, #0038a0 100%);
        color: white;
        padding: 2.5rem 2rem;
        border-radius: 1.5rem;
        margin-bottom: 2rem;
        box-shadow: 0 10px 35px rgba(0, 102, 255, 0.15);
    }

    .job-detail-header h1 {
        font-size: 2.5rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        margin-bottom: 0.75rem;
    }

    .job-detail-header .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        font-size: 0.95rem;
        opacity: 0.95;
    }

    .job-detail-header .meta-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .job-detail-card {
        border: none;
        border-radius: 1.25rem;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.1);
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .job-detail-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 32px rgba(15, 23, 42, 0.15);
    }

    .job-detail-hero {
        background: linear-gradient(135deg, rgba(0, 102, 255, 0.08), rgba(59, 130, 246, 0.12));
        padding: 2rem;
        border-bottom: 1px solid rgba(0, 102, 255, 0.1);
    }

    .job-detail-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
    }

    .job-detail-tag {
        background: white;
        border: 1.5px solid rgba(0, 102, 255, 0.2);
        border-radius: 9999px;
        padding: 0.625rem 1rem;
        font-size: 0.9rem;
        font-weight: 500;
        color: #0038a0;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .job-detail-status {
        display: flex;
        gap: 0.75rem;
        margin-top: 1.5rem;
    }

    .job-detail-status-badge {
        background: rgba(0, 102, 255, 0.1);
        border-radius: 9999px;
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: #0066ff;
    }

    .job-detail-content {
        padding: 2rem;
    }

    .job-detail-section-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 1.25rem;
        letter-spacing: -0.01em;
    }

    .job-detail-description {
        color: #4b5563;
        line-height: 1.75;
        font-size: 0.95rem;
        white-space: pre-line;
        margin-bottom: 2rem;
    }

    .job-detail-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.25rem;
    }

    .job-detail-info-box {
        background: linear-gradient(135deg, #f9fafb, #f3f4f6);
        padding: 1.25rem;
        border-radius: 1rem;
        border: 1px solid rgba(0, 102, 255, 0.05);
    }

    .job-detail-info-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #6b7280;
        margin-bottom: 0.5rem;
    }

    .job-detail-info-value {
        font-size: 1.05rem;
        font-weight: 600;
        color: #0f172a;
    }

    .job-detail-sidebar {
        position: sticky;
        top: 1.5rem;
    }

    .job-detail-apply-card {
        background: white;
        border: none;
        border-radius: 1.25rem;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.1);
        padding: 1.75rem;
    }

    .job-detail-apply-header {
        margin-bottom: 1.5rem;
    }

    .job-detail-apply-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #6b7280;
        margin-bottom: 0.5rem;
    }

    .job-detail-apply-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: #0f172a;
    }

    .job-detail-apply-info {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid #e5e7eb;
    }

    .job-detail-apply-info-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .job-detail-apply-info-label {
        color: #6b7280;
        font-weight: 500;
    }

    .job-detail-apply-info-value {
        font-weight: 600;
        color: #0f172a;
    }

    .job-detail-apply-button {
        width: 100%;
        padding: 0.875rem 1.5rem;
        font-size: 1rem;
        font-weight: 600;
        border-radius: 0.875rem;
        border: none;
        background: linear-gradient(135deg, #0066ff, #0052cc);
        color: white;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(0, 102, 255, 0.3);
    }

    .job-detail-apply-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0, 102, 255, 0.4);
        background: linear-gradient(135deg, #0052cc, #003d99);
    }

    .job-detail-apply-button:active {
        transform: translateY(0);
    }

    .job-detail-alert {
        background: #fef3c7;
        border: 1px solid #fcd34d;
        border-radius: 0.875rem;
        padding: 1.25rem;
        margin-bottom: 1rem;
        color: #92400e;
    }

    .job-detail-alert p {
        margin: 0 0 0.75rem 0;
        font-weight: 500;
    }

    .job-detail-alert a {
        display: block;
        background: #1f2937;
        color: white;
        text-align: center;
        padding: 0.75rem;
        border-radius: 0.5rem;
        text-decoration: none;
        font-weight: 600;
        transition: background 0.3s ease;
    }

    .job-detail-alert a:hover {
        background: #111827;
    }

    .job-back-button {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.3);
        color: white;
        padding: 0.5rem 1.25rem;
        border-radius: 0.625rem;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .job-back-button:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.5);
        color: white;
    }
</style>

<style>
    @@media (max-width: 768px) {
        .job-detail-header {
            padding: 1.5rem 1rem;
        }

        .job-detail-header h1 {
            font-size: 1.75rem;
        }

        .job-detail-header .meta {
            gap: 1rem;
            font-size: 0.85rem;
        }

        .job-detail-sidebar {
            position: static;
        }
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="job-detail-header d-flex flex-column flex-md-row justify-content-between align-items-start">
                <div class="flex-grow-1">
                    <h1>@Model.Title</h1>
                    <div class="meta">
                        <div class="meta-item">
                            <i class="bi bi-building"></i>
                            @Model.CompanyName
                        </div>
                        <div class="meta-item">
                            <i class="bi bi-geo-alt"></i>
                            @(Model.JobLocation?.Name ?? "Toàn quốc")
                        </div>
                        <div class="meta-item">
                            <i class="bi bi-calendar"></i>
                            @Model.CreatedAt.ToString("dd/MM/yyyy")
                        </div>
                    </div>
                </div>
                <a asp-area="Candidate" asp-controller="Home" asp-action="Index" class="job-back-button mt-3 mt-md-0">
                    <i class="bi bi-arrow-left-circle"></i> Quay lại
                </a>
            </div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="job-detail-card">
                        <div class="job-detail-hero">
                            <div class="job-detail-tags">
                                <span class="job-detail-tag">
                                    <i class="bi bi-grid-fill"></i> @Model.CategoryName
                                </span>
                                <span class="job-detail-tag">
                                    <i class="bi bi-cash-stack"></i> @(Model.SalaryRange ?? "Thỏa thuận")
                                </span>
                                <span class="job-detail-tag">
                                    <i class="bi bi-geo-alt"></i> @(Model.JobLocation?.Name ?? "Toàn quốc")
                                </span>
                            </div>
                            <div class="job-detail-status">
                                <span class="job-detail-status-badge">Thông tin tuyển dụng</span>
                                <span class="job-detail-status-badge" style="background: rgba(34, 197, 94, 0.1); color: #16a34a;">
                                    @((Model.IsApproved) ? "Đã duyệt" : "Chờ duyệt")
                                </span>
                            </div>
                        </div>
                        <div class="job-detail-content">
                            <h3 class="job-detail-section-title">Mô tả công việc</h3>
                            <p class="job-detail-description">
                                @(string.IsNullOrWhiteSpace(Model.Description) ? "Nhà tuyển dụng chưa cung cấp mô tả chi tiết." : Model.Description)
                            </p>

                            <h3 class="job-detail-section-title">Thông tin chi tiết</h3>
                            <div class="job-detail-grid">
                                <div class="job-detail-info-box">
                                    <div class="job-detail-info-label">Công ty</div>
                                    <div class="job-detail-info-value">@Model.CompanyName</div>
                                </div>
                                <div class="job-detail-info-box">
                                    <div class="job-detail-info-label">Ngành nghề</div>
                                    <div class="job-detail-info-value">@Model.CategoryName</div>
                                </div>
                                <div class="job-detail-info-box">
                                    <div class="job-detail-info-label">Mức lương</div>
                                    <div class="job-detail-info-value">@(Model.SalaryRange ?? "Thỏa thuận")</div>
                                </div>
                                <div class="job-detail-info-box">
                                    <div class="job-detail-info-label">Địa điểm</div>
                                    <div class="job-detail-info-value">@(Model.JobLocation?.Name ?? "Toàn quốc")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="job-detail-sidebar">
                        <div class="job-detail-apply-card">
                            <div class="job-detail-apply-header">
                                <div class="job-detail-apply-label">Hành động</div>
                                <div class="job-detail-apply-title">Ứng tuyển ngay</div>
                            </div>

                            <div class="job-detail-apply-info">
                                <div class="job-detail-apply-info-item">
                                    <span class="job-detail-apply-info-label">Trạng thái</span>
                                    <span class="job-detail-apply-info-value" style="color: #16a34a;">
                                        @((Model.IsApproved) ? "Hoạt động" : "Chờ duyệt")
                                    </span>
                                </div>
                                <div class="job-detail-apply-info-item">
                                    <span class="job-detail-apply-info-label">Mức lương</span>
                                    <span class="job-detail-apply-info-value">@(Model.SalaryRange ?? "Thỏa thuận")</span>
                                </div>
                                <div class="job-detail-apply-info-item">
                                    <span class="job-detail-apply-info-label">Địa điểm</span>
                                    <span class="job-detail-apply-info-value">@(Model.JobLocation?.Name ?? "Toàn quốc")</span>
                                </div>
                            </div>

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-area="Candidate" asp-controller="Job" asp-action="Apply" method="post">
                                    <input type="hidden" name="jobId" value="@Model.Id" />
                                    <input type="hidden" name="candidateId" value="@UserManager.GetUserId(User)" />
                                    <button type="submit" class="job-detail-apply-button">
                                        <i class="bi bi-send-fill me-2"></i> Ứng tuyển ngay
                                    </button>
                                </form>
                            }
                            else
                            {
                                <div class="job-detail-alert">
                                    <p><i class="bi bi-exclamation-circle me-2"></i>Cần đăng nhập</p>
                                    <a href="/Identity/Account/Login">Đăng nhập ngay</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
