@model JobPortal.Models.JobPost
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Chi tiết công việc";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    body {
        background-color: #f0f2f5;
        font-family: 'Inter', sans-serif;
    }

    /* Thu hẹp Header và bo góc nhẹ */
    .header-box {
        background: linear-gradient(135deg, #0066ff 0%, #004ecc 100%);
        color: white;
        padding: 50px 0;
        margin-bottom: -40px; /* Tạo hiệu ứng thẻ nội dung đè lên header */
    }

    /* Thẻ nội dung chính */
    .content-wrapper {
        background: white;
        border-radius: 16px;
        border: none;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        padding: 35px;
        margin-bottom: 30px;
    }

    .job-title {
        font-size: 32px;
        font-weight: 800;
        margin-bottom: 15px;
    }

    .info-badge {
        background: #f0f7ff;
        color: #0066ff;
        padding: 10px 20px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 14px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1px solid #e0eeff;
    }

    .section-header {
        font-size: 20px;
        font-weight: 700;
        color: #1a202c;
        margin: 30px 0 20px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .section-header::after {
            content: "";
            flex: 1;
            height: 1px;
            background: #eee;
        }

    /* Sidebar ứng tuyển */
    .sticky-sidebar {
        position: sticky;
        top: 20px;
    }

    .apply-card {
        background: white;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        border: 1px solid #eef0f2;
    }

    .btn-apply {
        background: #0066ff;
        color: white;
        width: 100%;
        border: none;
        padding: 16px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 18px;
        transition: 0.3s;
        box-shadow: 0 4px 15px rgba(0, 102, 255, 0.3);
    }

        .btn-apply:hover {
            background: #0052cc;
            transform: translateY(-2px);
            color: white;
        }

    .meta-info {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #f8f9fa;
    }

    .meta-label {
        color: #718096;
        font-size: 14px;
    }

    .meta-value {
        color: #2d3748;
        font-weight: 600;
    }

    .back-btn {
        color: rgba(255,255,255,0.8);
        text-decoration: none;
        font-size: 14px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 20px;
    }

        .back-btn:hover {
            color: white;
        }
</style>

<div class="header-box">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-11">
                <a asp-area="Candidate" asp-controller="Home" asp-action="Index" class="back-btn">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
                <h1 class="job-title">@Model.Title</h1>
                <div class="d-flex gap-4 opacity-75">
                    <span><i class="bi bi-building"></i> @Model.CompanyName</span>
                    <span><i class="bi bi-geo-alt"></i> @(Model.JobLocation?.Name ?? "Toàn quốc")</span>
                    <span><i class="bi bi-calendar3"></i> @Model.CreatedAt.ToString("dd/MM/yyyy")</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center g-4">
        <div class="col-lg-7">
            <div class="content-wrapper">
                <div class="d-flex gap-2 mb-4">
                    <span class="info-badge"><i class="bi bi-tag"></i> @(Model.Category?.Name ?? "Ngành nghề")</span>
                    <span class="info-badge text-danger"><i class="bi bi-cash-stack"></i> @Model.SalaryRange</span>
                    <span class="info-badge text-success"><i class="bi bi-check-all"></i> Đã duyệt</span>
                </div>

                <div class="section-header"><i class="bi bi-file-earmark-text text-primary"></i> Mô tả công việc</div>
                <div style="white-space: pre-line; color: #4a5568; line-height: 1.8;">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "Thông tin mô tả đang được cập nhật." : Model.Description)
                </div>

                <div class="section-header"><i class="bi bi-info-circle text-primary"></i> Thông tin khác</div>
                <div class="row">
                    <div class="col-6 mb-3">
                        <small class="text-muted d-block">Công ty</small>
                        <span class="fw-bold">@Model.CompanyName</span>
                    </div>
                    <div class="col-6 mb-3">
                        <small class="text-muted d-block">Ngày đăng</small>
                        <span class="fw-bold">@Model.CreatedAt.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="sticky-sidebar">
                <div class="apply-card text-center">
                    <h5 class="fw-bold mb-4">Ứng tuyển ngay</h5>

                    <div class="meta-info">
                        <span class="meta-label">Mức lương</span>
                        <span class="meta-value text-primary">@Model.SalaryRange</span>
                    </div>
                    <div class="meta-info">
                        <span class="meta-label">Địa điểm</span>
                        <span class="meta-value">@(Model.JobLocation?.Name ?? "Toàn quốc")</span>
                    </div>
                    <div class="meta-info">
                        <span class="meta-label">Ngành nghề</span>
                        <span class="meta-value">@(Model.Category?.Name ?? "N/A")</span>
                    </div>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-area="Candidate" asp-controller="Job" asp-action="Apply" method="post">
                            <input type="hidden" name="jobId" value="@Model.Id" />
                            <input type="hidden" name="candidateId" value="@UserManager.GetUserId(User)" />
                            <button type="submit" class="btn-apply mt-3">
                                <i class="bi bi-send-fill"></i> Nộp đơn ngay
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="mt-4 p-3 bg-light rounded-3">
                            <p class="small text-muted mb-2">Đăng nhập để ứng tuyển</p>
                            <a href="/Identity/Account/Login" class="btn btn-outline-primary btn-sm w-100">Đăng nhập</a>
                        </div>
                    }
                </div>

                <div class="mt-3 p-3 text-center text-muted small">
                    <i class="bi bi-shield-check"></i> Tin tuyển dụng đã được JobHub xác thực.
                </div>
            </div>
        </div>
    </div>
</div>