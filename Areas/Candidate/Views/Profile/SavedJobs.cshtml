@model IEnumerable<JobPortal.Models.SavedJob>

@{
    ViewData["Title"] = "Việc làm đã lưu";
    Layout = "~/Views/Shared/_LayoutCV.cshtml";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold m-0 text-danger"><i class="fa-solid fa-heart me-2"></i>Việc làm đã lưu</h2>
        <span class="badge bg-danger rounded-pill px-3">@Model.Count() Tin đã lưu</span>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h4 class="fw-bold text-primary mb-1">@item.JobPost?.Title</h4>
                                <p class="text-muted mb-2"><i class="fa-solid fa-building me-2"></i>@item.JobPost?.CompanyName</p>
                                <div class="d-flex gap-3 small text-secondary">
                                    <span><i class="fa-solid fa-clock me-2"></i>Đã lưu vào: @item.SavedDate.ToString("dd/MM/yyyy HH:mm")</span>
                                    <span><i class="fa-solid fa-location-dot me-2"></i>@item.JobPost?.JobLocation?.Name</span>
                                </div>
                            </div>
                            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                                <a asp-area="" asp-controller="Home" asp-action="JobDetails" asp-route-id="@item.JobPostId" class="btn btn-primary rounded-pill px-4 fw-bold me-2">
                                    Xem chi tiết
                                </a>
                                @* Bạn có thể thêm nút bỏ lưu ở đây sau *@
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
            <i class="fa-regular fa-heart fs-1 text-light mb-3"></i>
            <h5 class="text-muted">Danh sách yêu thích đang trống.</h5>
            <div class="mt-4">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-primary rounded-pill px-5 fw-bold">Khám phá việc làm</a>
            </div>
        </div>
    }
</div>