@model JobPortal.Models.EditCVViewModel

@{
    ViewData["Title"] = "Thiết kế CV Chuyên Nghiệp";
    Layout = "~/Views/Shared/_LayoutCV.cshtml";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<div class="container-fluid py-4 bg-secondary bg-opacity-10 min-vh-100">
    <div class="d-flex justify-content-between align-items-center mb-4 px-3">
        <div>
            <h4 class="fw-bold text-dark mb-1"><i class="bi bi-palette text-primary me-2"></i>Trình thiết kế CV cao cấp</h4>
            <p class="text-muted small mb-0">Bạn đang chỉnh sửa: <span class="badge bg-primary">@(Model.TemplateId == 2 ? "Mẫu Công Nghệ Hiện Đại" : "Mẫu Thiết Kế Truyền Thống")</span></p>
        </div>
        <div>
            <a asp-action="SelectTemplate" class="btn btn-outline-dark rounded-pill btn-sm px-3 me-2">
                <i class="bi bi-arrow-left me-1"></i> Chọn mẫu khác
            </a>
            <button type="button" id="btnCheckAI" class="btn btn-outline-purple rounded-pill btn-sm fw-bold px-3 me-2" style="color:#6f42c1; border-color:#6f42c1;">
                <i class="bi bi-robot me-1"></i> Chấm Điểm CV Của Bạn
            </button>
            <button type="button" id="btnDownloadPDF" class="btn btn-primary rounded-pill btn-sm fw-bold px-4 shadow-sm">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i> Lưu & Tải PDF
            </button>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-6 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4" style="height: 82vh; overflow-y: auto; background-color: #fdfdfd;">
                <div id="aiReviewSection" class="card border-0 shadow-sm rounded-3 p-3 mb-3 bg-white border-start border-purple border-4 d-none" style="border-color: #6f42c1 !important;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h6 class="fw-bold mb-0" style="color: #6f42c1;"><i class="bi bi-cpu-fill me-2"></i>KẾT QUẢ ĐÁNH GIÁ TỪ CHUYÊN GIA AI</h6>
                        <span class="badge bg-purple fs-6 rounded-pill px-3 py-1 text-white" id="aiScoreBadge" style="background-color: #6f42c1;">0 / 100 Điểm</span>
                    </div>
                    <div class="bg-light p-2.5 rounded-3">
                        <p class="small fw-bold text-dark mb-1">Gợi ý nâng cấp từ AI:</p>
                        <ul class="small text-secondary mb-0 ps-3" id="aiSuggestionsList">
                        </ul>
                    </div>
                </div>
                <div class="card border-0 shadow-sm rounded-3 p-3 mb-3 bg-white border-start border-danger border-4">
                    <h6 class="fw-bold text-danger mb-3"><i class="bi bi-sliders2-vertical me-2"></i>BỘ TÙY BIẾN MÀU SẮC CV</h6>
                    <div class="row g-3">
                        <div class="col-4">
                            <label class="small fw-bold text-muted mb-1 d-block">Màu chữ nhấn</label>
                            <div class="d-flex align-items-center gap-2">
                                <input type="color" id="themeColorPicker" class="form-control form-control-color border-0 p-0" value="#0d6efd" style="width: 40px; height: 35px;">
                                <span class="small text-muted" style="font-size:11px;">Màu nhấn</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <label class="small fw-bold text-muted mb-1 d-block">@(Model.TemplateId == 2 ? "Màu nền Sidebar trái" : "Màu nền Header trên")</label>
                            <div class="d-flex align-items-center gap-2">
                                <input type="color" id="headerBgColorPicker" class="form-control form-control-color border-0 p-0" value="@(Model.TemplateId == 2 ? "#eaddd5" : "#212529")" style="width: 40px; height: 35px;">
                                <span class="small text-muted" style="font-size:11px;">Nền 1</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <label class="small fw-bold text-muted mb-1 d-block">@(Model.TemplateId == 2 ? "Màu nền vùng phải" : "Màu nền thân dưới")</label>
                            <div class="d-flex align-items-center gap-2">
                                <input type="color" id="bgColorPicker" class="form-control form-control-color border-0 p-0" value="#ffffff" style="width: 40px; height: 35px;">
                                <span class="small text-muted" style="font-size:11px;">Nền 2</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-3 p-3 mb-3 bg-white border-start border-primary border-4">
                    <h6 class="fw-bold text-primary mb-3"><i class="bi bi-person-lines-fill me-2"></i>1. THÔNG TIN LIÊN HỆ (CONTACT)</h6>
                    <div class="row align-items-center">
                        <div class="col-sm-4 text-center border-end mb-3 mb-sm-0">
                            <div class="mx-auto position-relative mb-2 d-flex flex-column align-items-center justify-content-center border border-2 border-dashed rounded-3 p-2 bg-light style-avatar-box" style="width: 125px; height: 145px; cursor: pointer;" onclick="document.getElementById('uploadAvatarFile').click()">
                                <img id="imgAvatarForm" src="@(string.IsNullOrEmpty(Model.AvatarPath) ? "/images/default-avatar.png" : Model.AvatarPath)" class="w-100 h-100 object-fit-cover rounded-2" style="display: @(string.IsNullOrEmpty(Model.AvatarPath) ? "none" : "block");">
                                <div id="avatarPlaceholderText" class="text-center text-muted @(string.IsNullOrEmpty(Model.AvatarPath) ? "" : "d-none")">
                                    <i class="bi bi-cloud-arrow-up fs-3 text-primary"></i>
                                    <span class="d-block small fw-bold mt-1" style="font-size: 11px;">Chọn ảnh</span>
                                </div>
                                <input type="file" id="uploadAvatarFile" class="d-none" accept="image/*">
                            </div>
                        </div>
                        <div class="col-sm-8">
                            <div class="mb-2">
                                <label class="small fw-bold text-muted mb-1">Họ và Tên</label>
                                <input type="text" id="inName" class="form-control form-control-sm rounded-2 fw-bold" value="@Model.FullName">
                            </div>
                            <div class="mb-2">
                                <label class="small fw-bold text-muted mb-1">Vị trí công việc (Job Title)</label>
                                <input type="text" id="inJob" class="form-control form-control-sm rounded-2" value="@Model.JobTitle" placeholder="Ví dụ: Lập trình viên Backend">
                            </div>
                        </div>
                    </div>
                    <div class="row mt-2 g-2 pt-2 border-top">
                        <div class="col-6">
                            <label class="small fw-bold text-muted mb-1">Email</label>
                            <input type="email" id="inEmail" class="form-control form-control-sm rounded-2 text-muted" value="@Model.Email" readonly disabled>
                        </div>
                        <div class="col-6">
                            <label class="small fw-bold text-muted mb-1">Số điện thoại</label>
                            <input type="text" id="inPhone" class="form-control form-control-sm rounded-2" value="@Model.Phone">
                        </div>
                        <div class="col-12">
                            <label class="small fw-bold text-muted mb-1">Địa chỉ cư trú</label>
                            <input type="text" id="inAddress" class="form-control form-control-sm rounded-2" value="@Model.Address" placeholder="Hà Nội, Việt Nam">
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-3 p-3 mb-3 bg-white border-start border-info border-4">
                    <h6 class="fw-bold text-info mb-2"><i class="bi bi-chat-right-quote-fill me-2"></i>2. GIỚI THIỆU BẢN THÂN (ABOUT ME)</h6>
                    <div>
                        <textarea id="inSummary" class="form-control form-control-sm rounded-2" rows="3" placeholder="Tóm tắt mục tiêu...">@Model.Summary</textarea>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-3 p-3 mb-3 bg-white border-start border-success border-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-success mb-0"><i class="bi bi-briefcase-fill me-2"></i>3. KINH NGHIỆM LÀM VIỆC</h6>
                        <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-2 py-0" style="font-size:11px;" onclick="addExperienceField()"><i class="bi bi-plus-lg"></i> Thêm mục</button>
                    </div>
                    <div id="experienceContainer">
                        <div class="p-2 border rounded bg-light mb-2 position-relative exp-item" data-index="0">
                            <div class="row g-2">
                                <div class="col-6"><input type="text" class="form-control form-control-sm exp-comp" placeholder="Tên công ty" value="@(Model.Experiences?.FirstOrDefault()?.Company)"></div>
                                <div class="col-6"><input type="text" class="form-control form-control-sm exp-role" placeholder="Vai trò" value="@(Model.Experiences?.FirstOrDefault()?.Role)"></div>
                                <div class="col-12"><input type="text" class="form-control form-control-sm exp-time" placeholder="Thời gian" value="@(Model.Experiences?.FirstOrDefault()?.Duration)"></div>
                                <div class="col-12"><textarea class="form-control form-control-sm exp-desc" rows="2" placeholder="Mô tả...">@(Model.Experiences?.FirstOrDefault()?.Description)</textarea></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-3 p-3 mb-3 bg-white border-start border-warning border-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-warning mb-0"><i class="bi bi-mortarboard-fill me-2"></i>4. HỌC VẤN</h6>
                        <button type="button" class="btn btn-sm btn-outline-warning text-dark rounded-pill px-2 py-0" style="font-size:11px;" onclick="addEducationField()"><i class="bi bi-plus-lg"></i> Thêm mục</button>
                    </div>
                    <div id="educationContainer">
                        <div class="p-2 border rounded bg-light mb-2 position-relative edu-item" data-index="0">
                            <div class="row g-2">
                                <div class="col-6"><input type="text" class="form-control form-control-sm edu-school" placeholder="Trường học" value="@(Model.Educations?.FirstOrDefault()?.School)"></div>
                                <div class="col-6"><input type="text" class="form-control form-control-sm edu-major" placeholder="Ngành học" value="@(Model.Educations?.FirstOrDefault()?.Major)"></div>
                                <div class="col-12"><input type="text" class="form-control form-control-sm edu-time" placeholder="Thời gian" value="@(Model.Educations?.FirstOrDefault()?.Duration)"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100 border-start border-danger border-4">
                            <h6 class="fw-bold text-danger mb-2"><i class="bi bi-tools me-2"></i>5. KỸ NĂNG</h6>
                            <textarea id="inSkills" class="form-control form-control-sm" rows="4">@(Model.ITSKills?.FirstOrDefault()?.SkillName ?? "- C#, ASP.NET Core\n- SQL Server & EF Core")</textarea>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100 border-start border-secondary border-4">
                            <h6 class="fw-bold text-secondary mb-2"><i class="bi bi-translate me-2"></i>6. NGOẠI NGỮ</h6>
                            <textarea id="inLang" class="form-control form-control-sm" rows="4">@(Model.Languages?.FirstOrDefault()?.LanguageName ?? "- Tiếng Anh: Khá")</textarea>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-dark border-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-dark mb-0"><i class="bi bi-people-fill me-2"></i>7. NGƯỜI THAM CHIẾU</h6>
                        <button type="button" class="btn btn-sm btn-outline-dark rounded-pill px-2 py-0" style="font-size:11px;" onclick="addReferenceField()"><i class="bi bi-plus-lg"></i> Thêm mục</button>
                    </div>
                    <div id="referenceContainer">
                        <div class="p-2 border rounded bg-light mb-2 position-relative ref-item" data-index="0">
                            <div class="row g-2">
                                <div class="col-6"><input type="text" class="form-control form-control-sm ref-name" placeholder="Họ tên" value="@(Model.References?.FirstOrDefault()?.Name)"></div>
                                <div class="col-6"><input type="text" class="form-control form-control-sm ref-pos" placeholder="Chức vụ" value="@(Model.References?.FirstOrDefault()?.Position)"></div>
                                <div class="col-12"><input type="text" class="form-control form-control-sm ref-contact" placeholder="SĐT hoặc Email" value="@(Model.References?.FirstOrDefault()?.Phone)"></div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="col-xl-6 col-lg-5 d-flex justify-content-center">
            <div class="a4-container-preview shadow-inner rounded-4">

                @if (Model.TemplateId == 2)
                {
                    <div id="cvSheet" class="cv-a4-sheet bg-white shadow-lg d-flex flex-row" style="font-family: 'Segoe UI', Arial, sans-serif;">

                        <div id="cvPreviewHeader" class="p-4 text-dark d-flex flex-column align-items-center" style="width: 36%; min-height: 297mm; background-color: #eaddd5; transition: background-color 0.2s;">

                            <div class="mb-4 bg-white p-1 shadow-sm" style="width: 140px; height: 160px; overflow: hidden; border-radius: 4px;">
                                <img id="cvPreviewAvatar" src="@(string.IsNullOrEmpty(Model.AvatarPath) ? "/images/default-avatar.png" : Model.AvatarPath)" class="w-100 h-100 object-fit-cover">
                            </div>

                            <div class="w-100 mb-4 text-start px-2">
                                <h6 class="fw-bold tracking-wider mb-2 text-uppercase text-dark border-bottom border-secondary border-2 pb-1" style="font-size: 13px;">PROFILE</h6>
                                <p id="outSummary" class="text-dark small lh-base mb-0" style="white-space: pre-wrap; font-size: 12px; text-align: justify; opacity: 0.85;">@Model.Summary</p>
                            </div>

                            <div class="w-100 text-start mt-auto pb-4 px-2">
                                <h6 class="fw-bold tracking-wider mb-2 text-uppercase text-dark border-bottom border-secondary border-2 pb-1" style="font-size: 13px;">CONTACT ME</h6>
                                <div class="small d-flex flex-column gap-2" style="font-size: 11.5px; opacity: 0.9;">
                                    <div class="text-break"><i class="bi bi-telephone-fill me-2"></i><span id="outPhone">@Model.Phone</span></div>
                                    <div class="text-break"><i class="bi bi-envelope-fill me-2"></i><span id="outEmail">@Model.Email</span></div>
                                    <div class="text-wrap"><i class="bi bi-geo-alt-fill me-2"></i><span id="outAddress">@Model.Address</span></div>
                                </div>
                            </div>
                        </div>

                        <div class="p-4 flex-grow-1 bg-inherit-custom d-flex flex-column" style="width: 64%; background-color: #ffffff; overflow: hidden;">

                            <div class="mb-4 pt-2 border-bottom pb-3">
                                <div id="nameScaleContainer" style="transform-origin: left center; transition: transform 0.1s ease; width: 100%; max-width: 380px; overflow: visible;">
                                    <h1 class="fw-bold text-dark text-uppercase tracking-wide mb-1" id="outName" style="white-space: nowrap; display: inline-block; font-size: 2.2rem; letter-spacing: 0.5px;">@Model.FullName</h1>
                                </div>
                                <div id="jobScaleContainer" style="transform-origin: left center; transition: transform 0.1s ease; width: 100%; max-width: 380px; overflow: visible; margin-top: 2px;">
                                    <h5 class="cv-theme-text fw-semibold tracking-wider text-uppercase" id="outJob" style="color: #0d6efd; white-space: nowrap; display: inline-block; font-size: 1.15rem;">@Model.JobTitle</h5>
                                </div>
                            </div>

                            <div class="mb-4">
                                <h6 class="fw-bold border-bottom border-2 pb-1 text-uppercase cv-theme-border" style="border-color: #0d6efd !important; font-size: 13px;"><i class="bi bi-mortarboard-fill cv-theme-text me-1" style="color: #0d6efd;"></i> EDUCATION</h6>
                                <div id="outEducationList" style="font-size: 12px;"></div>
                            </div>

                            <div class="mb-4">
                                <h6 class="fw-bold border-bottom border-2 pb-1 text-uppercase cv-theme-border" style="border-color: #0d6efd !important; font-size: 13px;"><i class="bi bi-translate cv-theme-text me-1" style="color: #0d6efd;"></i> LANGUAGE</h6>
                                <p id="outLang" class="text-secondary mb-0" style="white-space: pre-wrap; line-height: 1.5; font-size: 12px;"></p>
                            </div>

                            <div class="mb-4">
                                <h6 class="fw-bold border-bottom border-2 pb-1 text-uppercase cv-theme-border" style="border-color: #0d6efd !important; font-size: 13px;"><i class="bi bi-gear-fill cv-theme-text me-1" style="color: #0d6efd;"></i> COMPUTER SKILLS</h6>
                                <p id="outSkills" class="text-secondary mb-0" style="white-space: pre-wrap; line-height: 1.5; font-size: 12px;"></p>
                            </div>

                            <div class="mb-4">
                                <h6 class="fw-bold border-bottom border-2 pb-1 text-uppercase cv-theme-border" style="border-color: #0d6efd !important; font-size: 13px;"><i class="bi bi-briefcase-fill cv-theme-text me-1" style="color: #0d6efd;"></i> EXPERIENCE</h6>
                                <div id="outExperienceList" style="font-size: 12px;"></div>
                            </div>

                            <div class="mt-auto">
                                <h6 class="fw-bold border-bottom border-2 pb-1 text-uppercase cv-theme-border" style="border-color: #0d6efd !important; font-size: 13px;"><i class="bi bi-people-fill cv-theme-text me-1" style="color: #0d6efd;"></i> REFERENCES</h6>
                                <div id="outReferenceList" style="font-size: 12px;"></div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div id="cvSheet" class="cv-a4-sheet bg-white shadow-lg d-flex flex-column">

                        <div id="cvPreviewHeader" class="view-header d-flex align-items-center p-4 text-white border-bottom border-4 cv-theme-border" style="background-color: #212529; border-color: #0d6efd !important;">
                            <img id="cvPreviewAvatar" src="@(string.IsNullOrEmpty(Model.AvatarPath) ? "/images/default-avatar.png" : Model.AvatarPath)" class="rounded-circle me-4 border border-3 border-light shadow-sm" style="width:90px; height:90px; object-fit:cover;">

                            <div style="max-width: 280px; overflow: hidden;">
                                <div id="nameScaleContainer" style="transform-origin: left center; transition: transform 0.1s ease;">
                                    <h3 class="fw-bold text-uppercase mb-1 tracking-wide text-white" id="outName" style="white-space: nowrap; display: inline-block;">@Model.FullName</h3>
                                </div>
                                <p class="cv-theme-text fw-bold mb-0 small" id="outJob" style="color: #0d6efd;">@Model.JobTitle</p>
                            </div>

                            <div class="ms-auto text-end lh-sm border-start ps-3 border-secondary text-light-50" style="font-size: 11px; max-width: 200px;">
                                <div class="mb-1 text-truncate"><i class="bi bi-envelope-fill cv-theme-text me-1" style="color: #0d6efd;"></i><span id="outEmail">@Model.Email</span></div>
                                <div class="mb-1"><i class="bi bi-telephone-fill cv-theme-text me-1" style="color: #0d6efd;"></i><span id="outPhone">@Model.Phone</span></div>
                                <div class="text-wrap"><i class="bi bi-geo-alt-fill cv-theme-text me-1" style="color: #0d6efd;"></i><span id="outAddress">@Model.Address</span></div>
                            </div>
                        </div>

                        <div class="p-4 flex-grow-1 bg-inherit-custom" style="font-size:12.5px; background-color: #ffffff;">
                            <div class="row g-3">
                                <div class="col-7 border-end pr-custom pe-3">
                                    <div class="mb-4">
                                        <h6 class="fw-bold text-dark border-bottom border-2 pb-1 text-uppercase cv-theme-border"><i class="bi bi-bookmark-star-fill cv-theme-text me-1" style="color: #0d6efd;"></i> Giới thiệu chung</h6>
                                        <p id="outSummary" class="text-secondary small mb-0" style="white-space: pre-wrap; line-height:1.5; text-align:justify;">@Model.Summary</p>
                                    </div>
                                    <div class="mb-4">
                                        <h6 class="fw-bold text-dark border-bottom border-2 pb-1 text-uppercase cv-theme-border"><i class="bi bi-briefcase-fill cv-theme-text me-1" style="color: #0d6efd;"></i> Kinh nghiệm làm việc</h6>
                                        <div id="outExperienceList"></div>
                                    </div>
                                    <div class="mb-3">
                                        <h6 class="fw-bold text-dark border-bottom border-2 pb-1 text-uppercase cv-theme-border"><i class="bi bi-mortarboard-fill cv-theme-text me-1" style="color: #0d6efd;"></i> Học văn</h6>
                                        <div id="outEducationList"></div>
                                    </div>
                                </div>
                                <div class="col-5 ps-2">
                                    <div class="mb-4">
                                        <h6 class="fw-bold text-dark border-bottom border-2 pb-1 text-uppercase cv-theme-border"><i class="bi bi-gear-fill cv-theme-text me-1" style="color: #0d6efd;"></i> Kỹ năng</h6>
                                        <p id="outSkills" class="text-secondary small mb-0" style="white-space: pre-wrap; line-height:1.5;">@Model.Interests</p>
                                    </div>
                                    <div class="mb-4">
                                        <h6 class="fw-bold text-dark border-bottom border-2 pb-1 text-uppercase cv-theme-border"><i class="bi bi-translate cv-theme-text me-1" style="color: #0d6efd;"></i> Ngoại ngữ</h6>
                                        <p id="outLang" class="text-secondary small mb-0" style="white-space: pre-wrap; line-height:1.5;"></p>
                                    </div>
                                    <div class="mb-3">
                                        <h6 class="fw-bold text-dark border-bottom border-2 pb-1 text-uppercase cv-theme-border"><i class="bi bi-people-fill cv-theme-text me-1" style="color: #0d6efd;"></i> Người tham chiếu</h6>
                                        <div id="outReferenceList"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

<style>
    .a4-container-preview {
        background: #525659;
        padding: 30px 15px;
        width: 100%;
        display: flex;
        justify-content: center;
        height: 82vh;
        overflow-y: auto;
    }

    .cv-a4-sheet {
        width: 210mm;
        min-height: 297mm;
        background: white;
        box-sizing: border-box;
        margin: 0 auto;
    }

    ::-webkit-scrollbar {
        width: 5px;
    }

    ::-webkit-scrollbar-track {
        background: transparent;
    }

    ::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 10px;
    }

    textarea {
        resize: none;
    }

    .btn-delete-item {
        position: absolute;
        top: 5px;
        right: 5px;
        padding: 2px 6px;
        font-size: 10px;
    }

    .style-avatar-box {
        border-color: #cbd5e1 !important;
        transition: all 0.2s ease-in-out;
    }

        .style-avatar-box:hover {
            border-color: #0d6efd !important;
            background-color: #f1f5f9 !important;
        }
</style>

@section Scripts {
    <script>
        const templateId = @Model.TemplateId;

        // ================= HÀM XUẤT FILE PDF CHUẨN ĐỒ HỌA A4 =================
        document.getElementById('btnDownloadPDF').addEventListener('click', function () {
            const element = document.getElementById('cvSheet'); // Lấy vùng nội dung tờ A4

            // Lấy tên ứng viên làm tên file, nếu trống thì đặt mặc định
            const candidateName = document.getElementById('inName').value.trim() || "Ung-Vien";
            const fileName = `CV_${candidateName.replace(/\s+/g, '_')}.pdf`;

            // Cấu hình các thông số xuất PDF tối ưu nhất cho html2pdf
            const options = {
                margin:       0, // Không chừa lề ngoài canvas vì sheet đã căn chỉnh chuẩn A4
                filename:     fileName,
                image:        { type: 'jpeg', quality: 0.98 }, // Chất lượng ảnh đại diện cao
                html2canvas:  {
                    scale: 2, // Tăng gấp đôi độ phân giải chống nhòe vỡ chữ
                    useCORS: true, // Hỗ trợ lấy ảnh avatar từ URL khác domain (nếu có)
                    logging: false
                },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' } // Thiết lập chuẩn khổ giấy dọc A4
            };

            // Tiến hành kích hoạt tải file
            html2pdf().set(options).from(element).save();
        });

        // ================= HÀM ĐỒNG BỘ TỰ ĐỘNG THU NHỎ CHỮ (FIX TRÀN CHỮ) =================
        function autoScaleText(containerId, textId, maxWidth) {
            const container = document.getElementById(containerId);
            const text = document.getElementById(textId);
            if (container && text) {
                container.style.transform = `scale(1)`;
                const currentWidth = text.offsetWidth;

                if (currentWidth > maxWidth) {
                    const ratio = maxWidth / currentWidth;
                    container.style.transform = `scale(${ratio})`;
                }
            }
        }

        function runAllScales() {
            const maxW = templateId === 2 ? 370 : 260;
            autoScaleText('nameScaleContainer', 'outName', maxW);
            autoScaleText('jobScaleContainer', 'outJob', maxW - 20);
        }

        function setupStaticSync(inputId, previewId) {
            const inEl = document.getElementById(inputId);
            const outEl = document.getElementById(previewId);
            if (inEl && outEl) {
                outEl.textContent = inEl.value;
                if(inputId === 'inName' || inputId === 'inJob') runAllScales();

                inEl.addEventListener('input', function() {
                    outEl.textContent = this.value;
                    if(inputId === 'inName' || inputId === 'inJob') runAllScales();
                });
            }
        }

        setupStaticSync('inName', 'outName');
        setupStaticSync('inJob', 'outJob');
        setupStaticSync('inPhone', 'outPhone');
        setupStaticSync('inAddress', 'outAddress');
        setupStaticSync('inSummary', 'outSummary');
        setupStaticSync('inSkills', 'outSkills');
        setupStaticSync('inLang', 'outLang');

        // ================= BỘ LỌC ĐỔI MÀU SẮC ĐỘNG =================
        const themeColorPicker = document.getElementById('themeColorPicker');
        const headerBgColorPicker = document.getElementById('headerBgColorPicker');
        const bgColorPicker = document.getElementById('bgColorPicker');

        themeColorPicker.addEventListener('input', function() {
            const color = this.value;
            document.querySelectorAll('.cv-theme-text').forEach(el => el.style.color = color);
            document.querySelectorAll('.cv-theme-border').forEach(el => el.style.setProperty('border-color', color, 'important'));
        });

        headerBgColorPicker.addEventListener('input', function() {
            document.getElementById('cvPreviewHeader').style.backgroundColor = this.value;
        });

        bgColorPicker.addEventListener('input', function() {
            document.querySelector('.bg-inherit-custom').style.backgroundColor = this.value;
        });

        // ================= THÊM/XÓA MỤC ĐỘNG VÀ RE-RENDER TỨC THÌ =================
        function addExperienceField() {
            const container = document.getElementById('experienceContainer');
            const nextIndex = container.querySelectorAll('.exp-item').length;
            const html = `
                <div class="p-2 border rounded bg-light mb-2 position-relative exp-item" data-index="${nextIndex}">
                    <button type="button" class="btn btn-sm btn-danger btn-delete-item rounded-circle" onclick="this.parentElement.remove(); renderAllLists();">✕</button>
                    <div class="row g-2">
                        <div class="col-6"><input type="text" class="form-control form-control-sm exp-comp" placeholder="Tên công ty"></div>
                        <div class="col-6"><input type="text" class="form-control form-control-sm exp-role" placeholder="Vai trò"></div>
                        <div class="col-12"><input type="text" class="form-control form-control-sm exp-time" placeholder="Thời gian"></div>
                        <div class="col-12"><textarea class="form-control form-control-sm exp-desc" rows="2" placeholder="Mô tả..."></textarea></div>
                    </div>
                </div>`;
            container.insertAdjacentHTML('beforeend', html);
            listenDynamicInputs();
        }

        function addEducationField() {
            const container = document.getElementById('educationContainer');
            const nextIndex = container.querySelectorAll('.edu-item').length;
            const html = `
                <div class="p-2 border rounded bg-light mb-2 position-relative edu-item" data-index="${nextIndex}">
                    <button type="button" class="btn btn-sm btn-danger btn-delete-item rounded-circle" onclick="this.parentElement.remove(); renderAllLists();">✕</button>
                    <div class="row g-2">
                        <div class="col-6"><input type="text" class="form-control form-control-sm edu-school" placeholder="Trường học"></div>
                        <div class="col-6"><input type="text" class="form-control form-control-sm edu-major" placeholder="Ngành học"></div>
                        <div class="col-12"><input type="text" class="form-control form-control-sm edu-time" placeholder="Thời gian"></div>
                    </div>
                </div>`;
            container.insertAdjacentHTML('beforeend', html);
            listenDynamicInputs();
        }

        function addReferenceField() {
            const container = document.getElementById('referenceContainer');
            const nextIndex = container.querySelectorAll('.ref-item').length;
            const html = `
                <div class="p-2 border rounded bg-light mb-2 position-relative ref-item" data-index="${nextIndex}">
                    <button type="button" class="btn btn-sm btn-danger btn-delete-item rounded-circle" onclick="this.parentElement.remove(); renderAllLists();">✕</button>
                    <div class="row g-2">
                        <div class="col-6"><input type="text" class="form-control form-control-sm ref-name" placeholder="Họ tên"></div>
                        <div class="col-6"><input type="text" class="form-control form-control-sm ref-pos" placeholder="Chức vụ"></div>
                        <div class="col-12"><input type="text" class="form-control form-control-sm ref-contact" placeholder="Liên hệ"></div>
                    </div>
                </div>`;
            container.insertAdjacentHTML('beforeend', html);
            listenDynamicInputs();
        }

        function renderAllLists() {
            const currentColor = themeColorPicker.value;

            let expHtml = '';
            document.querySelectorAll('.exp-item').forEach(item => {
                const comp = item.querySelector('.exp-comp').value || 'Tên công ty';
                const role = item.querySelector('.exp-role').value || 'Chức danh';
                const time = item.querySelector('.exp-time').value || 'Thời gian';
                const desc = item.querySelector('.exp-desc').value || '';
                expHtml += `
                    <div class="mb-3">
                        <div class="d-flex justify-content-between fw-bold text-dark">
                            <span>${comp}</span>
                            <span class="text-muted small" style="font-size:11px;">${time}</span>
                        </div>
                        <div class="cv-theme-text fw-bold small mb-1" style="color: ${currentColor};">${role}</div>
                        <p class="text-secondary small mb-0" style="white-space: pre-wrap; line-height: 1.4;">${desc}</p>
                    </div>`;
            });
            const expTarget = document.getElementById('outExperienceList');
            if (expTarget) expTarget.innerHTML = expHtml;

            let eduHtml = '';
            document.querySelectorAll('.edu-item').forEach(item => {
                const school = item.querySelector('.edu-school').value || 'Tên trường học';
                const major = item.querySelector('.edu-major').value || 'Chuyên ngành';
                const time = item.querySelector('.edu-time').value || 'Thời gian';
                eduHtml += `
                    <div class="mb-2">
                        <div class="d-flex justify-content-between fw-bold text-dark">
                            <span>${school}</span>
                            <span class="text-muted small" style="font-size:11px;">${time}</span>
                        </div>
                        <div class="text-secondary small">${major}</div>
                    </div>`;
            });
            const eduTarget = document.getElementById('outEducationList');
            if (eduTarget) eduTarget.innerHTML = eduHtml;

            let refHtml = '';
            document.querySelectorAll('.ref-item').forEach(item => {
                const name = item.querySelector('.ref-name').value || 'Họ tên';
                const pos = item.querySelector('.ref-pos').value || 'Chức vụ';
                const contact = item.querySelector('.ref-contact').value || 'Liên hệ';
                refHtml += `
                    <div class="mb-2">
                        <div class="fw-bold text-dark">${name}</div>
                        <div class="text-muted text-truncate" style="font-size:11px;">${pos}</div>
                        <div class="text-secondary text-wrap" style="font-size:11px;">${contact}</div>
                    </div>`;
            });
            const refTarget = document.getElementById('outReferenceList');
            if (refTarget) refTarget.innerHTML = refHtml;
        }

        function borderColorsUpdate() {
            const color = themeColorPicker.value;
            document.querySelectorAll('.cv-theme-text').forEach(el => el.style.color = color);
            document.querySelectorAll('.cv-theme-border').forEach(el => el.style.setProperty('border-color', color, 'important'));
        }

        function listenDynamicInputs() {
            document.querySelectorAll('.exp-item input, .exp-item textarea, .edu-item input, .ref-item input').forEach(input => {
                input.removeEventListener('input', renderAllLists);
                input.addEventListener('input', function() {
                    renderAllLists();
                    borderColorsUpdate();
                });
            });
            renderAllLists();
        }

        listenDynamicInputs();

        document.getElementById('uploadAvatarFile').addEventListener('change', function(e) {
            if (e.target.files && e.target.files[0]) {
                var reader = new FileReader();
                reader.onload = function(readerEvent) {
                    const base64Image = readerEvent.target.result;

                    const formImg = document.getElementById('imgAvatarForm');
                    if (formImg) {
                        formImg.src = base64Image;
                        formImg.style.display = 'block';
                    }

                    const placeholder = document.getElementById('avatarPlaceholderText');
                    if(placeholder) placeholder.classList.add('d-none');

                    const previewAvatar = document.getElementById('cvPreviewAvatar');
                    if (previewAvatar) previewAvatar.src = base64Image;
                };
                reader.readAsDataURL(e.target.files[0]);
            }
        });

        window.addEventListener('load', function() {
            runAllScales();
            setTimeout(runAllScales, 200);
        });
            // ================= XỬ LÝ CLICK NÚT AI CHẤM ĐIỂM =================
        document.getElementById('btnCheckAI').addEventListener('click', function() {
            const btn = this;
            const originalText = btn.innerHTML;

            // Đổi trạng thái nút sang Loading ngăn ứng viên click liên tục phá định mức
            btn.disabled = true;
            btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Đang phân tích...`;

            // 1. Thu thập dữ liệu text hiện tại trên Form
            const experiences = [];
            document.querySelectorAll('.exp-item').forEach(item => {
                experiences.push({
                    Company: item.querySelector('.exp-comp').value,
                    Role: item.querySelector('.exp-role').value,
                    Description: item.querySelector('.exp-desc').value
                });
            });

            const educations = [];
            document.querySelectorAll('.edu-item').forEach(item => {
                educations.push({
                    School: item.querySelector('.edu-school').value,
                    Major: item.querySelector('.edu-major').value
                });
            });

            const dataPayload = {
                TemplateId: templateId,
                FullName: document.getElementById('inName').value,
                JobTitle: document.getElementById('inJob').value,
                Summary: document.getElementById('inSummary').value,
                Experiences: experiences,
                Educations: educations,
                ITSKills: [{ SkillName: document.getElementById('inSkills').value }]
            };

            // 2. Gửi dữ liệu lên API Backend bằng Fetch
            fetch('/Candidate/Profile/AnalyzeCVByAi', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(dataPayload)
            })
            .then(response => response.json())
            .then(data => {
                btn.disabled = false;
                btn.innerHTML = originalText;

                if (data.success) {
                    // Hiển thị khung kết quả và cập nhật điểm số
                    const reviewSection = document.getElementById('aiReviewSection');
                    reviewSection.classList.remove('d-none');
                    document.getElementById('aiScoreBadge').textContent = `${data.score} / 100 Điểm`;

                    // Đổ danh sách các gợi ý sửa lỗi của AI vào thẻ ul
                    const listContainer = document.getElementById('aiSuggestionsList');
                    listContainer.innerHTML = ''; // Xóa dữ liệu cũ

                    data.suggestions.forEach(suggestion => {
                        const li = document.createElement('li');
                        li.className = 'mb-1';
                        li.innerHTML = `<i class="bi bi-lightbulb-fill text-warning me-1"></i> ${suggestion}`;
                        listContainer.appendChild(li);
                    });

                    // Cuộn mượt màn hình lên vị trí bảng điểm để ứng viên dễ nhìn thấy
                    reviewSection.scrollIntoView({ behavior: 'smooth', block: 'end' });
                } else {
                    alert("Thông báo từ hệ thống: " + data.message);
                }
            })
            .catch(error => {
                btn.disabled = false;
                btn.innerHTML = originalText;
                console.error("Lỗi kết nối:", error);
                alert("Có lỗi xảy ra trong quá trình truyền tải dữ liệu lên AI.");
            });
        });
    </script>
}