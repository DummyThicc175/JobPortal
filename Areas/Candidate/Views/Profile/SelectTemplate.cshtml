@model IEnumerable<JobPortal.Models.CVTemplate>

@{
    ViewData["Title"] = "Kho Mẫu CV Chuyên Nghiệp";
    Layout = "~/Views/Shared/_LayoutCV.cshtml";
}

<div class="container py-5">
    <div class="text-center max-w-xl mx-auto mb-5">
        
        <h2 class="fw-black text-dark mb-2" style="letter-spacing: -0.5px;">Kho Mẫu Thiết Kế CV </h2>
        <p class="text-muted small">Hãy chọn một bố cục phù hợp nhất với phong cách và ngành nghề của bạn để bắt đầu xây dựng hồ sơ, tùy biến màu sắc và chấm điểm AI.</p>
    </div>

    <div class="d-flex justify-content-center flex-wrap gap-2 mb-4" id="templateFilterTabs">
        <button type="button" class="btn btn-sm btn-dark rounded-pill px-4 filter-btn active" data-filter="all">Tất cả mẫu</button>
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-4 filter-btn" data-filter="Popular">Phổ biến</button>
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-4 filter-btn" data-filter="Newest">Mới nhất</button>
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-4 filter-btn" data-filter="Creative">Phá cách / Sáng tạo</button>
    </div>

    <div class="row g-4 justify-content-center" id="templatesGrid">
        @foreach (var template in Model)
        {
            <div class="col-xl-3 col-lg-4 col-md-6 template-item-wrapper" data-category="@(template.Category ?? "Popular")">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden template-card-showcase bg-white">

                    <div class="position-relative overflow-hidden bg-light border-bottom" style="height: 340px;">
                        <img src="@(string.IsNullOrEmpty(template.Thumbnail) ? "https://images.vietnamworks.com/img/cv-templates/elegant_vi.jpg" : template.Thumbnail)"
                             class="w-100 h-100 object-fit-cover img-template-preview" alt="@template.Name">

                        <div class="template-hover-mask position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center bg-dark bg-opacity-60 opacity-0">
                            <a asp-area="Candidate" asp-controller="Profile" asp-action="CreateCV" asp-route-templateId="@template.Id" class="btn btn-light text-dark rounded-pill fw-bold btn-sm px-4 py-2 shadow-lg mb-2 transform-button">
                                <i class="bi bi-magic text-primary me-1"></i> Sử dụng mẫu này
                            </a>
                            <button type="button" class="btn btn-link text-white text-decoration-none small p-0" onclick="previewLargeImage('@(string.IsNullOrEmpty(template.Thumbnail) ? "https://images.vietnamworks.com/img/cv-templates/elegant_vi.jpg" : template.Thumbnail)')" style="font-size: 12px;">
                                <i class="bi bi-eye me-1"></i> Xem ảnh lớn
                            </button>
                        </div>
                    </div>

                    <div class="card-body p-3 d-flex justify-content-between align-items-center bg-white">
                        <div class="text-truncate pe-2">
                            <h6 class="fw-bold text-dark mb-0 style-template-title text-truncate" title="@template.Name">@template.Name</h6>                          
                        </div>                        
                    </div>

                </div>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content border-0 rounded-4 overflow-hidden bg-transparent">
            <div class="modal-body p-0 position-relative text-center">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3 z-3" data-bs-dismiss="modal" aria-label="Close"></button>
                <img id="largePreviewImg" src="" class="img-fluid rounded-4 shadow-lg" style="max-height: 85vh; object-fit: contain;">
            </div>
        </div>
    </div>
</div>

<style>
    .fw-black {
        font-weight: 900 !important;
    }

    /* Thiết kế Card mượt mà */
    .template-card-showcase {
        transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        border: 1px solid #f1f5f9 !important;
    }

        .template-card-showcase:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(15, 23, 42, 0.08) !important;
        }

    /* Hiệu ứng zoom ảnh nhẹ khi di chuột */
    .img-template-preview {
        transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .template-card-showcase:hover .img-template-preview {
        transform: scale(1.06);
    }

    /* Lớp phủ Mask và Nút */
    .template-hover-mask {
        transition: opacity 0.3s ease-in-out;
        backdrop-filter: blur(2px);
    }

    .template-card-showcase:hover .template-hover-mask {
        opacity: 1 !important;
    }

    .transform-button {
        transform: translateY(15px);
        transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1), background-color 0.2s;
    }

    .template-card-showcase:hover .transform-button {
        transform: translateY(0);
    }

    .style-template-title {
        font-size: 13.5px;
        letter-spacing: -0.2px;
    }

    /* CSS làm nổi bật Tab đang được chọn */
    .filter-btn {
        transition: all 0.2s ease-in-out;
        font-size: 12px;
        font-weight: 600;
    }

        .filter-btn.active {
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        }
</style>

@section Scripts {
    <script>
        // 1. Hàm lọc danh mục động không cần tải lại trang
        document.querySelectorAll('.filter-btn').forEach(button => {
            button.addEventListener('click', function() {
                // Đổi active trạng thái nút bấm
                document.querySelectorAll('.filter-btn').forEach(btn => {
                    btn.classList.remove('btn-dark', 'active');
                    btn.classList.add('btn-outline-secondary');
                });
                this.classList.remove('btn-outline-secondary');
                this.classList.add('btn-dark', 'active');

                // Lấy điều kiện lọc
                const filterValue = this.getAttribute('data-filter');

                // Quét toàn bộ lưới để ẩn/hiện card mẫu
                document.querySelectorAll('.template-item-wrapper').forEach(item => {
                    if (filterValue === 'all' || item.getAttribute('data-category') === filterValue) {
                        item.style.display = 'block';
                        // Thêm hiệu ứng fade in nhẹ
                        item.style.opacity = '0';
                        setTimeout(() => { item.style.opacity = '1'; item.style.transition = 'opacity 0.3s'; }, 50);
                    } else {
                        item.style.display = 'none';
                    }
                });
            });
        });

        // 2. Hàm kích hoạt Popup phóng to ảnh CV thu nhỏ để xem trước chi tiết
        function previewLargeImage(imgUrl) {
            const modalImg = document.getElementById('largePreviewImg');
            if(modalImg) {
                modalImg.src = imgUrl;
                const myModal = new bootstrap.Modal(document.getElementById('imagePreviewModal'));
                myModal.show();
            }
        }
    </script>
}