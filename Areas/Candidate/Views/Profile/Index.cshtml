@model JobPortal.Models.CandidateProfileViewModel

@{
    ViewData["Title"] = "Hồ sơ của tôi";
    Layout = "~/Views/Shared/_LayoutCV.cshtml";
}

<div class="container-fluid bg-light py-4">
    <!-- Hiển thị thông báo thành công -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4 mx-md-5" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-4 me-3"></i>
                <div>
                    <strong>Tuyệt vời!</strong> @TempData["SuccessMessage"]
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Form gửi dữ liệu và FILE (enctype) -->
    <form asp-area="Candidate" asp-controller="Profile" asp-action="SaveProfile" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="row px-md-5">
            <!-- CỘT 1: SIDEBAR TRÁI -->
            <div class="col-lg-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 text-center">
                    <div class="mx-auto mb-3">
                        <img src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "/images/default-avatar.png" : Model.AvatarUrl)"
                             class="rounded-circle border" style="width:80px; height:80px; object-fit:cover;">
                    </div>
                    <h6 class="fw-bold mb-3">@Model.FullName</h6>
                    <div class="form-check form-switch d-flex justify-content-between align-items-center mb-3">
                        <label class="small text-muted">Cho phép tìm bạn</label>
                        <input class="form-check-input" type="checkbox" checked>
                    </div>
                    <div class="list-group list-group-flush border-top">
                        <a href="#" class="list-group-item list-group-item-action border-0 py-3 text-primary fw-bold active-custom text-start">
                            <i class="bi bi-person-circle me-2"></i>Hồ sơ của tôi
                        </a>
                        <a href="#" class="list-group-item list-group-item-action border-0 py-3 text-start">
                            <i class="bi bi-briefcase me-2"></i>Quản lý việc làm
                        </a>
                        <a href="#" class="list-group-item list-group-item-action border-0 py-3 text-start">
                            <i class="bi bi-gear me-2"></i>Quản lý tài khoản
                        </a>
                    </div>
                </div>
            </div>

            <!-- CỘT 2: NỘI DUNG CHÍNH -->
            <div class="col-lg-6">
                <!-- Card Thông tin & Avatar -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="fw-bold m-0">Hồ sơ cá nhân</h5>
                        <span class="text-muted small"><i class="bi bi-shield-check me-1"></i>Thông tin được bảo mật</span>
                    </div>

                    <div class="row mt-2">
                        <!-- Phần bên trái: Avatar & Trạng thái -->
                        <div class="col-md-5 border-end">
                            <div class="d-flex flex-column align-items-center align-items-md-start">
                                <div class="position-relative mb-3">
                                    <img src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "/images/default-avatar.png" : Model.AvatarUrl)"
                                         id="previewAvatar" class="rounded-circle border shadow-sm"
                                         style="width:120px; height:120px; object-fit:cover; border: 4px solid #fff !important;">

                                    <label for="avatarInput" class="position-absolute bottom-0 end-0 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow"
                                           style="cursor:pointer; width:36px; height:36px; border: 2px solid #fff;">
                                        <i class="bi bi-camera-fill"></i>
                                    </label>
                                    <input type="file" asp-for="AvatarFile" id="avatarInput" class="d-none" onchange="previewImage(event)">
                                </div>

                                <div class="badge rounded-pill bg-light text-dark border py-2 px-3 mb-3 w-100 d-flex align-items-center" style="cursor:pointer;">
                                    <i class="bi bi-lightning-fill text-warning me-2"></i>
                                    <span>Trạng thái tìm việc</span>
                                    <i class="bi bi-chevron-down ms-auto"></i>
                                </div>

                                <input asp-for="FullName" class="form-control fw-bold border-0 fs-5 mb-1 p-0 shadow-none text-center text-md-start" style="background:transparent" placeholder="Nhập họ tên..." />

                                <!-- Sửa phần Địa chỉ: Thêm ô nhập liệu ẩn hiện linh hoạt -->
                                <div class="w-100">
                                    <i class="bi bi-geo-alt me-1 small text-muted"></i>
                                    <input asp-for="Address" class="form-control form-control-sm border-0 p-0 shadow-none d-inline-block w-75 small"
                                           style="background:transparent" placeholder="Thêm địa chỉ hiện tại..." />
                                </div>
                            </div>
                        </div>

                        <!-- Phần bên phải: Các dòng thông tin chi tiết -->
                        <div class="col-md-7 ps-md-4 mt-4 mt-md-0">
                            <div class="d-flex flex-column gap-3">
                                <!-- Email (Chỉ đọc) -->
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center text-muted">
                                        <i class="bi bi-envelope me-3"></i>
                                        <span class="small">@Model.Email</span>
                                        <input type="hidden" asp-for="Email" />
                                    </div>
                                    <i class="bi bi-check-circle-fill text-success small" title="Đã xác thực"></i>
                                </div>

                                <!-- Số điện thoại -->
                                <div class="d-flex align-items-center border-bottom pb-2">
                                    <i class="bi bi-phone me-3 text-muted"></i>
                                    <input asp-for="Phone" class="form-control form-control-sm border-0 p-0 shadow-none text-dark fw-medium" placeholder="+ Thêm số điện thoại" style="background:transparent" />
                                </div>

                                <!-- Giới tính -->
                                <div class="d-flex align-items-center border-bottom pb-2">
                                    <i class="bi bi-gender-ambiguous me-3 text-muted"></i>
                                    <select asp-for="Gender" class="form-select form-select-sm border-0 p-0 shadow-none text-dark fw-medium" style="background:transparent; cursor:pointer">
                                        <option value="">+ Thêm giới tính</option>
                                        <option value="Nam">Nam</option>
                                        <option value="Nữ">Nữ</option>
                                        <option value="Khác">Khác</option>
                                    </select>
                                </div>

                                <!-- Ngày sinh -->
                                <div class="d-flex align-items-center border-bottom pb-2">
                                    <i class="bi bi-calendar-event me-3 text-muted"></i>
                                    <input asp-for="Birthday" type="date" class="form-control form-control-sm border-0 p-0 shadow-none text-dark fw-medium" style="background:transparent; cursor:pointer" />
                                </div>

                                <!-- Tình trạng hôn nhân -->
                                <div class="d-flex align-items-center border-bottom pb-2">
                                    <i class="bi bi-heart me-3 text-muted"></i>
                                    <select asp-for="MaritalStatus" class="form-select form-select-sm border-0 p-0 shadow-none text-dark fw-medium" style="background:transparent; cursor:pointer">
                                        <option value="">+ Thêm tình trạng hôn nhân</option>
                                        <option value="Độc thân">Độc thân</option>
                                        <option value="Đã kết hôn">Đã kết hôn</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card Tiêu chí tìm việc -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h5 class="fw-bold mb-4">Tiêu chí tìm việc</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="small text-muted mb-2">Ngành nghề mong muốn</label>
                            <select asp-for="Industry" class="form-select border-0 bg-light rounded-3 py-2">
                                <option value="">-- Chọn ngành nghề --</option>
                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var cat in ViewBag.Categories as List<JobPortal.Models.Category>)
                                    {
                                        <option value="@cat.Name">@cat.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="small text-muted mb-2">Địa điểm làm việc</label>
                            <select asp-for="DesiredLocation" class="form-select border-0 bg-light rounded-3 py-2">
                                <option value="">-- Chọn Tỉnh/Thành phố --</option>
                                @if (ViewBag.Locations != null)
                                {
                                    foreach (var loc in ViewBag.Locations as List<JobPortal.Models.Location>)
                                    {
                                        <option value="@loc.Name">@loc.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="small text-muted mb-2">Mức lương mong muốn (VNĐ)</label>
                            <div class="input-group">
                                <span class="input-group-text border-0 bg-light rounded-start-3"><i class="bi bi-cash-stack"></i></span>
                                <input asp-for="ExpectedSalary" class="form-control border-0 bg-light rounded-end-3 py-2" placeholder="Ví dụ: 10 - 15 triệu" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card CV của tôi -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 text-center">
                    <h5 class="fw-bold mb-3 text-start">CV ứng tuyển</h5>
                    <div class="upload-cv-zone p-4">
                        <input type="file" asp-for="CVFile" id="cvInput" class="d-none" accept=".pdf,.doc,.docx"
                               onchange="document.getElementById('cvFileName').innerText = 'Đã chọn: ' + this.files[0].name">

                        @if (!string.IsNullOrEmpty(Model.CVUrl))
                        {
                            <div class="mb-3">
                                <a href="@Model.CVUrl" target="_blank" class="text-primary text-decoration-none small">
                                    <i class="bi bi-file-earmark-pdf-fill me-1"></i> Xem CV hiện tại của bạn
                                </a>
                            </div>
                        }

                        <label for="cvInput" class="btn-cv-upload d-inline-flex align-items-center justify-content-center py-2 px-4 rounded-pill mb-2" style="cursor: pointer;">
                            <i class="bi bi-cloud-arrow-up-fill me-2"></i>
                            <span id="cvFileName">@(string.IsNullOrEmpty(Model.CVUrl) ? "Tải lên CV từ máy tính" : "Thay đổi bản CV khác")</span>
                        </label>
                        <p class="text-muted mt-2 mb-0" style="font-size: 11px;">Chấp nhận file PDF, DOCX (Tối đa 5MB)</p>
                    </div>
                </div>

                <!-- Nút LƯU -->
                <div class="d-grid gap-2 mt-4 mb-5">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm fw-bold py-3">
                        <i class="bi bi-save2 me-2"></i> CẬP NHẬT HỒ SƠ CỦA TÔI
                    </button>
                </div>
            </div>

            <!-- CỘT 3: VIỆC LÀM GỢI Ý -->
            <div class="col-lg-3">
                <h6 class="fw-bold mb-3 d-flex align-items-center">
                    <i class="bi bi-stars text-primary me-2"></i>Việc làm gợi ý
                </h6>
                @if (Model.SuggestedJobs != null && Model.SuggestedJobs.Any())
                {
                    @foreach (var job in Model.SuggestedJobs)
                    {
                        <div class="card border-0 shadow-sm rounded-4 p-3 mb-3 job-hover">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-light text-primary border-primary-subtle">@job.CompanyName</span>
                                <i class="bi bi-heart text-muted"></i>
                            </div>
                            <p class="fw-bold mb-1 small text-truncate">@job.Title</p>
                            <p class="text-danger small fw-bold mb-1">@job.SalaryRange triệu</p>
                            <p class="text-muted mb-0" style="font-size: 11px;"><i class="bi bi-geo-alt me-1"></i>@(job.JobLocation?.Name ?? "Toàn quốc")</p>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4 bg-white rounded-4 border">
                        <i class="bi bi-search text-muted fs-2"></i>
                        <p class="text-muted small mt-2">Đang tìm việc phù hợp...</p>
                    </div>
                }
            </div>
        </div>
    </form>
</div>

<style>
    .rounded-4 {
        border-radius: 16px !important;
    }

    .border-end {
        border-right: 1px solid #f0f0f0 !important;
    }

    .active-custom {
        color: #0d6efd !important;
        border-left: 4px solid #0d6efd !important;
        background-color: #f0f7ff !important;
    }

    .upload-cv-zone {
        border: 2px dashed #dee2e6;
        border-radius: 16px;
        background-color: #fafbfc;
        transition: 0.3s;
    }

        .upload-cv-zone:hover {
            border-color: #0d6efd;
            background-color: #f8faff;
        }

    .btn-cv-upload {
        background-color: #6f42c1;
        color: white;
        font-weight: 500;
        transition: 0.3s;
    }

        .btn-cv-upload:hover {
            background-color: #59359a;
            transform: translateY(-1px);
        }

    .job-hover {
        transition: 0.3s;
    }

        .job-hover:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.05) !important;
        }

    input::placeholder {
        color: #adb5bd !important;
        font-weight: normal;
    }

    @@media (max-width: 768px) {
        .border-end {
            border-right: none !important;
            border-bottom: 1px solid #f0f0f0;
            padding-bottom: 20px;
            margin-bottom: 20px;
        }
    }
</style>

<script>
    function previewImage(event) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                // Cập nhật cả 2 ảnh: ảnh lớn preview và ảnh nhỏ ở sidebar
                document.getElementById('previewAvatar').src = e.target.result;
                const sidebarImg = document.querySelector('.col-lg-3 img');
                if(sidebarImg) sidebarImg.src = e.target.result;
            }
            reader.readAsDataURL(file);
        }
    }
</script>