@model JobPortal.Models.CandidateProfileViewModel
@{
    Layout = "~/Views/Shared/_LayoutCV.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4 p-5">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold m-0">Cập nhật hồ sơ</h3>
                    <a asp-action="Index" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Quay lại</a>
                </div>

                <form asp-action="SaveProfile" method="post" enctype="multipart/form-data">
                    <div class="row g-4">
                        <div class="col-12 text-center">
                            <img src="@Model.AvatarUrl" id="imgPrev" class="rounded-circle mb-3" style="width:100px; height:100px; object-fit:cover;">
                            <input type="file" asp-for="AvatarFile" class="form-control" onchange="document.getElementById('imgPrev').src = window.URL.createObjectURL(this.files[0])">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Họ và tên</label>
                            <input asp-for="FullName" class="form-control rounded-3 py-2">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Số điện thoại</label>
                            <input asp-for="Phone" class="form-control rounded-3 py-2">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Giới tính</label>
                            <select asp-for="Gender" class="form-select rounded-3 py-2">
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Ngày sinh</label>
                            <input asp-for="Birthday" type="date" class="form-control rounded-3 py-2">
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Địa chỉ</label>
                            <input asp-for="Address" class="form-control rounded-3 py-2">
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Tải lên CV (PDF)</label>
                            <input type="file" asp-for="CVFile" class="form-control" accept=".pdf">
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill mt-5 fw-bold">LƯU THAY ĐỔI</button>
                </form>
            </div>
        </div>
    </div>
</div>