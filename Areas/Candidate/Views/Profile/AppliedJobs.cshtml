@model IEnumerable<JobPortal.Models.Application>

@{
    ViewData["Title"] = "Việc làm đã ứng tuyển";
    Layout = "~/Views/Shared/_LayoutCV.cshtml";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold m-0"><i class="fa-solid fa-briefcase text-primary me-2"></i>Việc làm đã ứng tuyển</h2>
        <span class="badge bg-primary rounded-pill px-3">@Model.Count() Công việc</span>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var app in Model)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 p-4 position-relative overflow-hidden">
                        <div class="position-absolute top-0 end-0 p-3">
                            <span class="badge @(app.Status == JobPortal.Models.ApplicationStatus.Submitted ? "bg-info" : "bg-success") px-3 py-2 rounded-pill">
                                @app.Status
                            </span>
                        </div>

                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h4 class="fw-bold text-primary mb-1">@app.JobPost?.Title</h4>
                                <p class="text-muted mb-2"><i class="fa-solid fa-building me-2"></i>@app.JobPost?.CompanyName</p>
                                <div class="d-flex gap-3 small text-secondary">
                                    <span><i class="fa-solid fa-calendar-check me-2"></i>Ngày nộp: @app.AppliedDate.ToString("dd/MM/yyyy")</span>
                                    <span><i class="fa-solid fa-location-dot me-2"></i>@app.JobPost?.JobLocation?.Name</span>
                                </div>
                            </div>
                            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                                <a asp-area="" asp-controller="Home" asp-action="JobDetails" asp-route-id="@app.JobPostId" class="btn btn-outline-primary rounded-pill px-4 fw-bold">
                                    Xem tin gốc
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
            <img src="~/images/empty-jobs.png" style="width: 200px; opacity: 0.5;" class="mx-auto mb-3">
            <h5 class="text-muted">Bạn chưa ứng tuyển công việc nào.</h5>
            <div class="mt-4">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-5 fw-bold">Tìm việc ngay</a>
            </div>
        </div>
    }
</div>