@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager
@model IEnumerable<IdentityUser>

@{
    ViewData["Title"] = "Quản lý người dùng";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
@if (!Model.Any())
{
    <div class="alert alert-info">Không tìm thấy kết quả nào phù hợp.</div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold"><i class="fa fa-users me-2"></i>Quản lý người dùng</h4>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
        <i class="fa fa-check-circle me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<form method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="input-group">
            <input type="text" name="searchEmail" class="form-control rounded-pill-start" placeholder="Nhập email cần tìm..." value="@Context.Request.Query["searchEmail"]">
            <button class="btn btn-primary rounded-pill-end" type="submit">
                <i class="fa fa-search"></i>
            </button>
        </div>
    </div>
</form>
<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Email tài khoản</th>
                        <th>Quyền hạn</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Chức năng</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        // Lấy Role hiện tại của người dùng
                        var roles = await UserManager.GetRolesAsync(user);
                        var currentRole = roles.FirstOrDefault() ?? "Candidate";

                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@user.Email</div>
                                <div class="extra-small text-muted" style="font-size: 0.75rem;">ID: @user.Id</div>
                            </td>
                            <td>
                                <form asp-action="AssignRole" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <select name="roleName" class="form-select form-select-sm w-auto rounded-pill border-primary shadow-sm" onchange="this.form.submit()">
                                        <option value="Candidate" selected="@(currentRole == "Candidate")">Candidate</option>
                                        <option value="Employer" selected="@(currentRole == "Employer")">Employer</option>
                                        <option value="Admin" selected="@(currentRole == "Admin")">Admin</option>
                                    </select>
                                </form>
                            </td>
                            <td>
                                @if (user.LockoutEnd > DateTime.Now)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger px-3 rounded-pill">Bị khóa</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success px-3 rounded-pill">Hoạt động</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-inline-flex gap-2">
                                    <form asp-action="ToggleLock" asp-route-userId="@user.Id" method="post" class="m-0">
                                        <button type="submit" class="btn btn-sm @(user.LockoutEnd > DateTime.Now ? "btn-outline-success" : "btn-outline-danger") rounded-pill px-3 shadow-sm">
                                            <i class="fa @(user.LockoutEnd > DateTime.Now ? "fa-unlock" : "fa-lock") me-1"></i>
                                            @(user.LockoutEnd > DateTime.Now ? "Mở khóa" : "Khóa")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>