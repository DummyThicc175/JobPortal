@{
    ViewData["Title"] = "Thống kê tổng quan";
}

<div class="row g-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white shadow-sm border-0 rounded-4">
            <div class="card-body p-4 text-center">
                <i class="fa fa-briefcase fa-3x mb-3"></i>
                <h5>Tổng việc làm</h5>
                <h2 class="fw-bold">@ViewBag.TotalJobs</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-warning text-white shadow-sm border-0 rounded-4">
            <div class="card-body p-4 text-center">
                <i class="fa fa-clock fa-3x mb-3"></i>
                <h5>Chờ duyệt</h5>
                <h2 class="fw-bold">@ViewBag.PendingJobs</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white shadow-sm border-0 rounded-4">
            <div class="card-body p-4 text-center">
                <i class="fa fa-users fa-3x mb-3"></i>
                <h5>Người dùng</h5>
                <h2 class="fw-bold">@ViewBag.TotalUsers</h2>
            </div>
        </div>
    </div>
</div>