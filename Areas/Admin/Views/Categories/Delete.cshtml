@model JobPortal.Models.Category

@{
    ViewData["Title"] = "Xóa ngành nghề";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4 border-top border-danger border-4">
            <div class="card-body p-5 text-center">
                <div class="text-danger mb-4">
                    <i class="fa fa-exclamation-triangle fa-4x"></i>
                </div>
                <h4 class="fw-bold mb-3">Xác nhận xóa?</h4>
                <p class="text-muted mb-4">
                    Bạn có chắc chắn muốn xóa ngành nghề <span class="fw-bold text-dark">"@Model.Name"</span>?
                    <br><small class="text-danger">Lưu ý: Hành động này không thể hoàn tác.</small>
                </p>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-center gap-2">
                        <button type="submit" class="btn btn-danger px-5 rounded-pill fw-bold">Xác nhận Xóa</button>
                        <a asp-action="Index" class="btn btn-light px-5 rounded-pill">Quay lại</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>