@model JobPortal.Models.Category

@{
    ViewData["Title"] = "Chỉnh sửa ngành nghề";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold text-warning"><i class="fa fa-edit me-2"></i>Cập nhật ngành nghề</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="form-group mb-4">
                        <label asp-for="Name" class="form-label fw-bold text-muted small text-uppercase"></label>
                        <input asp-for="Name" class="form-control form-control-lg rounded-3" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning px-4 rounded-pill fw-bold">
                            <i class="fa fa-save me-1"></i> Lưu thay đổi
                        </button>
                        <a asp-action="Index" class="btn btn-light px-4 rounded-pill">Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>