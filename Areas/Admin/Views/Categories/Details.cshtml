@model JobPortal.Models.Category

@{
    ViewData["Title"] = "Chi tiết ngành nghề";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold text-primary"><i class="fa fa-info-circle me-2"></i>Chi tiết ngành nghề</h5>
            </div>
            <div class="card-body p-4">
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Mã ngành nghề:</div>
                    <div class="col-sm-8 fw-bold">#@Model.Id</div>
                </div>
                <div class="row mb-4">
                    <div class="col-sm-4 text-muted">Tên ngành nghề:</div>
                    <div class="col-sm-8 fs-5 fw-bold text-dark">@Model.Name</div>
                </div>
                <hr />
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill px-4">
                        <i class="fa fa-edit me-1"></i> Chỉnh sửa
                    </a>
                    <a asp-action="Index" class="btn btn-light rounded-pill px-4">Quay lại danh sách</a>
                </div>
            </div>
        </div>
    </div>
</div>