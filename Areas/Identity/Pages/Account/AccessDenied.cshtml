@page
@model JobPortal.Areas.Identity.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center shadow-lg p-5 rounded-4 bg-white border-top border-5 border-danger">
            <div class="mb-4">
                <i class="fas fa-user-shield text-danger" style="font-size: 5rem;"></i>
            </div>
            <h1 class="display-5 fw-bold text-dark">Từ chối truy cập</h1>
            <p class="lead text-secondary mt-3">
                Rất tiếc, bạn không có đủ quyền hạn để truy cập vào chức năng này.
            </p>
            <hr class="my-4">
            <div class="d-grid gap-2 d-md-flex justify-content-md-center">
              
                <button onclick="history.back()" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                    Quay Lại
                </button>
            </div>
            @if (User.Identity.IsAuthenticated)
            {
                <div class="mt-4 p-2 bg-light rounded-3 small text-muted">
                    Bạn đang đăng nhập với: <strong>@User.Identity.Name</strong>
                </div>
            }
        </div>
    </div>
</div>