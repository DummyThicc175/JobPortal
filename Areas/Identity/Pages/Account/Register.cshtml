@page
@model RegisterModel
@{
    ViewData["Title"] = "Tham gia cùng JobHub";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="bg-primary p-4 text-center">
                    <h2 class="text-white fw-bold mb-0">Tạo tài khoản mới</h2>
                </div>
                <div class="card-body p-5">
                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control border-0 bg-light" placeholder="name@example.com" />
                            <label asp-for="Input.Email">Email của bạn</label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <select asp-for="Input.Role" asp-items="@Model.RoleList" class="form-select">
                                <option disabled selected>-- Chọn loại tài khoản --</option>
                            </select>
                            <span asp-validation-for="Input.Role" class="text-danger"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Password" class="form-control border-0 bg-light" placeholder="Mật khẩu" />
                                    <label asp-for="Input.Password">Mật khẩu</label>
                                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.ConfirmPassword" class="form-control border-0 bg-light" placeholder="Xác nhận" />
                                    <label asp-for="Input.ConfirmPassword">Xác nhận lại</label>
                                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <select asp-for="Input.Role" asp-items="@Model.RoleList" class="form-select">
                                    <option disabled selected>-- Chọn loại tài khoản --</option>
                                </select>
                                <span asp-validation-for="Input.Role" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="my-4">
                            <p class="small text-muted text-center">Bằng cách nhấn đăng ký, bạn đồng ý với các Điều khoản & Chính sách của chúng tôi.</p>
                        </div>

                        <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary rounded-pill py-3 fw-bold">Hoàn tất đăng ký</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}