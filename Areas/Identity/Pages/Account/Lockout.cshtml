@page
@model JobPortal.Areas.Identity.Pages.Account.LockoutModel
@{
    ViewData["Title"] = "Tài khoản bị khóa";
}

<div class="container mt-5">
    <div class="row justify-content-center align-items-center" style="min-height: 70vh;">
        <div class="col-md-6 text-center shadow-lg p-5 rounded-4 bg-white border-top border-5 border-warning">
            <div class="mb-4">
                <i class="fas fa-user-lock text-warning" style="font-size: 5rem;"></i>
            </div>
            <h1 class="fw-bold text-dark">Tài khoản tạm khóa</h1>
            <div class="alert alert-warning border-0 rounded-4 my-4 shadow-sm">
                <p class="mb-0 text-dark">
                    Tài khoản của bạn đã bị tạm dừng hoạt động. Vui lòng liên hệ quản trị viên để biết thêm chi tiết hoặc yêu cầu khôi phục.
                </p>
            </div>
            <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-4">
                <a href="/" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">
                    <i class="fas fa-home me-2"></i>Về Trang Chủ
                </a>
            </div>
            <p class="mt-4 text-muted small">
                Email hỗ trợ: <a href="mailto:admin@jobportal.com" class="text-decoration-none">admin@jobportal.com</a>
            </p>
        </div>
    </div>
</div>