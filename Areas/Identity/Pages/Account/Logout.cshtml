@page
@model LogoutModel
@{
    ViewData["Title"] = "Đăng xuất";
}

<div class="container mt-5">
    <div class="row justify-content-center pt-5">
        <div class="col-md-5 text-center">
            <div class="mb-4">
                <i class="bi bi-box-arrow-right display-1 text-muted"></i>
            </div>

            @{
                if (User.Identity?.IsAuthenticated ?? false)
                {
                    <h2 class="fw-bold mb-3">Bạn muốn đăng xuất?</h2>
                    <p class="text-muted mb-4">Chúng tôi hy vọng sẽ sớm được gặp lại bạn!</p>
                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                        <button type="submit" class="btn btn-danger btn-lg rounded-pill px-5">Xác nhận Đăng xuất</button>
                    </form>
                }
                else
                {
                    <h2 class="fw-bold text-success mb-3">Đăng xuất thành công</h2>
                    <p class="text-muted mb-4">Cảm ơn bạn đã sử dụng dịch vụ của chúng tôi.</p>
                    <a href="/" class="btn btn-outline-primary btn-lg rounded-pill px-5">Quay về Trang chủ</a>
                }
            }
        </div>
    </div>
</div>