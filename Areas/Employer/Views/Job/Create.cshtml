@model JobPortal.Models.JobPost
@{
    ViewData["Title"] = "Tạo chiến dịch tuyển dụng";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-5">
                <h3 class="fw-bold text-primary mb-4">Đăng tin tuyển dụng mới</h3>
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Tiêu đề vị trí tuyển dụng</label>
                        <input asp-for="Title" class="form-control form-control-lg border-2" placeholder="Ví dụ: Senior .NET Developer" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label class="form-label fw-bold">Ngành nghề</label>
                            <select asp-for="CategoryId" class="form-select border-2"
                                    asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
                                <option value="">-- Chọn ngành nghề --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>

                    </div>

                    <div class="col-md-6 mb-4">
                            <label class="form-label fw-bold">Địa điểm làm việc</label>
                            <select asp-for="LocationId" class="form-select border-2"
                                    asp-items="@(new SelectList(ViewBag.Locations, "Id", "Name"))">
                                <option value="">-- Chọn tỉnh/thành phố --</option>
                            </select>
                            <span asp-validation-for="LocationId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label class="form-label fw-bold">Mức lương (Ví dụ: 10 - 15 triệu)</label>
                            <input asp-for="SalaryRange" class="form-control border-2" placeholder="Thỏa thuận..." />
                        </div>

                        <div class="col-md-6 mb-4">
                            <label class="form-label fw-bold">Tên hiển thị công ty</label>
                            <input asp-for="CompanyName" class="form-control border-2" placeholder="Nhập tên công ty..." />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Mô tả công việc & Yêu cầu</label>
                        <textarea asp-for="Description" class="form-control border-2" rows="10" placeholder="Mô tả chi tiết công việc, quyền lợi và yêu cầu ứng viên..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <hr class="my-4">

                    <div class="d-flex justify-content-end gap-3">
                        <a asp-action="Index" class="btn btn-light px-4 rounded-pill">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-5 rounded-pill fw-bold shadow-sm">
                            <i class="bi bi-send-fill me-2"></i> Đăng bài ngay
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>