@model IEnumerable<JobPortal.Models.EmployerApplicantViewModel>

@{
    ViewData["Title"] = "Danh sách ứng viên";
    Layout = "/Areas/Employer/Views/Shared/_LayoutEmployer.cshtml";
    // File mặc định dự phòng nếu ứng viên đó chưa kịp cập nhật CV cá nhân
    var defaultCV = "/uploads/cvs/default-cv.pdf";
}

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="fw-bold mb-0"><i class="fa-solid fa-users text-primary me-2"></i>Ứng viên đã ứng tuyển</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Ứng viên</th>
                            <th>Vị trí ứng tuyển</th>
                            <th>Ngày nộp</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                      
                                        <div>
                                            <div class="fw-bold">@app.CandidateName</div>
                                            <small class="text-muted d-block">@app.CandidateEmail</small>
                                            <small class="text-muted">ID Ứng tuyển: @app.Id</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@app.JobTitle</span>
                                </td>
                                <td>@app.AppliedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="badge bg-info">@app.Status</span>
                                </td>
                                <td class="text-center">
                                    @* ĐOẠN SỬA QUAN TRỌNG: Nếu ứng viên có CV cá nhân thì hiện CV cá nhân, ngược lại mới dùng defaultCV *@
                                    <a href="@(string.IsNullOrEmpty(app.CvUrl) ? defaultCV : app.CvUrl)" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        <i class="fa-solid fa-file-pdf me-1"></i> Xem CV
                                    </a>

                                    <button class="btn btn-sm btn-success rounded-pill px-3 ms-2 btn-open-chat" 
                                            data-partner-id="@app.CandidateId" 
                                            data-partner-name="@app.CandidateName">
                                        <i class="fa-solid fa-comment-dots me-1"></i> Nhắn tin
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>