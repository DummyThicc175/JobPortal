@model JobPortal.Models.JobPost
@{
    ViewData["Title"] = "Chỉnh sửa tin đăng";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-5">
                <h3 class="fw-bold text-primary mb-4">Chỉnh sửa tin tuyển dụng</h3>
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-4">
                        <label class="form-label fw-bold">Tiêu đề vị trí tuyển dụng</label>
                        <input asp-for="Title" class="form-control form-control-lg border-2" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label class="form-label fw-bold">Ngành nghề</label>
                            <select asp-for="CategoryId" class="form-select border-2"
                                    asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
                                <option value="">-- Chọn ngành nghề --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="form-label fw-bold">Địa điểm làm việc</label>
                            <select asp-for="LocationId" class="form-select border-2"
                                    asp-items="@(new SelectList(ViewBag.Locations, "Id", "Name"))">
                                <option value="">-- Chọn địa điểm --</option>
                            </select>
                            <span asp-validation-for="LocationId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label class="form-label fw-bold">Mức lương (Ví dụ: 10 - 15 triệu)</label>
                            <input asp-for="SalaryRange" class="form-control border-2" placeholder="Thỏa thuận..." />
                            <span asp-validation-for="SalaryRange" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="form-label fw-bold">Tên hiển thị công ty</label>
                            <input asp-for="CompanyName" class="form-control border-2" />
                            <span asp-validation-for="CompanyName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Mô tả công việc & Yêu cầu</label>
                        <textarea asp-for="Description" class="form-control border-2" rows="10"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-3">
                        <a asp-action="Index" class="btn btn-light px-4 rounded-pill">Quay lại</a>
                        <button type="submit" class="btn btn-success px-5 rounded-pill fw-bold shadow-sm">
                            <i class="bi bi-save me-2"></i>Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>