@model IEnumerable<JobPortal.Models.JobPost>

@{
    ViewData["Title"] = "Bảng điều khiển";
}

<div class="container-fluid p-0">
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card p-4 border-start border-primary border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase small fw-bold">Tổng tin đăng</h6>
                        <h2 class="fw-bold mb-0">@Model.Count()</h2>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                        <i class="bi bi-file-earmark-text text-primary fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-4 border-start border-success border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase small fw-bold">Tin đã duyệt</h6>
                        <h2 class="fw-bold mb-0">@Model.Count(x => x.IsApproved)</h2>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle">
                        <i class="bi bi-check-circle text-success fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-4 border-start border-warning border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase small fw-bold">Đang chờ duyệt</h6>
                        <h2 class="fw-bold mb-0">@Model.Count(x => !x.IsApproved)</h2>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle">
                        <i class="bi bi-clock-history text-warning fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">Danh sách việc làm</h5>
            <div class="d-flex gap-3 align-items-center">
                <div class="input-group w-25">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control bg-light border-start-0 ps-0" placeholder="Tìm kiếm tin...">
                </div>
                <div class="d-flex gap-3 align-items-center">
                    <a asp-area="Employer" asp-controller="Job" asp-action="Create" class="btn btn-primary px-4">
                        <i class="bi bi-plus-circle me-2"></i>Đăng tin mới
                    </a>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Vị trí tuyển dụng</th>
                            <th>Ngày đăng</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@item.Title</div>
                                <div class="small text-muted"><i class="bi bi-building me-1"></i>@item.CompanyName</div>
                            </td>
                            <td>
                                <div class="small"><i class="bi bi-calendar3 me-1"></i>@item.CreatedAt.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td>
                                @if(item.IsApproved) {
                                    <span class="badge rounded-pill bg-success-subtle text-success border border-success px-3">
                                        <i class="bi bi-check2-all me-1"></i> Đang hiển thị
                                    </span>
                                } else {
                                    <span class="badge rounded-pill bg-warning-subtle text-warning border border-warning px-3">
                                        <i class="bi bi-hourglass-split me-1"></i> Đang chờ
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <a asp-action="Candidates" asp-route-jobId="@item.Id" class="btn btn-sm btn-outline-info" title="Xem ứng viên">
                                        <i class="bi bi-people-fill"></i>
                                    </a>
                                    <a href="#" class="btn btn-sm btn-outline-primary" title="Sửa tin">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger" title="Xóa tin">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>