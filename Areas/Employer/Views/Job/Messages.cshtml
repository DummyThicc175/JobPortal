@using System.Security.Claims
@{
    ViewData["Title"] = "Quản lý tin nhắn";
    Layout = "/Areas/Employer/Views/Shared/_LayoutEmployer.cshtml";
}

<div class="container-fluid py-2">
    <div class="card border-0 shadow-sm rounded-4" style="height: calc(100vh - 160px); overflow: hidden; display: flex; flex-direction: row; background: #fff;">
        
        <div style="width: 300px; background: #f8fafc; border-right: 1px solid #e2e8f0; display: flex; flex-direction: column;">
            <div class="p-3 fw-bold border-bottom" style="background: #0d6efd; color: white; font-size: 16px;">
                <i class="bi bi-chat-left-text me-2"></i>Danh sách hội thoại
            </div>
            <div id="employer-partner-list" style="flex: 1; overflow-y: auto; padding: 10px 0;">
                <div style="padding: 30px; text-align: center; color: #64748b; font-size: 13px;">Đang tải danh sách...</div>
            </div>
        </div>

        <div style="flex: 1; display: flex; flex-direction: column; background: #ffffff;">
            <div class="p-3 fw-bold border-bottom d-flex justify-content-between align-items-center" style="color: #1e293b; background: #fff; font-size: 16px; height: 55px;">
                <span id="current-chat-title"><i class="bi bi-person-badge me-2"></i>Chọn một ứng viên để xem</span>
            </div>
            
            <div id="employer-chat-body" style="flex: 1; padding: 20px; overflow-y: auto; background: #f1f5f9; display: flex; flex-direction: column; gap: 12px;">
                <div style="align-self: center; background: #fff; padding: 12px 20px; border-radius: 20px; font-size: 13px; color: #64748b; box-shadow: 0 2px 5px rgba(0,0,0,0.05); margin-top: auto; margin-bottom: auto;">
                    Hãy bấm chọn một ứng viên ở danh sách bên trái để quản lý cuộc hội thoại.
                </div>
            </div>

            <div class="p-3 border-top d-flex align-items-center gap-2" style="background: white;">
                <input type="text" id="employer-chat-input" class="form-control" placeholder="Nhập nội dung tin nhắn..." disabled style="border-radius: 20px; padding-left: 15px; height: 42px;">
                <button id="employer-btn-send" disabled class="btn btn-primary d-flex align-items-center justify-content-center" style="border-radius: 50%; width: 42px; height: 42px; padding: 0; background-color: #0d6efd; border: none;">
                    <i class="fa-solid fa-paper-plane" style="color: white; font-size: 15px;"></i>
                </button>
            </div>
        </div>

    </div>
</div>

<input type="hidden" id="employer-current-id" value="@User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier)" />
<input type="hidden" id="employer-active-partner" value="" />

<style>
    .chat-user-item { transition: background 0.2s; border-bottom: 1px solid #eef2ff; cursor: pointer; }
    .chat-user-item:hover { background: #f1f5f9; }
    .chat-user-item.active { background: #e0f2fe; border-left: 4px solid #0d6efd; }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
<script>
    const signalrConnection = new signalR.HubConnectionBuilder().withUrl("/chatHub").build();
    const myId = document.getElementById("employer-current-id").value;

    function appendEmployerMessage(text, isMe, time) {
        const body = document.getElementById("employer-chat-body");
        if(!body) return;

        const msgDiv = document.createElement("div");
        msgDiv.style.padding = "10px 15px";
        msgDiv.style.borderRadius = "15px";
        msgDiv.style.maxWidth = "70%";
        msgDiv.style.fontSize = "14px";

        if (isMe) {
            msgDiv.style.alignSelf = "flex-end";
            msgDiv.style.background = "#0d6efd";
            msgDiv.style.color = "white";
        } else {
            msgDiv.style.alignSelf = "flex-start";
            msgDiv.style.background = "#e2e8f0";
            msgDiv.style.color = "#1e293b";
        }

        msgDiv.innerHTML = `<div>${text}</div><small style="font-size: 10px; opacity: 0.6; display: block; text-align: right; margin-top: 2px;">${time}</small>`;
        body.appendChild(msgDiv);
        body.scrollTop = body.scrollHeight;
    }

    function loadEmployerChatPartners() {
        const listContainer = document.getElementById("employer-partner-list");
        if(!listContainer) return;

        fetch('/Chat/GetChatPartners')
            .then(res => res.json())
            .then(partners => {
                listContainer.innerHTML = "";
                if(partners.length === 0) {
                    listContainer.innerHTML = `<div style="padding:20px;text-align:center;color:#64748b;">Chưa có cuộc trò chuyện nào</div>`;
                    return;
                }
                partners.forEach(p => {
                    const div = document.createElement("div");
                    div.id = `partner-item-${p.id}`;
                    div.className = "chat-user-item p-3 d-flex align-items-center gap-3";
                    div.innerHTML = `
                        <div style="width: 40px; height: 40px; border-radius: 50%; background: #0d6efd; color: white; display: flex; align-items: center; justify-content: center; font-weight: bold;">
                            ${p.name.charAt(0).toUpperCase()}
                        </div>
                        <div style="flex: 1; min-width: 0;">
                            <div style="font-weight: 600; font-size: 14px; color: #1e293b;" class="text-truncate">${p.name}</div>
                            <small class="text-muted" style="font-size: 12px;">Ứng viên</small>
                        </div>
                    `;
                    div.onclick = () => selectPartnerChat(p.id, p.name);
                    listContainer.appendChild(div);
                });
            });
    }

    function selectPartnerChat(id, name) {
        document.getElementById("employer-active-partner").value = id;
        document.getElementById("current-chat-title").innerHTML = `<i class="bi bi-person-check me-2 text-success"></i>Đang chat với: <strong>${name}</strong>`;
        
        document.getElementById("employer-chat-input").removeAttribute("disabled");
        document.getElementById("employer-btn-send").removeAttribute("disabled");

        document.querySelectorAll('.chat-user-item').forEach(el => el.classList.remove('active'));
        const activeEl = document.getElementById(`partner-item-${id}`);
        if(activeEl) activeEl.classList.add('active');

        const body = document.getElementById("employer-chat-body");
        body.innerHTML = "";

        fetch(`/Chat/GetChatHistory?partnerId=${id}`)
            .then(res => res.json())
            .then(messages => {
                messages.forEach(m => {
                    appendEmployerMessage(m.content, m.isMe, m.time);
                });
            });
    }

    function sendMsg() {
        const partnerId = document.getElementById("employer-active-partner").value;
        const input = document.getElementById("employer-chat-input");
        const text = input.value.trim();

        if (text !== "" && partnerId !== "") {
            signalrConnection.invoke("SendMessage", myId, partnerId, text).catch(err => console.error(err));
            input.value = "";
        }
    }

    signalrConnection.on("ReceiveMessage", function (senderId, receiverId, message, time) {
        const activePartner = document.getElementById("employer-active-partner").value;
        
        if (receiverId === myId || senderId === myId) {
            loadEmployerChatPartners();
        }

        if ((senderId === myId && receiverId === activePartner) || 
            (senderId === activePartner && receiverId === myId)) {
            appendEmployerMessage(message, senderId === myId, time);
        }
    });

    signalrConnection.start().then(() => {
        loadEmployerChatPartners();
    }).catch(err => console.error(err));

    document.getElementById("employer-btn-send").addEventListener("click", sendMsg);
    document.getElementById("employer-chat-input").addEventListener("keypress", function(e) {
        if (e.key === "Enter") sendMsg();
    });
</script>