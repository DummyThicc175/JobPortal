@model IEnumerable<JobPortal.Models.EmployerApplicantViewModel>

@{
    ViewData["Title"] = "Danh sách ứng viên";
}

<style>
    .applicants-header {
        background: linear-gradient(135deg, #0066ff 0%, #0038a0 100%);
        color: white;
        padding: 2.5rem 2rem;
        border-radius: 1.5rem;
        margin-bottom: 2rem;
        box-shadow: 0 10px 35px rgba(0, 102, 255, 0.15);
    }

    .applicants-header h1 {
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        margin-bottom: 0.5rem;
    }

    .applicants-header .job-title {
        font-size: 1rem;
        opacity: 0.9;
    }

    .applicants-header .back-button {
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.3);
        color: white;
        padding: 0.625rem 1.25rem;
        border-radius: 0.75rem;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .applicants-header .back-button:hover {
        background: rgba(255, 255, 255, 0.25);
        border-color: rgba(255, 255, 255, 0.5);
        color: white;
    }

    .applicants-empty {
        background: white;
        border-radius: 1.25rem;
        padding: 3rem 2rem;
        text-align: center;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
    }

    .applicants-empty-icon {
        font-size: 4rem;
        color: #cbd5e1;
        margin-bottom: 1rem;
    }

    .applicants-empty h3 {
        font-size: 1.3rem;
        font-weight: 600;
        color: #0f172a;
        margin-bottom: 0.5rem;
    }

    .applicants-empty p {
        color: #64748b;
        margin: 0;
    }

    .applicants-list {
        display: grid;
        gap: 1.25rem;
    }

    .applicant-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        padding: 1.5rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
    }

    .applicant-card:hover {
        border-color: #cbd5e1;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.12);
        transform: translateY(-2px);
    }

    .applicant-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1.25rem;
    }

    .applicant-info {
        flex: 1;
    }

    .applicant-name {
        font-size: 1.1rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 0.25rem;
    }

    .applicant-email {
        font-size: 0.9rem;
        color: #6b7280;
        text-decoration: none;
    }

    .applicant-email:hover {
        color: #0066ff;
    }

    .applicant-status {
        background: rgba(34, 197, 94, 0.1);
        border: 1px solid rgba(34, 197, 94, 0.3);
        border-radius: 9999px;
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: #16a34a;
    }

    .applicant-body {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .applicant-detail {
        padding: 1rem;
        background: #f9fafb;
        border-radius: 0.75rem;
        border: 1px solid #f3f4f6;
    }

    .applicant-detail-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #6b7280;
        margin-bottom: 0.5rem;
    }

    .applicant-detail-value {
        font-size: 0.95rem;
        color: #0f172a;
        font-weight: 500;
    }

    .applicant-cv {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.875rem;
        background: linear-gradient(135deg, rgba(0, 102, 255, 0.08), rgba(59, 130, 246, 0.08));
        border: 1px solid rgba(0, 102, 255, 0.15);
        border-radius: 0.75rem;
        text-decoration: none;
        color: #0066ff;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .applicant-cv:hover {
        background: linear-gradient(135deg, rgba(0, 102, 255, 0.15), rgba(59, 130, 246, 0.15));
        border-color: rgba(0, 102, 255, 0.3);
        color: #0052cc;
    }

    .applicant-cv-icon {
        font-size: 1.25rem;
    }

    .applicant-cv-empty {
        padding: 0.875rem;
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 0.75rem;
        color: #9ca3af;
        font-size: 0.9rem;
    }

    .applicant-footer {
        display: flex;
        gap: 1rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e5e7eb;
    }

    .applicant-action-button {
        flex: 1;
        padding: 0.625rem 1rem;
        border: 1px solid #cbd5e1;
        border-radius: 0.625rem;
        background: white;
        color: #0066ff;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        text-align: center;
    }

    .applicant-action-button:hover {
        background: #f0f6ff;
        border-color: #0066ff;
        color: #0052cc;
    }

    @@media (max-width: 768px) {
        .applicants-header {
            padding: 1.5rem 1rem;
        }

        .applicants-header h1 {
            font-size: 1.5rem;
        }

        .applicant-body {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="container-fluid py-5">
    <div class="applicants-header d-flex justify-content-between align-items-start">
        <div>
            <h1>Ứng viên đã ứng tuyển</h1>
            <div class="job-title">
                Bài đăng: <strong>@(Model.FirstOrDefault()?.JobTitle ?? "-")</strong>
            </div>
        </div>
        <a asp-area="Employer" asp-controller="Job" asp-action="Index" class="back-button">
            <i class="bi bi-arrow-left-circle"></i> Quay lại
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="applicants-empty">
            <div class="applicants-empty-icon">
                <i class="bi bi-inbox"></i>
            </div>
            <h3>Chưa có ứng viên nào</h3>
            <p>Hiện tại chưa có ứng viên nào ứng tuyển cho bài đăng này.</p>
        </div>
    }
    else
    {
        <div class="applicants-list">
            @foreach (var applicant in Model)
            {
                <div class="applicant-card">
                    <div class="applicant-card-header">
                        <div class="applicant-info">
                            <div class="applicant-name">@applicant.CandidateName</div>
                            <a href="mailto:@applicant.CandidateEmail" class="applicant-email">@applicant.CandidateEmail</a>
                        </div>
                        <div class="applicant-status">
                            @applicant.Status
                        </div>
                    </div>

                    <div class="applicant-body">
                        <div class="applicant-detail">
                            <div class="applicant-detail-label">Ngày ứng tuyển</div>
                            <div class="applicant-detail-value">@applicant.AppliedDate.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <div class="applicant-detail">
                            <div class="applicant-detail-label">Vị trí</div>
                            <div class="applicant-detail-value">@applicant.JobTitle</div>
                        </div>
                        @if (!string.IsNullOrEmpty(applicant.CandidateId))
                        {
                            <div class="applicant-detail">
                                <div class="applicant-detail-label">Mã ứng viên</div>
                                <div class="applicant-detail-value">@applicant.CandidateId.Substring(0, Math.Min(8, applicant.CandidateId.Length))...</div>
                            </div>
                        }
                    </div>

                    <div class="applicant-footer">
                        <div style="flex: 1;">
                            @if (!string.IsNullOrEmpty(applicant.CvUrl) && !string.IsNullOrEmpty(applicant.CvFileName))
                            {
                                <a href="@applicant.CvUrl" target="_blank" class="applicant-cv">
                                    <i class="bi bi-file-earmark-pdf applicant-cv-icon"></i>
                                    <span>Xem CV</span>
                                </a>
                            }
                            else if (!string.IsNullOrEmpty(applicant.CvFileName))
                            {
                                <div class="applicant-cv" style="cursor: default;">
                                    <i class="bi bi-file-earmark applicant-cv-icon"></i>
                                    <span>@applicant.CvFileName</span>
                                </div>
                            }
                            else
                            {
                                <div class="applicant-cv-empty">
                                    <i class="bi bi-exclamation-circle me-1"></i> Chưa có CV
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
