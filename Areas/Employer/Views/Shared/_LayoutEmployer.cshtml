<!DOCTYPE html>
@using System.Security.Claims
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Employer Panel</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --sidebar-bg: #1a1d20;
            --primary-color: #0d6efd;
        }

        body {
            background-color: #f4f7f6;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Sidebar Styling */
        .sidebar {
            min-height: 100vh;
            background: var(--sidebar-bg);
            color: white;
            transition: all 0.3s;
        }

            .sidebar .nav-link {
                color: #adb5bd;
                padding: 12px 20px;
                display: flex;
                align-items: center;
                border-radius: 0;
                transition: 0.2s;
            }

                .sidebar .nav-link:hover {
                    background: #2c3136;
                    color: white;
                }

                .sidebar .nav-link.active {
                    background: var(--primary-color);
                    color: white;
                    fw-bold;
                }

                .sidebar .nav-link i {
                    margin-right: 12px;
                    font-size: 1.1rem;
                }

        /* Main Content Styling */
        .main-content {
            padding: 25px;
            background: #f8f9fa;
            min-height: 100vh;
        }

        .top-navbar {
            background: white;
            padding: 15px 30px;
            border-bottom: 1px solid #dee2e6;
            margin: -25px -25px 25px -25px;
        }

        /* Global Card Adjustments */
        .card {
            border: none;
            box-shadow: 0 2px 4px rgba(0,0,0,.04);
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-2 d-none d-md-block sidebar p-0 position-fixed">
                <div class="p-4 border-bottom border-secondary">
                    <h5 class="mb-0 text-white fw-bold"><i class="bi bi-briefcase-fill text-primary me-2"></i>JobHub</h5>
                    <small class="text-muted">Nhà tuyển dụng</small>
                </div>

                <div class="pt-3">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")"
                               asp-area="Employer" asp-controller="Job" asp-action="Index">
                                <i class="bi bi-speedometer2"></i> Tổng quan
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Create" ? "active" : "")"
                               asp-area="Employer" asp-controller="Job" asp-action="Create">
                                <i class="bi bi-plus-square"></i> Đăng tin tuyển dụng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Candidates1" ? "active" : "")"
                               asp-area="Employer" asp-controller="Job" asp-action="Candidates1">
                                <i class="bi bi-people"></i> Quản lý ứng viên
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Messages" ? "active" : "")"
                            asp-area="Employer" asp-controller="Job" asp-action="Messages">
                                <i class="bi bi-chat-dots"></i> Nhắn tin
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="position-absolute bottom-0 w-100 pb-4 border-top border-secondary">
                    <a href="/" class="nav-link text-danger mt-3">
                        <i class="bi bi-box-arrow-left"></i> Quay lại trang chủ
                    </a>
                </div>
            </nav>

            <main class="col-md-10 ms-sm-auto main-content">
                <div class="top-navbar d-flex justify-content-between align-items-center">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item"><a href="#">Employer</a></li>
                            <li class="breadcrumb-item active">@ViewData["Title"]</li>
                        </ol>
                    </nav>
                    <div class="d-flex align-items-center">
                        <div class="text-end me-3">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <div class="fw-bold text-dark">
                                    @(User.Identity.Name?.Split('@')[0] ?? "Nhà tuyển dụng")
                                </div>
                                <small class="text-muted" style="font-size: 0.8rem;">@User.Identity.Name</small>
                            }
                            else
                            {
                                <div class="fw-bold text-dark">Guest</div>
                                <small class="text-muted" style="font-size: 0.8rem;">Chưa đăng nhập</small>
                            }
                        </div>

                        
                    </div>
                </div>

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <div id="chat-window" style="display: none; flex-direction: column; position: fixed; bottom: 110px; right: 30px; width: 380px; height: 520px; background: white; border-radius: 28px; box-shadow: 0 20px 60px rgba(0,0,0,0.2); z-index: 3000; overflow: hidden; font-family: 'Inter', sans-serif;">
    
    <div class="chat-header" style="padding: 20px; font-weight: 800; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; background: #0066ff; color: white;">
        <span id="chat-partner-name" style="font-size: 16px;">Trợ lý AI (JobBot)</span>
        <i class="fa-solid fa-xmark" style="cursor: pointer; font-size: 18px; opacity: 0.8; transition: 0.2s;" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=0.8" onclick="toggleChat()"></i>
    </div>
    
    <div id="chat-body" style="flex: 1; padding: 15px; overflow-y: auto; background: #f8fafc; display: flex; flex-direction: column; gap: 10px;">
        <div style="align-self: flex-start; background: #e2e8f0; padding: 10px 15px; border-radius: 15px; max-width: 75%; font-size: 14px;">
            Chào bạn! Mình có thể giúp gì cho bạn?
        </div>
    </div>

    <div class="chat-footer" style="padding: 15px; border-top: 1px solid #f1f5f9; display: flex; align-items: center; gap: 10px; background: white;">
        <input type="text" id="chat-input" class="form-control" placeholder="Nhập tin nhắn..." style="border-radius: 20px; border: 1px solid #cbd5e1; padding-left: 15px; height: 40px; flex: 1;">
        
        <button id="btn-send-chat" class="btn btn-primary" style="border-radius: 50%; width: 40px; height: 40px; padding: 0; display: flex; align-items: center; justify-content: center; background-color: #0066ff; border: none; transition: 0.2s;">
            <i class="fa-solid fa-paper-plane" style="color: white; font-size: 16px; margin-left: 2px;"></i>
        </button>
    </div>
</div>

<input type="hidden" id="current-user-id" value="@User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier)" />
<input type="hidden" id="active-partner-id" value="" />

 

  
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>

<script>
    // 1. Khởi tạo và thiết lập kết nối SignalR Hub
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .build();

    connection.start().then(function () {
        console.log("Đã kết nối thành công tới trạm SignalR!");
    }).catch(function (err) {
        return console.error(err.toString());
    });

    const currentUserId = document.getElementById("current-user-id").value;

    // 2. Lắng nghe tin nhắn từ Server gửi về theo thời gian thực
    connection.on("ReceiveMessage", function (senderId, receiverId, message, time) {
        const activePartnerId = document.getElementById("active-partner-id").value;

        // Nếu tin nhắn thuộc cuộc trò chuyện đang hiển thị trên màn hình
        if ((senderId === currentUserId && receiverId === activePartnerId) || 
            (senderId === activePartnerId && receiverId === currentUserId)) {
            
            appendMessage(message, senderId === currentUserId, time);
        }
    });

    // Hàm sinh cấu trúc bong bóng tin nhắn (Xanh bên phải nếu là mình gửi, Xám bên trái nếu người ta gửi)
    function appendMessage(text, isMe, time) {
        const chatBody = document.getElementById("chat-body");
        if(!chatBody) return;
        
        const msgDiv = document.createElement("div");
        msgDiv.style.padding = "10px 15px";
        msgDiv.style.borderRadius = "15px";
        msgDiv.style.maxWidth = "75%";
        msgDiv.style.fontSize = "14px";
        msgDiv.style.position = "relative";

        if (isMe) {
            msgDiv.style.alignSelf = "flex-end";
            msgDiv.style.background = "#0066ff";
            msgDiv.style.color = "white";
        } else {
            msgDiv.style.alignSelf = "flex-start";
            msgDiv.style.background = "#e2e8f0";
            msgDiv.style.color = "#1e293b";
        }

        msgDiv.innerHTML = `<div>${text}</div><small style="font-size: 10px; opacity: 0.6; display: block; text-align: right; margin-top: 2px;">${time}</small>`;
        chatBody.appendChild(msgDiv);
        chatBody.scrollTop = chatBody.scrollHeight; // Tự động cuộn xuống dưới cùng
    }

    // 3. Sự kiện bắt hành động click nút "Nhắn tin" từ trang danh sách ứng viên
    document.addEventListener("click", function(e) {
        const target = e.target.closest(".btn-open-chat");
        if (target) {
            const partnerId = target.getAttribute("data-partner-id");
            const partnerName = target.getAttribute("data-partner-name");

            document.getElementById("active-partner-id").value = partnerId;
            document.getElementById("chat-partner-name").innerText = partnerName;
            
            // Mở hộp thoại chat
            document.getElementById("chat-window").style.display = "flex";

            // Xóa sạch hội thoại cũ và nạp lại lịch sử trò chuyện từ DB
            const chatBody = document.getElementById("chat-body");
            chatBody.innerHTML = "";

            fetch(`/Chat/GetChatHistory?partnerId=${partnerId}`)
                .then(res => res.json())
                .then(messages => {
                    messages.forEach(m => {
                        appendMessage(m.content, m.isMe, m.time);
                    });
                });
        }
    });

    // 4. Xử lý sự kiện gửi tin nhắn khi click nút gửi hoặc ấn phím Enter
    function executeSend() {
        const partnerId = document.getElementById("active-partner-id").value;
        const input = document.getElementById("chat-input");
        const msg = input.value.trim();

        if (msg !== "" && partnerId !== "") {
            // Gọi hàm SendMessage trong file ChatHub.cs bên backend
            connection.invoke("SendMessage", currentUserId, partnerId, msg).catch(function (err) {
                return console.error(err.toString());
            });
            input.value = ""; // Xóa trống khung nhập
        }
    }

    // Gán sự kiện click nút gửi và nhấn phím enter
    document.addEventListener("DOMContentLoaded", function() {
        const btnSend = document.getElementById("btn-send-chat");
        const chatInput = document.getElementById("chat-input");
        
        if(btnSend) btnSend.addEventListener("click", executeSend);
        if(chatInput) {
            chatInput.addEventListener("keypress", function(e) {
                if (e.key === "Enter") executeSend();
            });
        }
    });

    function toggleChat() {
        const chatWin = document.getElementById('chat-window');
        if(chatWin) {
            chatWin.style.display = (chatWin.style.display === 'flex') ? 'none' : 'flex';
        }
    }
</script>
</body>
</html>