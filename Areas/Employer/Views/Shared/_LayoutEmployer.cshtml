<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Employer Panel</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        :root { --sidebar-bg: #1a1d20; --primary-color: #0d6efd; }
        body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        
        /* Sidebar Styling */
        .sidebar { min-height: 100vh; background: var(--sidebar-bg); color: white; transition: all 0.3s; }
        .sidebar .nav-link { 
            color: #adb5bd; 
            padding: 12px 20px; 
            display: flex; 
            align-items: center; 
            border-radius: 0;
            transition: 0.2s;
        }
        .sidebar .nav-link:hover { background: #2c3136; color: white; }
        .sidebar .nav-link.active { 
            background: #2c3136; 
            color: white; 
            border-left: 4px solid var(--primary-color); 
        }
        .sidebar .nav-link i { font-size: 1.1rem; margin-right: 12px; }

        /* Main Content */
        .main-content { padding: 25px; }
        .top-navbar { 
            background: white; 
            padding: 15px 25px; 
            border-bottom: 1px solid #e0e0e0; 
            margin: -25px -25px 25px -25px; 
        }
        
        .card { border: none; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.04); }
        .btn-create-nav { margin: 15px 20px; text-align: left; }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-2 d-none d-md-block sidebar shadow-sm p-0">
                <div class="py-4 text-center border-bottom border-secondary mb-3">
                    <h4 class="text-primary fw-bold mb-0">JOB PORTAL</h4>
                    <small class="text-muted text-uppercase" style="letter-spacing: 1px;">Employer Center</small>
                </div>

                <div class="nav flex-column">
                    <a asp-area="Employer" asp-controller="Job" asp-action="Index" 
                    class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                        <i class="bi bi-grid-1x2"></i> Dashboard
                    </a>

                    <a asp-area="Employer" asp-controller="Job" asp-action="Create" 
                    class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")">
                        <i class="bi bi-plus-square"></i> Đăng tin mới
                    </a>

                    <a href="#" class="nav-link"><i class="bi bi-people"></i> Ứng viên</a>
                    <a href="#" class="nav-link"><i class="bi bi-chat-left-dots"></i> Tin nhắn</a>
                    <a href="#" class="nav-link"><i class="bi bi-building"></i> Hồ sơ công ty</a>
                </div>

                <div class="position-absolute bottom-0 w-100 pb-4 border-top border-secondary">
                    <a href="/" class="nav-link text-danger mt-3">
                        <i class="bi bi-box-arrow-left"></i> Quay lại trang chủ
                    </a>
                </div>
            </nav>

            <main class="col-md-10 ms-sm-auto main-content">
                <div class="top-navbar d-flex justify-content-between align-items-center">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item"><a href="#">Employer</a></li>
                            <li class="breadcrumb-item active">@ViewData["Title"]</li>
                        </ol>
                    </nav>
                    <div class="d-flex align-items-center">
                        <div class="text-end me-3">
                            <div class="fw-bold">HR Manager</div>
                            <small class="text-muted">Premium Account</small>
                        </div>
                        <img src="https://ui-avatars.com/api/?name=HR&background=0D6EFD&color=fff" class="rounded-circle shadow-sm" width="40">
                    </div>
                </div>

                @RenderBody()
            </main>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>