@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    // Biến an toàn để hiển thị
    var isAuth = User?.Identity?.IsAuthenticated ?? false;
    var username = UserManager.GetUserName(User) ?? User.Identity?.Name ?? "";
    if (!string.IsNullOrEmpty(username) && username.Contains("@"))
    {
        username = username.Split('@')[0];
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JOB-HUB - Kết nối sự nghiệp</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --primary-color: #0066ff;
            --chat-bg: #ffffff;
            --soft-bg: #f8fafc;
        }

        body {
            background-color: #f1f5f9;
            font-family: 'Inter', sans-serif;
            color: #1e293b;
        }

        /* 1. Navbar */
        .navbar {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 1px 15px rgba(0,0,0,0.05);
            padding: 12px 0;
        }

        .navbar-brand {
            font-size: 24px;
            letter-spacing: -1px;
        }

        /* Avatar Circle */
        .avatar-sm-circle {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, #0066ff, #0052cc);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
            border: 2px solid #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        /* Dropdown Menu Customization */
        .dropdown-menu {
            border-radius: 15px !important;
            border: none !important;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1) !important;
        }

        .dropdown-menu {
            z-index: 3000 !important;
        }

        .dropdown-item {
            padding: 10px 20px;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s;
        }

            .dropdown-item:hover {
                background-color: #f0f7ff;
                color: var(--primary-color);
                transform: translateX(5px);
            }

            .dropdown-item i {
                width: 25px;
                text-align: center;
                color: var(--primary-color);
            }

        /* 2. Hero Section */
        .hero-section {
            background: linear-gradient(rgba(0, 31, 77, 0.7), rgba(0, 10, 30, 0.85)), url('https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1350&q=80');
            background-size: cover;
            background-position: center;
            color: white;
            padding: 130px 0 100px;
            margin-bottom: -60px;
        }

        /* 3. Search Card */
        .search-card {
            border: none;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1) !important;
            padding: 12px !important;
        }

        .btn-search {
            background-color: var(--primary-color);
            border: none;
            border-radius: 12px;
            font-weight: 700;
        }

        /* 4. Chat Bubble (Messenger Style) */
        #chat-bubble {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 65px;
            height: 65px;
            background: var(--primary-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 28px;
            cursor: pointer;
            box-shadow: 0 10px 30px rgba(0,102,255,0.4);
            z-index: 1000;
        }

        #chat-window {
            position: fixed;
            bottom: 110px;
            right: 30px;
            width: 380px;
            height: 520px;
            background: white;
            border-radius: 28px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.2);
            display: none;
            flex-direction: column;
            z-index: 1000;
            overflow: hidden;
        }

        .chat-header {
            padding: 20px;
            font-weight: 800;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            justify-content: space-between;
        }

        .avatar-img {
            width: 50px;
            height: 50px;
            border-radius: 15px;
        }

        .online-dot {
            width: 12px;
            height: 12px;
            background: #10b981;
            border: 2px solid white;
            border-radius: 50%;
            position: absolute;
            bottom: 0;
            right: 0;
        }

        * Hiện danh sách con của Quản lý việc làm */
        .dropdown-submenu ul {
            display: block; /* Hiện mặc định */
            list-style: none;
            padding-left: 2.5rem !important; /* Đẩy vào trong cho đẹp */
        }

        .dropdown-submenu .dropdown-item {
            pointer-events: none; /* Để mục "Quản lý việc làm" không bị bấm nhầm */
            color: #000;
            font-weight: bold;
        }

        .navbar .container-fluid {
            overflow: visible !important;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-light sticky-top">
        <div class="container-fluid px-4">
            <!-- Logo nằm bên trái -->
            <a class="navbar-brand fw-bold text-primary" href="/">JOB<span class="text-dark">HUB</span></a>

            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item px-2"><a class="nav-link fw-semibold" href="#">Việc làm</a></li>
                    <li class="nav-item px-2"><a class="nav-link fw-semibold" href="#">Công ty</a></li>
                </ul>

                <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2">
                    <!-- Nút đăng tin -->
                    <a href="#" class="btn btn-outline-primary fw-bold px-4 rounded-3 border-2 order-2 order-lg-1">
                        Đăng tin tuyển dụng
                    </a>

                    <div class="d-flex align-items-center gap-1 order-1 order-lg-2 ms-lg-2">
                        @if (isAuth)
                        {
                            <div class="dropdown">
                                <a class="d-flex align-items-center text-decoration-none dropdown-toggle px-3 py-2 rounded-pill bg-light"
                                   href="#" role="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="avatar-sm-circle me-2">TA</div>
                                    <span class="fw-bold text-dark me-1">@username</span>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 mt-2 py-3" style="min-width: 280px;">
                                    <!-- Thông tin hồ sơ -->
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center" href="#">
                                            <i class="fa-regular fa-file-lines me-3 text-primary fs-5"></i>
                                            <span>Hồ sơ của tôi</span>
                                        </a>
                                    </li>

                                    <!-- Mục Tạo CV -->
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center" asp-area="Candidate" asp-controller="Home" asp-action="ManageCV">
                                            <i class="fa-solid fa-pen-ruler me-3 text-primary fs-5"></i>
                                            <span>Tạo CV</span>
                                        </a>
                                    </li>

                                    <!-- Quản lý việc làm với menu con -->
                                    <li class="dropdown-submenu">
                                        <div class="dropdown-item py-2 d-flex align-items-center justify-content-between" style="cursor: default; background: none;">
                                            <div class="d-flex align-items-center">
                                                <i class="fa-solid fa-briefcase me-3 text-primary fs-5"></i>
                                                <span class="fw-bold">Quản lý việc làm</span>
                                            </div>
                                        </div>
                                        <ul class="list-unstyled ps-5 pb-2">
                                            <li><a class="dropdown-item small py-1 text-muted" href="#">Việc làm đã ứng tuyển</a></li>
                                            <li><a class="dropdown-item small py-1 text-muted" href="#">Việc làm đã lưu</a></li>
                                            <li><a class="dropdown-item small py-1 text-muted" href="#">Việc làm chờ ứng tuyển</a></li>
                                            <li><a class="dropdown-item small py-1 text-muted" href="#">Nhà tuyển dụng xem hồ sơ</a></li>
                                        </ul>
                                    </li>

                                    <li><hr class="dropdown-divider mx-3"></li>

                                    <!-- Các tiện ích khác -->
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center" href="#">
                                            <i class="fa-regular fa-bell me-3 text-primary fs-5"></i>
                                            <span>Hỗ trợ và thông báo</span>
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center" href="#">
                                            <i class="fa-regular fa-circle-user me-3 text-primary fs-5"></i>
                                            <span>Quản lý tài khoản</span>
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider mx-3"></li>

                                    <!-- NÚT ĐĂNG XUẤT -->
                                    <li>
                                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" id="logoutForm">
                                            <button type="submit" class="dropdown-item py-2 d-flex align-items-center text-danger fw-bold border-0 bg-transparent w-100">
                                                <i class="fa-solid fa-power-off me-3 fs-5"></i>
                                                <span>Đăng xuất tài khoản</span>
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <!-- Hiện nút Đăng ký/Đăng nhập khi chưa vào hệ thống -->
                            <a class="nav-link px-3 fw-semibold text-secondary" asp-area="Identity" asp-page="/Account/Register">Đăng ký</a>
                            <a class="btn btn-primary fw-bold px-4 rounded-3 shadow-sm text-white" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Các phần Hero, Search và Chat giữ nguyên logic của bạn -->
    <header class="hero-section text-center">
        <div class="container">
            <h1 class="display-4 fw-bold mb-3">Tìm kiếm công việc mơ ước</h1>
            <p class="lead mb-5 opacity-75">Kết nối với hơn 50.000 doanh nghiệp hàng đầu</p>
        </div>
    </header>

    <div class="container position-relative" style="z-index: 10;">
        <div class="row justify-content-center">
            <div class="col-md-11 col-lg-10">
                <div class="card search-card p-3 shadow-sm">
                    <div class="row g-2">
                        <div class="col-md-5">
                            <div class="input-group h-100">
                                <span class="input-group-text bg-white border-end-0"><i class="fa fa-search text-muted"></i></span>
                                <input type="text" class="form-control form-control-lg border-start-0 ps-0 shadow-none" placeholder="Kỹ năng, vị trí công việc...">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <select class="form-select form-select-lg text-muted h-100 shadow-none">
                                <option selected disabled>Tất cả địa điểm</option>
                                <option>Hà Nội</option>
                                <option>TP. Hồ Chí Minh</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-primary btn-search w-100 h-100 text-white">Tìm việc ngay</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <main class="container py-5 mt-5">
        <h3 class="fw-bold mb-4">Việc làm mới nhất</h3>
        <!-- Danh sách việc làm sẽ đổ vào đây -->
    </main>

    <!-- Chat UI -->
    <div id="chat-window">
        <div class="chat-header">
            <span>Tin nhắn</span>
            <i class="fa-solid fa-xmark text-muted" style="cursor:pointer" onclick="toggleChat()"></i>
        </div>
        <div class="chat-list p-2">
            <div class="d-flex align-items-center p-3 hover-bg-light rounded-4" style="cursor: pointer; background: #f0f7ff;">
                <div class="position-relative me-3">
                    <img src="https://cdn-icons-png.flaticon.com/512/4712/4712035.png" class="avatar-img">
                    <span class="online-dot"></span>
                </div>
                <div>
                    <div class="fw-bold">Trợ lý AI (JobBot)</div>
                    <div class="small text-muted text-truncate" style="max-width: 200px;">Cần mình giúp chỉnh sửa CV không?</div>
                </div>
            </div>
        </div>
    </div>

    <div id="chat-bubble" onclick="toggleChat()">
        <i class="fa-solid fa-comment-dots"></i>
    </div>

    <div class="d-none d-md-block text-end pe-3 small">
        <span class="text-muted">isAuth=@isAuth</span>
        <span class="text-muted ms-2">user="@username"</span>
    </div>

  
    <script>
        function toggleChat() {
            const chatWin = document.getElementById('chat-window');
            chatWin.style.display = (chatWin.style.display === 'flex') ? 'none' : 'flex';
        }
    </script>
</body>
</html>