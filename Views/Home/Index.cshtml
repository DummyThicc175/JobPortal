@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Linq
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject JobPortal.Data.ApplicationDbContext DbContext

@{
    var isAuth = User?.Identity?.IsAuthenticated ?? false;
    var isAdmin = User.IsInRole("Admin"); // Kiểm tra nếu là Admin
    var isEmployer = User.IsInRole("Employer"); // Kiểm tra nếu là Employer
    // Khởi tạo các biến mặc định
    var fullName = "Ứng viên";
    var avatarUrl = "/images/default-avatar.png";

    if (isAuth)
    {
        // Lấy thông tin ứng viên từ Database dựa trên Email người dùng đang đăng nhập
        var userEmail = User.Identity.Name;
        var candidate = DbContext.Candidates.AsNoTracking().FirstOrDefault(c => c.Email == userEmail);

        if (candidate != null)
        {
            fullName = candidate.FullName ?? "Ứng viên"; 
            avatarUrl = candidate.AvatarUrl ?? "/images/default-avatar.png";
        }
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JOB-HUB - Kết nối sự nghiệp</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --primary-color: #0066ff;
            --chat-bg: #ffffff;
            --soft-bg: #f8fafc;
        }

        body {
            background-color: #f1f5f9;
            font-family: 'Inter', sans-serif;
            color: #1e293b;
        }

        /* 1. Navbar */
        .navbar {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 1px 15px rgba(0,0,0,0.05);
            padding: 12px 0;
        }

        .navbar-brand {
            font-size: 24px;
            letter-spacing: -1px;
        }

        /* Avatar Circle */
        .avatar-sm-circle {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, #0066ff, #0052cc);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
            border: 2px solid #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        
        /* Hiệu ứng di chuột nổi card */
        .job-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 10px 25px rgba(0, 102, 255, 0.15) !important;
            border-color: rgba(0, 102, 255, 0.2) !important;
        }

        /* Màu tiêu đề khi hover */
        .hover-blue:hover {
            color: #0066ff !important;
        }

        /* Tinh chỉnh badge cho chuyên nghiệp */
        .badge.bg-light {
            font-weight: 600;
            color: #64748b !important; /* Màu xám hiện đại */
        }

        .badge.text-primary {
            color: #0066ff !important; /* Màu xanh thương hiệu */
        }

        /* Đảm bảo các card có chiều cao bằng nhau trong một hàng */
        .row.g-4 {
            display: flex;
            flex-wrap: wrap;
        }


        /* Dropdown Menu Customization */
        .dropdown-menu {
            border-radius: 15px !important;
            border: none !important;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1) !important;
        }

        .dropdown-menu {
            z-index: 3000 !important;
        }

        .dropdown-item {
            padding: 10px 20px;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s;
        }

            .dropdown-item:hover {
                background-color: #f0f7ff;
                color: var(--primary-color);
                transform: translateX(5px);
            }

            .dropdown-item i {
                width: 25px;
                text-align: center;
                color: var(--primary-color);
            }
        /* Style cho các mục con trong menu */
        .submenu-item {
            padding-left: 48px !important; /* Tạo độ lùi giống layoutcv  */
            font-size: 0.9rem !important; /* Chữ nhỏ hơn một chút  */
            color: #64748b !important; /* Màu xám hiện đại  */
        }

            .submenu-item:hover {
                color: #4460ef !important; /* Màu xanh khi di chuột vào */
                background-color: #f1f5f9 !important;
            }

        /* Đảm bảo dropdown item chính có khoảng cách đẹp [cite: 122] */
        .dropdown-item {
            padding: 10px 16px;
            border-radius: 8px;
        }
        /* 2. Hero Section */
        .hero-section {
            background: linear-gradient(rgba(0, 31, 77, 0.7), rgba(0, 10, 30, 0.85)), url('https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1350&q=80');
            background-size: cover;
            background-position: center;
            color: white;
            padding: 130px 0 100px;
            margin-bottom: -60px;
        }

        /* 3. Search Card */
        .search-card {
            border: none;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1) !important;
            padding: 12px !important;
        }

        .btn-search {
            background-color: var(--primary-color);
            border: none;
            border-radius: 12px;
            font-weight: 700;
        }

        /* 4. Chat Bubble (Messenger Style) */
        #chat-bubble {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 65px;
            height: 65px;
            background: var(--primary-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 28px;
            cursor: pointer;
            box-shadow: 0 10px 30px rgba(0,102,255,0.4);
            z-index: 1000;
        }

        #chat-window {
            position: fixed;
            bottom: 110px;
            right: 30px;
            width: 380px;
            height: 520px;
            background: white;
            border-radius: 28px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.2);
            display: none;
            flex-direction: column;
            z-index: 1000;
            overflow: hidden;
        }

        .chat-header {
            padding: 20px;
            font-weight: 800;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            justify-content: space-between;
        }

        .avatar-img {
            width: 50px;
            height: 50px;
            border-radius: 15px;
        }

        .online-dot {
            width: 12px;
            height: 12px;
            background: #10b981;
            border: 2px solid white;
            border-radius: 50%;
            position: absolute;
            bottom: 0;
            right: 0;
        }

        * Hiện danh sách con của Quản lý việc làm */
        .dropdown-submenu ul {
            display: block; /* Hiện mặc định */
            list-style: none;
            padding-left: 2.5rem !important; /* Đẩy vào trong cho đẹp */
        }

        .dropdown-submenu .dropdown-item {
            pointer-events: none; /* Để mục "Quản lý việc làm" không bị bấm nhầm */
            color: #000;
            font-weight: bold;
        }

        .navbar .container-fluid {
            overflow: visible !important;
        }
        /* Hiệu ứng hover cho thẻ việc làm */
        .job-card-hover {
            transition: all 0.3s ease;
            border: 1px solid transparent !important;
        }

            .job-card-hover:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 25px rgba(0, 102, 255, 0.1) !important;
                border-color: rgba(0, 102, 255, 0.2) !important;
            }

        /* Căn chỉnh logo cho đồng nhất */
        .company-logo-wrapper {
            min-width: 55px;
            height: 55px;
        }

        /* Kiểu chữ tiêu đề việc làm */
        .job-card-hover h6 {
            line-height: 1.4;
            font-size: 1.05rem;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-light sticky-top">
        <div class="container-fluid px-4">
            <!-- Logo nằm bên trái -->
            <a class="navbar-brand fw-bold text-primary" href="/">JOB<span class="text-dark">HUB</span></a>

            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>



            <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2">
                @if (isAuth)
                {
                    @if (isAdmin)
                    {
                        <a href="https://localhost:7294/admin/dashboard" class="btn btn-dark fw-bold px-4 rounded-3 border-2 order-2 order-lg-1">
                            <i class="fa-solid fa-gauge-high me-2"></i> Quản lý trang web
                        </a>
                    }
                    else if (isEmployer)
                    {
                        <a href="https://localhost:7294/Employer/Job" class="btn btn-outline-primary fw-bold px-4 rounded-3 border-2 order-2 order-lg-1">
                            Đăng tin tuyển dụng
                        </a>
                    }
                    @* Nếu là Ứng viên (Candidate), không có thẻ <a> nào được render ở đây, nút sẽ biến mất *@
                }
                else
                {
                   
                }

                    <div class="d-flex align-items-center gap-1 order-1 order-lg-2 ms-lg-2">
                        @if (isAuth)
                        {
                            <div class="dropdown">
                                <a class="d-flex align-items-center text-decoration-none dropdown-toggle px-3 py-2 rounded-pill bg-light"
                                   href="#" role="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">

                                    @* Hiển thị ảnh đại diện thực tế *@
                                    <div class="me-2">
                                        <img src="@avatarUrl" class="rounded-circle border" width="35" height="35" style="object-fit: cover;">
                                    </div>

                                    @* Hiển thị tên đầy đủ *@
                                    <span class="fw-bold text-dark me-1">@fullName</span>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 mt-2 py-3" style="min-width: 280px;">
                                    <li>
                                        <a class="dropdown-item" href="/Candidate/Profile/Index">
                                            <i class="fa-regular fa-circle-user text-primary me-2"></i> Hồ sơ của tôi
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item submenu-item" asp-area="Candidate" asp-controller="Profile" asp-action="AppliedJobs">
                                            • Việc làm đã ứng tuyển
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item submenu-item" asp-area="Candidate" asp-controller="Profile" asp-action="SavedJobs">
                                            • Việc làm đã lưu
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider mx-3"></li>

                                    <li>
                                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                                            <button type="submit" class="dropdown-item text-danger fw-bold border-0 bg-transparent w-100 text-start">
                                                <i class="fa-solid fa-power-off me-2"></i> Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <!-- Hiện nút Đăng ký/Đăng nhập khi chưa vào hệ thống -->
                            <a class="nav-link px-3 fw-semibold text-secondary" asp-area="Identity" asp-page="/Account/Register">Đăng ký</a>
                            <a class="btn btn-primary fw-bold px-4 rounded-3 shadow-sm text-white" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Các phần Hero, Search và Chat giữ nguyên logic của bạn -->
    <header class="hero-section text-center">
        <div class="container">
            <h1 class="display-4 fw-bold mb-3">Tìm kiếm công việc mơ ước</h1>
            <p class="lead mb-5 opacity-75">Kết nối với hơn 50.000 doanh nghiệp hàng đầu</p>
        </div>
    </header>

    <div class="container position-relative" style="z-index: 10; margin-top: -45px;">
        <div class="row justify-content-center">
            <div class="col-md-11 col-lg-10">
                <div class="card search-card p-3 shadow-sm border-0" style="border-radius: 20px;">
                    <form asp-controller="Job" asp-action="Index" method="get">
                        <div class="row g-2">
                            <div class="col-md-5">
                                <div class="input-group h-100">
                                    <span class="input-group-text bg-transparent border-0"><i class="fa fa-search text-muted"></i></span>
                                    <input type="text" name="keyword" value="@ViewBag.Keyword"
                                           class="form-control border-0 shadow-none"
                                           placeholder="Kỹ năng, vị trí công việc...">
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="input-group h-100 border-start">
                                    <span class="input-group-text bg-transparent border-0">
                                        <i class="fa-solid fa-location-dot text-muted"></i>
                                    </span>
                                    <select name="locationId" class="form-select border-0 shadow-none">
                                        <option value="">Tất cả địa điểm</option>
                                        @if (ViewBag.Locations != null)
                                        {
                                            var locationList = ViewBag.Locations as IEnumerable<JobPortal.Models.Location>;
                                            if (locationList != null)
                                            {
                                                foreach (var loc in locationList)
                                                {
                                                    <option value="@loc.Id" selected="@(ViewBag.SelectedLocation != null && (int)ViewBag.SelectedLocation == loc.Id)">
                                                        @loc.Name
                                                    </option>
                                                }
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <button type="submit" class="btn btn-primary w-100 h-100 fw-bold rounded-3 shadow-sm" style="background-color: #0066ff;">
                                    Tìm việc ngay
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <main class="container py-5 mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold mb-0">Việc làm mới nhất</h3>
            <a asp-controller="Job" asp-action="Index" class="text-primary text-decoration-none fw-semibold">
                Xem tất cả <i class="fa fa-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card job-card h-100 bg-white shadow-sm border-0 position-relative" style="border-radius: 12px; transition: 0.3s;">
                        @* Đường kẻ trang trí phía trên cho card thêm chuyên nghiệp *@
                        <div class="position-absolute top-0 start-0 end-0 bg-primary" style="height: 3px; border-radius: 12px 12px 0 0;"></div>

                        <div class="card-body p-4 d-flex flex-column">
                            @* Tiêu đề và nút Lưu *@
                            <div class="d-flex justify-content-between mb-2">
                                <h5 class="fw-bold text-dark mb-0 text-truncate" style="max-width: 85%;">
                                    <a asp-area="Candidate" asp-controller="Job" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark hover-blue">
                                        @item.Title
                                    </a>
                                </h5>
                                <i class="fa-regular fa-heart text-muted" style="cursor: pointer;"></i>
                            </div>

                            @* Tên công ty *@
                            <div class="mb-3">
                                <p class="text-secondary small mb-1 text-truncate">
                                    <i class="fa-solid fa-building me-1 opacity-50"></i> @(item.CompanyName ?? "Công ty ẩn danh")
                                </p>
                                @* Thêm Category ở đây *@
                                <p class="text-muted mb-0" style="font-size: 0.8rem;">
                                    <i class="fa-solid fa-layer-group me-1 opacity-50"></i>
                                    <span class="text-primary fw-medium">@(item.CategoryName ?? item.Category?.Name ?? "Chưa phân loại")</span>
                                </p>
                            </div>

                            @* Lương và Địa điểm - Dạng Badge gọn *@
                            <div class="d-flex flex-wrap gap-2 mb-4">
                                <span class="badge rounded-pill bg-light text-primary border px-3 py-2">
                                    <i class="fa-solid fa-circle-dollar-to-slot me-1"></i> @item.SalaryRange
                                </span>
                                <span class="badge rounded-pill bg-light text-secondary border px-3 py-2">
                                    <i class="fa-solid fa-location-dot me-1"></i> @(item.JobLocation?.Name ?? "Toàn quốc")
                                </span>
                            </div>

                            @* Footer card: Ngày và Nút ứng tuyển *@
                            <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                <small class="text-muted" style="font-size: 0.75rem;">
                                    <i class="far fa-clock me-1"></i> @item.CreatedAt.ToString("dd/MM/yyyy")
                                </small>
                                <a asp-controller="Home" asp-action="JobDetails" asp-route-id="@item.Id" class="btn btn-primary rounded-pill px-4 fw-bold">
                                    Ứng tuyển
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </main>

    <!-- Chat UI -->
    <div id="chat-window">
        <div class="chat-header">
            <span>Tin nhắn</span>
            <i class="fa-solid fa-xmark text-muted" style="cursor:pointer" onclick="toggleChat()"></i>
        </div>
        <div class="chat-list p-2">
            <div class="d-flex align-items-center p-3 hover-bg-light rounded-4" style="cursor: pointer; background: #f0f7ff;">
                <div class="position-relative me-3">
                    <img src="https://cdn-icons-png.flaticon.com/512/4712/4712035.png" class="avatar-img">
                    <span class="online-dot"></span>
                </div>
                <div>
                    <div class="fw-bold">Trợ lý AI (JobBot)</div>
                    <div class="small text-muted text-truncate" style="max-width: 200px;">Cần mình giúp chỉnh sửa CV không?</div>
                </div>
            </div>
        </div>
    </div>

    <div id="chat-bubble" onclick="toggleChat()">
        <i class="fa-solid fa-comment-dots"></i>
    </div>

 

  
    <script>
        function toggleChat() {
            const chatWin = document.getElementById('chat-window');
            chatWin.style.display = (chatWin.style.display === 'flex') ? 'none' : 'flex';
        }
    </script>
</body>
</html>