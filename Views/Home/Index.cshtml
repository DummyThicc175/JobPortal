@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Linq
@using System.Security.Claims
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject JobPortal.Data.ApplicationDbContext DbContext

@{
    var isAuth = User?.Identity?.IsAuthenticated ?? false;
    var isAdmin = User.IsInRole("Admin"); // Kiểm tra nếu là Admin
    var isEmployer = User.IsInRole("Employer"); // Kiểm tra nếu là Employer
    // Khởi tạo các biến mặc định
    var fullName = isEmployer ? "Nhà Tuyển Dụng" : (isAdmin ? "Quản trị viên" : "Ứng viên");
    var avatarUrl = "/images/default-avatar.png";
   

    if (isAuth)
    {
        // Lấy thông tin ứng viên từ Database dựa trên Email người dùng đang đăng nhập
        var userEmail = User.Identity.Name;
        var candidate = DbContext.Candidates.AsNoTracking().FirstOrDefault(c => c.Email == userEmail);

        if (candidate != null)
        {
            fullName = candidate.FullName ?? "Ứng viên"; 
            avatarUrl = candidate.AvatarUrl ?? "/images/default-avatar.png";
        }
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JOB-HUB - Kết nối sự nghiệp</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --primary-color: #0066ff;
            --chat-bg: #ffffff;
            --soft-bg: #f8fafc;
        }

        body {
            background-color: #f1f5f9;
            font-family: 'Inter', sans-serif;
            color: #1e293b;
        }

        /* 1. Navbar */
        .navbar {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 1px 15px rgba(0,0,0,0.05);
            padding: 12px 0;
        }

        .navbar-brand {
            font-size: 24px;
            letter-spacing: -1px;
        }

        /* Avatar Circle */
        .avatar-sm-circle {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, #0066ff, #0052cc);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
            border: 2px solid #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        
        /* Hiệu ứng di chuột nổi card */
        .job-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 10px 25px rgba(0, 102, 255, 0.15) !important;
            border-color: rgba(0, 102, 255, 0.2) !important;
        }

        /* Màu tiêu đề khi hover */
        .hover-blue:hover {
            color: #0066ff !important;
        }

        /* Tinh chỉnh badge cho chuyên nghiệp */
        .badge.bg-light {
            font-weight: 600;
            color: #64748b !important; /* Màu xám hiện đại */
        }

        .badge.text-primary {
            color: #0066ff !important; /* Màu xanh thương hiệu */
        }

        /* Đảm bảo các card có chiều cao bằng nhau trong một hàng */
        .row.g-4 {
            display: flex;
            flex-wrap: wrap;
        }


        /* Dropdown Menu Customization */
        .dropdown-menu {
            border-radius: 15px !important;
            border: none !important;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1) !important;
        }

        .dropdown-menu {
            z-index: 3000 !important;
        }

        .dropdown-item {
            padding: 10px 20px;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s;
        }

            .dropdown-item:hover {
                background-color: #f0f7ff;
                color: var(--primary-color);
                transform: translateX(5px);
            }

            .dropdown-item i {
                width: 25px;
                text-align: center;
                color: var(--primary-color);
            }
        /* Style cho các mục con trong menu */
        .submenu-item {
            padding-left: 48px !important; /* Tạo độ lùi giống layoutcv  */
            font-size: 0.9rem !important; /* Chữ nhỏ hơn một chút  */
            color: #64748b !important; /* Màu xám hiện đại  */
        }

            .submenu-item:hover {
                color: #4460ef !important; /* Màu xanh khi di chuột vào */
                background-color: #f1f5f9 !important;
            }

        /* Đảm bảo dropdown item chính có khoảng cách đẹp */
        .dropdown-item {
            padding: 10px 16px;
            border-radius: 8px;
        }
        /* 2. Hero Section */
        .hero-section {
            background: linear-gradient(rgba(0, 31, 77, 0.7), rgba(0, 10, 30, 0.85)), url('https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1350&q=80');
            background-size: cover;
            background-position: center;
            color: white;
            padding: 130px 0 100px;
            margin-bottom: -60px;
        }

        /* 3. Search Card */
        .search-card {
            border: none;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1) !important;
            padding: 12px !important;
        }

        .btn-search {
            background-color: var(--primary-color);
            border: none;
            border-radius: 12px;
            font-weight: 700;
        }

        /* 4. Chat Bubble (Messenger Style) */
        #chat-bubble {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 65px;
            height: 65px;
            background: var(--primary-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 28px;
            cursor: pointer;
            box-shadow: 0 10px 30px rgba(0,102,255,0.4);
            z-index: 1000;
        }

        /* Thêm hiệu ứng hover cho phần danh sách chat đối tác */
        .partner-item {
            transition: background 0.2s ease;
        }
        .partner-item:hover {
            background: #f1f5f9 !important;
        }
        .partner-item.active {
            background: #e0f2fe !important;
            border-left: 4px solid #0066ff !important;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-light sticky-top">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold text-primary" href="/">JOB<span class="text-dark">HUB</span></a>

            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2">
                @if (isAuth)
                {
                    @if (isAdmin)
                    {
                        <a class="btn btn-primary fw-bold px-4 rounded-3 shadow-sm text-white" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <i class="fa-solid fa-gauge me-2"></i>Quản lý hệ thống
                        </a>
                    }
                    else if (isEmployer)
                    {
                        <a asp-area="Employer" asp-controller="Job" asp-action="Create" class="btn btn-outline-primary fw-bold px-4 rounded-3 border-2 order-2 order-lg-1">
                            <i class="fa-solid fa-pen-to-square me-2"></i>Đăng tin tuyển dụng
                        </a>
                    }
                    else
                    {
                        <a asp-area="Candidate" asp-controller="Profile" asp-action="SelectTemplate" class="btn btn-success fw-bold px-4 rounded-3 shadow-sm text-white order-2 order-lg-1" style="background-color: #2ec4b6; border-color: #2ec4b6;">
                            <i class="fa-solid fa-magic text-white me-2"></i>Tạo CV Online
                        </a>
                    }
                }

                <div class="d-flex align-items-center gap-1 order-1 order-lg-2 ms-lg-2">
                    @if (isAuth)
                    {
                        <div class="dropdown">
                            <a class="d-flex align-items-center text-decoration-none dropdown-toggle px-3 py-2 rounded-pill bg-light"
                               href="#" role="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="me-2">
                                    <img src="@avatarUrl" class="rounded-circle border" width="35" height="35" style="object-fit: cover;">
                                </div>
                                <span class="fw-bold text-dark me-1">@fullName</span>
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 mt-2 py-3" style="min-width: 280px;">
                                <li>
                                    <a class="dropdown-item" href="/Candidate/Profile/Index">
                                        <i class="fa-regular fa-circle-user text-primary me-2"></i> Hồ sơ của tôi
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item submenu-item" asp-area="Candidate" asp-controller="Profile" asp-action="AppliedJobs">
                                        • Việc làm đã ứng tuyển
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item submenu-item" asp-area="Candidate" asp-controller="Profile" asp-action="SavedJobs">
                                        • Việc làm đã lưu
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider mx-3"></li>
                                <li>
                                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                                        <button type="submit" class="dropdown-item text-danger fw-bold border-0 bg-transparent w-100 text-start">
                                            <i class="fa-solid fa-power-off me-2"></i> Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="nav-link px-3 fw-semibold text-secondary" asp-area="Identity" asp-page="/Account/Register">Đăng ký</a>
                        <a class="btn btn-primary fw-bold px-4 rounded-3 shadow-sm text-white" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <header class="hero-section text-center">
        <div class="container">
            <h1 class="display-4 fw-bold mb-3">Tìm kiếm công việc mơ ước</h1>
            <p class="lead mb-5 opacity-75">Kết nối với hơn 50.000 doanh nghiệp hàng đầu</p>
        </div>
    </header>

    <div class="container position-relative" style="z-index: 10; margin-top: -45px;">
        <div class="row justify-content-center">
            <div class="col-md-11 col-lg-10">
                <div class="card search-card p-3 shadow-sm border-0" style="border-radius: 20px;">
                    <form asp-controller="Job" asp-action="Search" method="get">
                        <div class="row g-2 align-items-center">

                            <div class="col-md-5">
                                <div class="input-group h-100">
                                    <span class="input-group-text bg-transparent border-0">
                                        <i class="fa fa-search text-muted"></i>
                                    </span>
                                    <input type="text" name="searchString" value="@ViewBag.Keyword" class="form-control border-0 shadow-none" placeholder="Kỹ năng, vị trí công việc...">
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="input-group h-100 border-start">
                                    <span class="input-group-text bg-transparent border-0">
                                        <i class="fa-solid fa-location-dot text-muted"></i>
                                    </span>
                                    <select name="locationId" class="form-select border-0 shadow-none" asp-items="ViewBag.Locations">
                                        <option value="">-- Tất cả địa điểm --</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <button type="submit" class="btn btn-primary w-100 fw-bold rounded-3 shadow-sm" style="background-color: #0066ff; height: 45px;">
                                    Tìm việc ngay
                                </button>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <main class="container py-5 mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold mb-0">Việc làm mới nhất</h3>
            <a asp-controller="Job" asp-action="Index" class="text-primary text-decoration-none fw-semibold">
                Xem tất cả <i class="fa fa-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card job-card h-100 bg-white shadow-sm border-0 position-relative" style="border-radius: 12px; transition: 0.3s;">
                        <div class="position-absolute top-0 start-0 end-0 bg-primary" style="height: 3px; border-radius: 12px 12px 0 0;"></div>
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between mb-2">
                                <h5 class="fw-bold text-dark mb-0 text-truncate" style="max-width: 85%;">
                                    <a asp-area="Candidate" asp-controller="Job" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark hover-blue">
                                        @item.Title
                                    </a>
                                </h5>
                                <i class="fa-regular fa-heart text-muted" style="cursor: pointer;"></i>
                            </div>
                            <div class="mb-3">
                                <p class="text-secondary small mb-1 text-truncate">
                                    <i class="fa-solid fa-building me-1 opacity-50"></i> @(item.CompanyName ?? "Công ty ẩn danh")
                                </p>
                                <p class="text-muted mb-0" style="font-size: 0.8rem;">
                                    <i class="fa-solid fa-layer-group me-1 opacity-50"></i>
                                    <span class="text-primary fw-medium">@(item.CategoryName ?? item.Category?.Name ?? "Chưa phân loại")</span>
                                </p>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mb-4">
                                <span class="badge rounded-pill bg-light text-primary border px-3 py-2">
                                    <i class="fa-solid fa-circle-dollar-to-slot me-1"></i> @item.SalaryRange
                                </span>
                                <span class="badge rounded-pill bg-light text-secondary border px-3 py-2">
                                    <i class="fa-solid fa-location-dot me-1"></i> @(item.JobLocation?.Name ?? "Toàn quốc")
                                </span>
                            </div>
                            <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                <small class="text-muted" style="font-size: 0.75rem;">
                                    <i class="far fa-clock me-1"></i> @item.CreatedAt.ToString("dd/MM/yyyy")
                                </small>
                                @if (isAuth)
                                {
                                    <a asp-controller="Home" asp-action="JobDetails" asp-route-id="@item.Id" class="btn btn-primary rounded-pill px-4 fw-bold">
                                        Ứng tuyển
                                    </a>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-secondary rounded-pill px-4 fw-bold" disabled title="Vui lòng đăng nhập để ứng tuyển">
                                        Ứng tuyển
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </main>

    @if (isAuth && !isAdmin && !isEmployer)
    {
        <div id="chat-window" style="display: none; position: fixed; bottom: 110px; right: 30px; width: 650px; height: 520px; background: white; border-radius: 24px; box-shadow: 0 20px 60px rgba(0,0,0,0.2); z-index: 3000; overflow: hidden; font-family: 'Inter', sans-serif;">
            
            <div id="chat-sidebar" style="width: 240px; background: #f8fafc; border-right: 1px solid #e2e8f0; display: flex; flex-direction: column;">
                <div style="padding: 20px; font-weight: 700; border-bottom: 1px solid #e2e8f0; background: #0066ff; color: white;">
                    Tin nhắn tuyển dụng
                </div>
                <div id="partner-list" style="flex: 1; overflow-y: auto; padding: 10px 0;">
                    <div style="padding: 20px; text-align: center; color: #64748b; font-size: 13px;">Chưa có hội thoại</div>
                </div>
            </div>

            <div id="chat-content-area" style="flex: 1; display: flex; flex-direction: column;">
                <div class="chat-header" style="padding: 18px 20px; font-weight: 800; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; background: #ffffff; color: #1e293b;">
                    <span id="chat-partner-name" style="font-size: 16px;">Chọn một nhà tuyển dụng</span>
                    <i class="fa-solid fa-xmark" style="cursor: pointer; font-size: 18px; color: #64748b;" onclick="toggleChat()"></i>
                </div>
                
                <div id="chat-body" style="flex: 1; padding: 15px; overflow-y: auto; background: #f1f5f9; display: flex; flex-direction: column; gap: 10px;">
                    <div style="align-self: center; background: #fff; padding: 10px 15px; border-radius: 20px; font-size: 13px; color: #64748b; box-shadow: 0 2px 5px rgba(0,0,0,0.05); margin-top: auto; margin-bottom: auto;">
                        Hãy chọn một người từ danh sách bên trái để bắt đầu nhắn tin.
                    </div>
                </div>

                <div class="chat-footer" style="padding: 15px; border-top: 1px solid #f1f5f9; display: flex; align-items: center; gap: 10px; background: white;">
                    <input type="text" id="chat-input" class="form-control" placeholder="Nhập tin nhắn..." disabled style="border-radius: 20px; border: 1px solid #cbd5e1; padding-left: 15px; height: 40px; flex: 1;">
                    <button id="btn-send-chat" disabled class="btn btn-primary" style="border-radius: 50%; width: 40px; height: 40px; padding: 0; display: flex; align-items: center; justify-content: center; background-color: #0066ff; border: none;">
                        <i class="fa-solid fa-paper-plane" style="color: white; font-size: 15px; margin-left: 2px;"></i>
                    </button>
                </div>
            </div>
        </div>

        <input type="hidden" id="current-user-id" value="@User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier)" />
        <input type="hidden" id="active-partner-id" value="" />

        <div id="chat-bubble" onclick="toggleChat()">
            <i class="fa-solid fa-comment-dots"></i>
        </div>

        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
        <script>
            function toggleChat() {
                const chatWin = document.getElementById('chat-window');
                if(chatWin) {
                    const isOpening = chatWin.style.display === 'none' || chatWin.style.display === '';
                    chatWin.style.display = isOpening ? 'flex' : 'none';
                    if(isOpening) {
                        loadChatPartners();
                    }
                }
            }

            const chatConnection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .build();

            const currentUserId = document.getElementById("current-user-id").value;

            function appendMessage(text, isMe, time) {
                const chatBody = document.getElementById("chat-body");
                if(!chatBody) return;
                
                const msgDiv = document.createElement("div");
                msgDiv.style.padding = "10px 15px";
                msgDiv.style.borderRadius = "15px";
                msgDiv.style.maxWidth = "75%";
                msgDiv.style.fontSize = "14px";

                if (isMe) {
                    msgDiv.style.alignSelf = "flex-end";
                    msgDiv.style.background = "#0066ff";
                    msgDiv.style.color = "white";
                } else {
                    msgDiv.style.alignSelf = "flex-start";
                    msgDiv.style.background = "#e2e8f0";
                    msgDiv.style.color = "#1e293b";
                }

                msgDiv.innerHTML = `<div>${text}</div><small style="font-size: 10px; opacity: 0.6; display: block; text-align: right; margin-top: 2px;">${time}</small>`;
                chatBody.appendChild(msgDiv);
                chatBody.scrollTop = chatBody.scrollHeight;
            }

            function loadChatPartners() {
                if(!currentUserId) return;
                
                const partnerList = document.getElementById("partner-list");
                if (!partnerList) return;

                // Gọi API vừa viết ở ChatController để lấy những người từng nhắn tin
                fetch('/Chat/GetChatPartners')
                    .then(res => res.json())
                    .then(partners => {
                        if (partners.length > 0) {
                            partnerList.innerHTML = ""; // Xóa dòng chữ "Chưa có hội thoại"
                            partners.forEach(p => {
                                addPartnerToSidebar(p.id, p.name);
                            });
                        }
                    })
                    .catch(err => console.error("Lỗi khi tải danh sách người chat:", err));
            }

            function openPartnerChat(partnerId, partnerName) {
                document.getElementById("active-partner-id").value = partnerId;
                document.getElementById("chat-partner-name").innerText = partnerName;
                
                document.getElementById("chat-input").removeAttribute("disabled");
                document.getElementById("btn-send-chat").removeAttribute("disabled");

                const chatBody = document.getElementById("chat-body");
                chatBody.innerHTML = "";

                fetch(`/Chat/GetChatHistory?partnerId=${partnerId}`)
                    .then(res => res.json())
                    .then(messages => {
                        messages.forEach(m => {
                            appendMessage(m.content, m.isMe, m.time);
                        });
                    });

                document.querySelectorAll('.partner-item').forEach(item => item.classList.remove('active'));
                const clickedItem = document.getElementById(`partner-${partnerId}`);
                if(clickedItem) clickedItem.classList.add('active');
            }

            function addPartnerToSidebar(id, name) {
                const partnerList = document.getElementById("partner-list");
                if (!partnerList) return;

                if (partnerList.innerHTML.includes("Chưa có hội thoại")) {
                    partnerList.innerHTML = "";
                }

                if (!document.getElementById(`partner-${id}`)) {
                    const item = document.createElement("div");
                    item.id = `partner-${id}`;
                    item.className = "partner-item";
                    item.style = "padding: 12px 15px; border-bottom: 1px solid #e2e8f0; cursor: pointer; display: flex; align-items: center; gap: 10px; background: #fff;";
                    item.innerHTML = `
                        <div style="width: 35px; height: 35px; border-radius: 50%; background: #0066ff; color: white; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 13px;">
                            ${name.charAt(0).toUpperCase()}
                        </div>
                        <div style="flex: 1; min-width: 0;">
                            <div style="font-weight: 600; font-size: 14px; color: #1e293b; text-truncate">${name}</div>
                            <small style="color: #64748b; font-size: 11px;">Nhà tuyển dụng</small>
                        </div>
                    `;
                    item.onclick = () => openPartnerChat(id, name);
                    partnerList.appendChild(item);
                }
            }

            chatConnection.on("ReceiveMessage", function (senderId, receiverId, message, time) {
                const activePartnerId = document.getElementById("active-partner-id").value;

                // Tự động quét lại hoặc thêm đối tác vào danh sách bên trái khi có tin nhắn mới đến
                if (receiverId === currentUserId || senderId === currentUserId) {
                    loadChatPartners(); 
                }

                // Nếu ứng viên đang mở đúng khung chat của người vừa nhắn tới
                if ((senderId === currentUserId && receiverId === activePartnerId) || 
                    (senderId === activePartnerId && receiverId === currentUserId)) {
                    appendMessage(message, senderId === currentUserId, time);
                } 
                // Nếu ứng viên đang online nhưng chưa chọn ai, tự động bật khung chat lên cho họ biết
                else if (receiverId === currentUserId && activePartnerId === "") {
                    document.getElementById("chat-window").style.display = "flex";
                    loadChatPartners();
                }
            });

            function executeSend() {
                const partnerId = document.getElementById("active-partner-id").value;
                const input = document.getElementById("chat-input");
                const msg = input.value.trim();

                if (msg !== "" && partnerId !== "") {
                    chatConnection.invoke("SendMessage", currentUserId, partnerId, msg).catch(function (err) {
                        return console.error(err.toString());
                    });
                    input.value = "";
                }
            }

            chatConnection.start().then(function () {
                console.log("Ứng viên kết nối Hub thành công!");
                loadChatPartners();
            }).catch(function (err) {
                return console.error(err.toString());
            });

            document.addEventListener("DOMContentLoaded", function() {
                const btnSend = document.getElementById("btn-send-chat");
                const chatInput = document.getElementById("chat-input");
                
                if(btnSend) btnSend.addEventListener("click", executeSend);
                if(chatInput) {
                    chatInput.addEventListener("keypress", function(e) {
                        if (e.key === "Enter") executeSend();
                    });
                }
            });
        </script>
    }
</body>
</html>