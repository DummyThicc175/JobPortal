@using Microsoft.CodeAnalysis.Differencing
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JOB-HUB - Kết nối sự nghiệp</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --primary-color: #0066ff;
            --chat-bg: #ffffff;
            --soft-bg: #f8fafc;
        }

        body { 
            background-color: #f1f5f9; 
            font-family: 'Inter', sans-serif; 
            color: #1e293b;
        }

        /* 1. Navbar Tinh Tế (Giữ nguyên gốc) */
        .navbar { 
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 1px 15px rgba(0,0,0,0.05); 
            padding: 15px 0;
        }
        .navbar-brand { font-size: 24px; letter-spacing: -1px; }

        /* 2. Hero Section (Giữ nguyên gốc) */
        .hero-section { 
            background: linear-gradient(rgba(0, 31, 77, 0.7), rgba(0, 10, 30, 0.85)), 
                        url('https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1350&q=80'); 
            background-size: cover; 
            background-position: center;
            color: white; 
            padding: 130px 0 100px;
            margin-bottom: -60px;
        }

        /* 3. Card Tìm Kiếm */
        .search-card {
            border: none;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1) !important;
            padding: 12px !important;
        }
        .btn-search {
            background-color: var(--primary-color);
            border: none;
            border-radius: 12px;
            font-weight: 700;
            transition: all 0.3s ease;
        }

        /* 4. Thẻ Việc Làm */
        .job-card {
            border-radius: 24px;
            border: 1px solid #edf2f7 !important;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            background: white;
        }
        .job-card:hover {
            transform: scale(1.02);
            box-shadow: 0 15px 35px rgba(0,0,0,0.07) !important;
            border-color: var(--primary-color) !important;
        }
        .job-badge {
            background-color: #eef5ff;
            color: var(--primary-color);
            font-weight: 700;
            padding: 6px 14px;
            border-radius: 10px;
            font-size: 0.8rem;
        }

        /* 5. PHẦN CHAT ĐÃ ĐƯỢC THAY THẾ (MESSENGER STYLE) */
        #chat-bubble {
            position: fixed; bottom: 30px; right: 30px;
            width: 65px; height: 65px; background: var(--primary-color);
            border-radius: 50%; display: flex; align-items: center;
            justify-content: center; color: white; font-size: 28px;
            cursor: pointer; box-shadow: 0 10px 30px rgba(0,102,255,0.4);
            z-index: 1000; transition: 0.3s ease;
        }
        #chat-bubble:hover { transform: scale(1.1); }

        #chat-window {
            position: fixed;
            bottom: 110px;
            right: 30px;
            width: 380px;
            max-width: calc(100% - 60px);
            height: 520px;
            max-height: calc(100vh - 150px);
            background: var(--chat-bg);
            border-radius: 28px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.2);
            display: none; /* Logic toggle ẩn hiện */
            flex-direction: column;
            overflow: hidden;
            z-index: 1000;
            border: 1px solid rgba(0,0,0,0.05);
        }

        .chat-header { 
            background: white; color: #1e293b; 
            padding: 20px; font-weight: 800; font-size: 1.2rem;
            border-bottom: 1px solid #f1f5f9;
            display: flex; justify-content: space-between; align-items: center;
        }

        .chat-list { flex-grow: 1; overflow-y: auto; }

        /* Item chat danh sách Messenger */
        .chat-item { 
            padding: 15px 20px; 
            border-bottom: 1px solid #f8fafc; 
            transition: 0.2s;
            cursor: pointer;
            display: flex;
            align-items: center;
        }
        .chat-item:hover { background-color: #f8fafc; }
        
        /* Ghim AI lên đầu */
        .chat-item.ai-pinned { 
            background-color: #f0f7ff; 
            border-left: 5px solid var(--primary-color); 
        }

        .avatar-container { position: relative; margin-right: 15px; }
        .avatar-img { width: 52px; height: 52px; border-radius: 16px; object-fit: cover; }
        
        .online-dot { 
            width: 12px; height: 12px; background: #10b981; 
            border: 2px solid white; border-radius: 50%; 
            position: absolute; bottom: 0; right: 0;
        }

        .chat-info { flex-grow: 1; overflow: hidden; }
        .chat-info-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px; }
        .chat-name { font-weight: 700; color: #1e293b; font-size: 0.95rem; }
        .chat-time { font-size: 0.75rem; color: #94a3b8; }
        .chat-preview { 
            font-size: 0.85rem; color: #64748b; 
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis; 
        }

        @@media (max-width: 576px) {
        #chat-window { right: 15px; bottom: 90px; width: calc(100% - 30px); }
            #chat-bubble { right: 15px; bottom: 15px; width: 55px; height: 55px; }
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-light sticky-top">
        <div class="container-fluid px-4">
            <div class="dropdown me-2">
                <button class="btn btn-light border-0 shadow-none bg-transparent" type="button" data-bs-toggle="dropdown">
                    <i class="fa-solid fa-bars-staggered text-primary" style="font-size: 22px;"></i>
                </button>
                <ul class="dropdown-menu border-0 shadow-lg p-2 mt-3 rounded-4">
                    <li><h6 class="dropdown-header">Danh mục hệ thống</h6></li>
                    <li><a class="dropdown-item rounded-3 py-2" href="#"><i class="fa-solid fa-layer-group me-2 text-muted"></i> Việc làm đã lưu</a></li>
                    <li><a class="dropdown-item rounded-3 py-2" href="#"><i class="fa-solid fa-rocket me-2 text-muted"></i> Cài đặt gợi ý</a></li>
                </ul>
            </div>

            <a class="navbar-brand fw-bold text-primary" href="/">JOB<span class="text-dark">HUB</span></a>

            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item px-2"><a class="nav-link fw-semibold" href="#">Việc làm</a></li>
                    <li class="nav-item px-2"><a class="nav-link fw-semibold" href="#">Công ty</a></li>
                </ul>

                <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2">
                    <a href="#" class="btn btn-outline-primary fw-bold px-4 rounded-3 border-2 order-2 order-lg-1">
                        Đăng tin tuyển dụng
                    </a>

                    <div class="d-flex align-items-center gap-1 order-1 order-lg-2 ms-lg-2">
                        <a class="nav-link px-3 fw-semibold text-secondary" asp-area="Identity" asp-page="/Account/Register">Đăng ký</a>
                        <a class="btn btn-primary fw-bold px-4 rounded-3 shadow-sm" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <header class="hero-section text-center">
        <div class="container">
            <h1 class="display-4 fw-bold mb-3">Tìm kiếm công việc mơ ước</h1>
            <p class="lead mb-5 opacity-75">Kết nối với hơn 50.000 doanh nghiệp hàng đầu</p>
        </div>
    </header>

    <div class="container position-relative">
        <div class="row justify-content-center">
            <div class="col-md-11 col-lg-10">
                <div class="card search-card p-3 shadow-sm">
                    <div class="row g-2">
                        <div class="col-md-5">
                            <div class="input-group h-100">
                                <span class="input-group-text bg-white border-end-0"><i class="fa fa-search text-muted"></i></span>
                                <input type="text" class="form-control form-control-lg border-start-0 ps-0 shadow-none" placeholder="Kỹ năng, vị trí công việc...">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <select class="form-select form-select-lg text-muted h-100 shadow-none">
                                <option selected disabled>Tất cả địa điểm</option>
                                <option>Hà Nội</option>
                                <option>TP. Hồ Chí Minh</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-primary btn-search w-100 h-100 text-white">Tìm việc ngay</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <main class="container py-5 mt-5">
        <h3 class="fw-bold mb-4">Việc làm mới nhất</h3>
        
    </main>

    <div id="chat-window">
        <div class="chat-header">
            <span>Tin nhắn</span>
            <i class="fa-solid fa-xmark text-muted" style="cursor:pointer" onclick="toggleChat()"></i>
        </div>
        
        <div class="chat-list">
            <div class="chat-item ai-pinned">
                <div class="avatar-container">
                    <img src="https://cdn-icons-png.flaticon.com/512/4712/4712035.png" class="avatar-img">
                    <span class="online-dot"></span>
                </div>
                <div class="chat-info">
                    <div class="chat-info-top">
                        <span class="chat-name text-primary">Trợ lý AI (JobBot)</span>
                        <i class="fa-solid fa-thumbtack text-primary small"></i>
                    </div>
                    <div class="chat-preview fw-bold text-primary">Cần mình giúp chỉnh sửa CV không?</div>
                </div>
            </div>

            
        </div>

        <div class="p-3 border-top text-center bg-light">
            <a href="#" class="text-primary small fw-bold text-decoration-none">Xem tất cả hội thoại</a>
        </div>
    </div>

    <div id="chat-bubble" onclick="toggleChat()">
        <i class="fa-solid fa-comment-dots"></i>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleChat() {
            const chatWin = document.getElementById('chat-window');
            chatWin.style.display = (chatWin.style.display === 'flex') ? 'none' : 'flex';
        }
    </script>
</body>
</html>