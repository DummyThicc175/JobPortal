@model JobPortal.Models.JobPost

@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_LayoutCV.cshtml";
}

<style>
    .job-header-card {
        background: #fff;
        border-radius: 20px;
        padding: 40px;
        border: 1px solid #eef2ff;
        box-shadow: 0 10px 30px rgba(68, 96, 239, 0.05);
        margin-bottom: 30px;
    }

    .job-title {
        font-size: 2.5rem;
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 15px;
    }

    .company-name {
        font-size: 1.25rem;
        color: #4460ef;
        font-weight: 600;
    }

    .info-badge {
        background: #f1f5f9;
        color: #475569;
        padding: 8px 20px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.95rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .salary-badge {
        background: #ecfdf5;
        color: #059669;
    }

    .content-card {
        background: #fff;
        border-radius: 20px;
        padding: 35px;
        border: 1px solid #eef2ff;
    }

    .section-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1e293b;
        position: relative;
        padding-bottom: 15px;
        margin-bottom: 25px;
    }

        .section-title::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: 0;
            width: 50px;
            height: 4px;
            background: #4460ef;
            border-radius: 2px;
        }

    .sidebar-apply {
        position: sticky;
        top: 30px;
        background: #fff;
        border-radius: 20px;
        padding: 30px;
        border: 1px solid #eef2ff;
        box-shadow: 0 10px 30px rgba(0,0,0,0.02);
    }
</style>

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8">
            <div class="job-header-card">
                <h1 class="job-title">@Model.Title</h1>
                <div class="company-name mb-4">
                    <i class="fa-solid fa-building me-2"></i>@Model.CompanyName
                </div>

                <div class="d-flex flex-wrap gap-3 mb-0">
                    <div class="info-badge salary-badge">
                        <i class="fa-solid fa-money-bill-wave"></i>
                        @Model.SalaryRange
                    </div>
                    <div class="info-badge">
                        <i class="fa-solid fa-location-dot"></i>
                        @Model.JobLocation?.Name
                    </div>
                    @if (!string.IsNullOrEmpty(Model.CategoryName))
                    {
                        <div class="info-badge">
                            <i class="fa-solid fa-briefcase"></i>
                            @Model.CategoryName
                        </div>
                    }
                </div>
            </div>

            <div class="content-card">
                <h3 class="section-title">Mô tả công việc</h3>
                <div class="text-secondary lh-lg" style="font-size: 1.1rem;">
                    @Html.Raw(Model.Description)
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="sidebar-apply">
                <h5 class="fw-bold mb-4 text-center">Ứng tuyển ngay</h5>

                <div class="d-grid gap-3">
                    <form asp-action="ApplyJob" method="post">
                        <input type="hidden" name="jobId" value="@Model.Id" />
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold py-3 shadow-sm w-100 mb-3">
                            NỘP HỒ SƠ NGAY
                        </button>
                    </form>

                    <form asp-action="SaveJob" method="post">
                        <input type="hidden" name="jobId" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-danger btn-lg rounded-pill fw-bold py-3 w-100">
                            <i class="fa-regular fa-heart me-2"></i>Lưu tin tuyển dụng
                        </button>
                    </form>
                </div>

                <div class="mt-4 p-3 bg-light rounded-3 text-center">
                    <small class="text-muted d-block mb-1">Cập nhật lần cuối</small>
                    <span class="fw-bold text-dark">@Model.CreatedAt.ToString("dd/MM/yyyy")</span>
                </div>
            </div>
        </div>
    </div>
    @if (TempData["SaveSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mt-3 rounded-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SaveSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ApplySuccess"] != null)
    {
        <div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="card border-0 shadow rounded-4 p-4 text-center w-100">
                    <div class="mb-3">
                        <i class="fa-solid fa-circle-check text-success" style="font-size: 4rem;"></i>
                    </div>
                    <h3 class="fw-bold">Gửi hồ sơ thành công!</h3>
                    <p class="text-muted">Nhà tuyển dụng sẽ sớm xem xét hồ sơ của bạn.</p>
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-primary rounded-pill fw-bold py-2" data-bs-dismiss="modal">Đóng</button>
                        <a asp-area="Candidate" asp-controller="Profile" asp-action="Index" class="btn btn-light rounded-pill fw-bold py-2">
                            Xem việc đã ứng tuyển
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <script>
            document.addEventListener("DOMContentLoaded", function() {
                var myModal = new bootstrap.Modal(document.getElementById('successModal'));
                myModal.show();
            });
        </script>
    }
</div>