@model IEnumerable<JobPortal.Models.JobPost>
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<IdentityUser> UserManager
@inject JobPortal.Data.ApplicationDbContext DbContext

@{
    ViewData["Title"] = "Khám phá việc làm";

    var isAuth = User?.Identity?.IsAuthenticated ?? false;
    var avatarUrl = "/images/default-avatar.png";
    var fullName = "Ứng viên";

    if (isAuth)
    {
        var userEmail = User.Identity.Name;
        var candidate = DbContext.Candidates.AsNoTracking().FirstOrDefault(c => c.Email == userEmail);
        if (candidate != null)
        {
            fullName = candidate.FullName ?? "Ứng viên";
            avatarUrl = candidate.AvatarUrl ?? "/images/default-avatar.png";
        }
    }
}

<style>
    /* Navbar Custom */
    .navbar {
        background: #fff;
        border-bottom: 1px solid #eef2ff;
        padding: 12px 0;
        box-shadow: 0 2px 4px rgba(0,0,0,.04);
    }

    .navbar-brand {
        font-size: 24px;
        letter-spacing: -1px;
    }

    .user-dropdown-menu {
        min-width: 280px;
        border-radius: 16px;
        border: none;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        padding: 12px;
    }

    .submenu-item {
        padding-left: 48px !important;
        font-size: 0.9rem;
        color: #64748b !important;
    }

    /* Job Card Section */
    .job-card {
        transition: all 0.3s ease;
        border-radius: 16px !important;
        border: 1px solid #eef2ff !important;
    }

        .job-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0, 102, 255, 0.1) !important;
            border-color: #0066ff !important;
        }

    .company-logo-box {
        width: 50px;
        height: 50px;
        background: #f1f5f9;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        color: #0066ff;
    }

    /* Empty State Style */
    .empty-state {
        padding: 80px 0;
        text-align: center;
        background: #fff;
        border-radius: 24px;
        border: 1px dashed #cbd5e1;
    }
</style>

@* --- 1. NAVBAR CHỨC NĂNG --- *@
<nav class="navbar navbar-expand-lg navbar-light sticky-top">
    <div class="container">
        <a class="navbar-brand fw-bold text-primary" asp-controller="Home" asp-action="Index">JOB<span class="text-dark">HUB</span></a>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item px-2"><a class="nav-link fw-semibold" asp-controller="Job" asp-action="Index">Việc làm</a></li>
            </ul>

            <div class="d-flex align-items-center gap-3">
              

                @if (isAuth)
                {
                    <div class="dropdown">
                        <div class="d-flex align-items-center gap-2 cursor-pointer" data-bs-toggle="dropdown" style="cursor:pointer">
                            <img src="@avatarUrl" class="rounded-circle border" width="40" height="40" style="object-fit: cover;">
                            <div class="d-none d-md-block text-start">
                                <div class="fw-bold small" style="line-height: 1.2;">@fullName</div>
                                <small class="text-muted" style="font-size: 11px;">@User.Identity.Name</small>
                            </div>
                            <i class="fa-solid fa-chevron-down ms-1 small text-muted"></i>
                        </div>

                        <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu shadow border-0 mt-2">
                            <li>
                                <a class="dropdown-item py-2" asp-area="Candidate" asp-controller="Profile" asp-action="Index">
                                    <i class="fa-regular fa-circle-user text-primary me-2"></i> Hồ sơ của tôi
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item submenu-item" asp-area="Candidate" asp-controller="Profile" asp-action="AppliedJobs">
                                    • Việc làm đã ứng tuyển
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item submenu-item" asp-area="Candidate" asp-controller="Profile" asp-action="SavedJobs">
                                    • Việc làm đã lưu
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                                    <button type="submit" class="dropdown-item text-danger fw-bold border-0 bg-transparent w-100 text-start">
                                        <i class="fa-solid fa-power-off me-2"></i> Đăng xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>
</nav>

@* --- 3. DANH SÁCH VIỆC LÀM --- *@
<main class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">Kết quả tìm kiếm</h3>
        <span class="text-muted">Tìm thấy <strong>@Model.Count()</strong> vị trí</span>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card job-card h-100 shadow-sm border-0">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="company-logo-box">
                                    @(string.IsNullOrEmpty(item.CompanyName) ? "JH" : item.CompanyName.Substring(0, 1).ToUpper())
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-0 text-truncate" style="max-width: 200px;">@item.Title</h5>
                                    <small class="text-muted">@item.CompanyName</small>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mb-4">
                                <span class="badge rounded-pill bg-light text-primary border px-3 py-2">
                                    <i class="fa-solid fa-money-bill-wave me-1"></i> @item.SalaryRange
                                </span>
                                <span class="badge rounded-pill bg-light text-secondary border px-3 py-2">
                                    <i class="fa-solid fa-location-dot me-1"></i> @(item.JobLocation?.Name ?? "Toàn quốc")
                                </span>
                            </div>

                            <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                <small class="text-muted"><i class="fa-regular fa-clock me-1"></i> @item.CreatedAt.ToString("dd/MM/yyyy")</small>
                                <a asp-controller="Home" asp-action="JobDetails" asp-route-id="@item.Id" class="btn btn-primary rounded-pill px-4 fw-bold">
                                    Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        @* --- PHẦN THÔNG BÁO KHI KHÔNG CÓ DỮ LIỆU --- *@
        <div class="empty-state shadow-sm">
            <div class="mb-4">
                <img src="https://cdn-icons-png.flaticon.com/512/7486/7486744.png" width="120" style="opacity: 0.6;" alt="No results">
            </div>
            <h4 class="fw-bold text-dark">Rất tiếc, không tìm thấy việc làm phù hợp</h4>
            <p class="text-muted mb-4">Hãy thử thay đổi từ khóa tìm kiếm hoặc lọc theo địa điểm khác để tìm thấy cơ hội tốt hơn.</p>

            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm">
                <i class="fa-solid fa-house me-2"></i> Quay về trang chủ
            </a>
        </div>
    }
</main>