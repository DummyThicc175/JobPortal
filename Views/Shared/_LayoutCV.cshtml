
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<IdentityUser> UserManager
@inject JobPortal.Data.ApplicationDbContext DbContext
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JobPortal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* Navbar Custom */
        .navbar {
            background: #fff;
            border-bottom: 1px solid #eef2ff;
            padding: 12px 0;
            box-shadow: 0 2px 4px rgba(0,0,0,.04);
        }

        .logo-text {
            font-weight: 800;
            font-size: 24px;
            color: #4460ef;
            text-decoration: none;
        }

        .logo-hub {
            color: #1e293b;
        }

        .nav-link {
            color: #475569 !important;
            font-weight: 500;
            margin-right: 15px;
        }

            .nav-link:hover {
                color: #4460ef !important;
            }

        /* Style cho Dropdown Menu Tài Khoản */
        .user-dropdown-menu {
            min-width: 280px;
            border-radius: 16px;
            border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            padding: 12px;
            margin-top: 10px !important;
        }

            .user-dropdown-menu .dropdown-item {
                padding: 10px 12px;
                border-radius: 8px;
                display: flex;
                align-items: center;
                color: #334155;
                font-weight: 500;
            }

                .user-dropdown-menu .dropdown-item i {
                    width: 24px;
                    margin-right: 12px;
                    font-size: 1.1rem;
                }

                .user-dropdown-menu .dropdown-item:hover {
                    background-color: #f1f5f9;
                    color: #4460ef;
                }

        .submenu-item {
            padding-left: 48px !important;
            font-size: 0.9rem;
            color: #64748b !important;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light mb-3">
            <div class="container">
                <!-- LOGO -->
                <a class="logo-text" asp-area="" asp-controller="Home" asp-action="Index">
                    JOB<span class="logo-hub">HUB</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-4">
                       
                       
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        @* Nút đăng tin tuyển dụng *@
                        @{
                            var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
                        }
                        

                        <!-- Dropdown Tài Khoản (ĐÃ ĐƯA VÀO ĐÚNG VỊ TRÍ) -->
                        <div class="dropdown">
                            @{
                                // Lấy thông tin ứng viên từ Database dựa trên User đang đăng nhập
                                var userId = UserManager.GetUserId(User);
                                var candidate = DbContext.Candidates.AsNoTracking().FirstOrDefault(c => c.Email == User.Identity.Name);

                                var avatarUrl = candidate?.AvatarUrl ?? "/images/default-avatar.png";
                                var fullName = candidate?.FullName ?? "Ứng viên";
                                var jobTitle = candidate?.Industry ?? "Chưa cập nhật vị trí";
                            }

                            <div class="d-flex align-items-center gap-2 cursor-pointer" data-bs-toggle="dropdown" style="cursor:pointer">
                                <img src="@avatarUrl" class="rounded-circle border" width="45" height="45" style="object-fit: cover;">
                                <div class="d-none d-md-block text-start">
                                    <div class="fw-bold small" style="line-height: 1.2;">@fullName</div>
                                    <small class="text-muted" style="font-size: 11px;">@User.Identity.Name</small>
                                </div>
                                <i class="fa-solid fa-chevron-down ms-1 small text-muted"></i>
                            </div>

                            <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu shadow border-0">
                                <li class="px-3 py-2 border-bottom mb-2 d-md-none">
                                    <div class="fw-bold">@fullName</div>
                                    <small class="text-muted">@jobTitle</small>
                                </li>

                                <li>
                                    <a class="dropdown-item" asp-area="Candidate" asp-controller="Profile" asp-action="Index">
                                        <i class="fa-regular fa-circle-user text-primary"></i> Hồ sơ của tôi
                                    </a>
                                    <a class="dropdown-item submenu-item" asp-area="Candidate" asp-controller="Profile" asp-action="AppliedJobs">
                                        • Việc làm đã ứng tuyển
                                    </a>
                                    <a class="dropdown-item submenu-item" asp-area="Candidate" asp-controller="Profile" asp-action="SavedJobs">
                                        • Việc làm đã lưu
                                    </a>
                                </li>

                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                                        <button type="submit" class="dropdown-item text-danger fw-bold border-0 bg-transparent w-100 text-start">
                                            <i class="fa-solid fa-power-off"></i> Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid p-0">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 py-3">
        <div class="container text-center">
            &copy; 2026 - **JobHub** - Kết nối sự nghiệp
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>