    <script type="rocketlazyloadscript" data-rocket-type="text/javascript">document.addEventListener("DOMContentLoaded", function() {
  // phần tử đích (block B)
  const target = document.querySelector(".scroll-target-b");
  if (!target) {
    return;
  }

  // tất cả hình có thể click (A1, A2, A3...)
  const triggers = document.querySelectorAll(".scroll-trigger");

  triggers.forEach(function(block) {
    // cố gắng bắt click trên <a> bao hình
    let clickEl = block.querySelector("a");
    if (!clickEl) {
      // fallback: nếu TagDiv không tạo thẻ <a>, ta dùng chính block
      clickEl = block;
    }

    clickEl.style.cursor = "pointer";

    clickEl.addEventListener("click", function(e) {
      // chặn mở tab mới / follow link mặc định
      e.preventDefault();
      e.stopPropagation();

      // cuộn mượt xuống phần B
      window.scrollTo({
        top: target.getBoundingClientRect().top + window.pageYOffset,
        behavior: "smooth"
      });
    });
  });
});
</script><script type="text/javascript" id="eio-lazy-load-js-before">
