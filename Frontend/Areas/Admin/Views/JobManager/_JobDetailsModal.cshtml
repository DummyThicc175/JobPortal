<div class="modal fade" id="job-details-modal" tabindex="-1" aria-labelledby="job-modal-title" aria-hidden="true">
<div class="modal-dialog modal-lg modal-dialog-centered">
<div class="modal-content">
<div class="modal-header">
<div>
<span class="eyebrow">NỘI DUNG TUYỂN DỤNG</span>
<h2 id="job-modal-title" class="modal-title mt-1">Chi tiết tin tuyển dụng</h2>
</div>
<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng chi tiết tin">
</button>
</div>
<div class="modal-body">
<p id="job-modal-status" role="status" class="small">Đang tải nội dung…</p>
<div id="job-modal-data" hidden>
<dl class="info-grid">
<div>
<dt>Doanh nghiệp</dt>
<dd data-job-field="company">
</dd>
</div>
<div>
<dt>Ngành nghề</dt>
<dd data-job-field="category">
</dd>
</div>
<div>
<dt>Địa điểm</dt>
<dd data-job-field="location">
</dd>
</div>
<div>
<dt>Mức lương</dt>
<dd data-job-field="salary">
</dd>
</div>
<div>
<dt>Ngày đăng</dt>
<dd data-job-field="createdAt">
</dd>
</div>
</dl>
<hr class="my-4" />
<h3 class="mb-3">Mô tả công việc</h3>
<div class="description" data-job-field="description">
</div>
</div>
</div>
<div class="modal-footer">
<button class="btn btn-light" data-bs-dismiss="modal" type="button">Đóng</button>
</div>
</div>
</div>
</div>