@page
@model RegisterModel
@{ ViewData["Title"] = "Tạo tài khoản"; }
<div class="auth-shell">
<aside class="auth-story">
<div>
<span class="eyebrow">KHỞI ĐẦU CÙNG JOBHUB</span>
<h2>Mỗi tài năng.<br />Một hành trình riêng.</h2>
<p>Dù bạn đang tìm bước tiến tiếp theo hay người đồng hành cho đội ngũ, hãy bắt đầu tại đây.</p>
</div>
<ul>
<li>
<svg class="icon" aria-hidden="true">
<use href="/images/icons.svg#user" />
</svg>Ứng viên: tạo hồ sơ và ứng tuyển</li>
<li>
<svg class="icon" aria-hidden="true">
<use href="/images/icons.svg#building" />
</svg>Nhà tuyển dụng: đăng tin và kết nối</li>
<li>
<svg class="icon" aria-hidden="true">
<use href="/images/icons.svg#shield" />
</svg>Không gian riêng theo vai trò của bạn</li>
</ul>
<span class="small" style="color:#91b8a6">JobHub · Kết nối cơ hội</span>
</aside>
<section class="auth-form">
<span class="eyebrow">RẤT VUI ĐƯỢC GẶP BẠN</span>
<h1 class="mt-2">Bắt đầu cùng JobHub.</h1>
<p>Tạo tài khoản và chuẩn bị cho những kết nối mới.</p>
<form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
<div asp-validation-summary="ModelOnly" role="alert">
</div>
<div class="mb-3">
<label asp-for="Input.Email" class="form-label">Địa chỉ email</label>
<input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="ban@example.com" />
<span asp-validation-for="Input.Email">
</span>
</div>
<div class="mb-3">
<label asp-for="Input.Role" class="form-label">Bạn tham gia với vai trò nào?</label>
<select asp-for="Input.Role" asp-items="Model.RoleList" class="form-select">
<option value="">Chọn loại tài khoản</option>
</select>
<span asp-validation-for="Input.Role">
</span>
</div>
<div class="mb-3">
<label asp-for="Input.Password" class="form-label">Mật khẩu</label>
<div class="password-field">
<input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Tạo mật khẩu" />
<button type="button" data-password-toggle="Input_Password" aria-pressed="false" aria-label="Hiện hoặc ẩn mật khẩu">Hiện</button>
</div>
<span asp-validation-for="Input.Password">
</span>
</div>
<div class="mb-4">
<label asp-for="Input.ConfirmPassword" class="form-label">Nhập lại mật khẩu</label>
<input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Xác nhận mật khẩu" />
<span asp-validation-for="Input.ConfirmPassword">
</span>
</div>
<button id="registerSubmit" type="submit" class="btn btn-primary w-100">Tạo tài khoản <svg class="icon icon-sm" aria-hidden="true">
<use href="/images/icons.svg#arrow" />
</svg>
</button>
</form>
<div class="auth-bottom">Đã có tài khoản? <a asp-page="./Login">
<strong>Đăng nhập</strong>
</a>
</div>
</section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }