@model JobPortal.Models.EditCVViewModel
@using JobPortal.Models
@{ ViewData["Title"] = "Thiết kế CV"; ViewData["Description"] = "Nội dung của bạn, bố cục phù hợp và một bản CV sẵn sàng ứng tuyển."; var mau = CvTemplateCatalog.LayMau(Model.TemplateId)!; }
@section Styles { <link rel="stylesheet" href="~/css/cv-studio.css" asp-append-version="true" /> }
<div id="cv-studio" class="cv-studio">
    @Html.AntiForgeryToken()
    <div class="cv-studio-toolbar panel">
        <div class="cv-studio-template"><label for="cvTemplateSelect">Mẫu đang dùng</label><select id="cvTemplateSelect" class="form-select form-select-sm">@foreach (var m in CvTemplateCatalog.Templates) { <option value="@m.Id" selected="@(m.Id == Model.TemplateId)">@m.Name</option> }</select><span id="cvDirtyStatus" class="small muted" role="status">Sẵn sàng chỉnh sửa</span></div>
        <div class="cv-studio-actions"><button type="button" id="btnCheckAI" class="btn btn-light">✧ Đánh giá CV bằng AI</button><button type="button" id="btnSaveCV" class="btn btn-outline-primary">Lưu CV</button><button type="button" id="btnDownloadPDF" class="btn btn-primary">Lưu & tải PDF</button></div>
    </div>
    <div id="cvSaveStatus" class="alert alert-info" role="status" hidden></div>
    <div class="cv-studio-saved"><a id="cvStoredDownload" href="@(Model.Id > 0 ? "/CV/Download/" + Model.Id : "#")" target="_blank" rel="noopener" hidden="@(Model.Id <= 0)">Xem PDF đã lưu ↗</a><span class="small muted">CV đã nộp trước đây vẫn giữ nguyên bản tại thời điểm ứng tuyển.</span></div>
    <div class="cv-studio-grid">
        <div class="cv-studio-inspector panel">
            <div class="cv-studio-tabs" role="tablist" aria-label="Chỉnh sửa CV"><button type="button" id="cv-tab-content" role="tab" aria-selected="true" aria-controls="cv-panel-content" data-cv-tab="content">Nội dung</button><button type="button" id="cv-tab-layout" role="tab" aria-selected="false" aria-controls="cv-panel-layout" data-cv-tab="layout" tabindex="-1">Bố cục & màu sắc</button></div>
            <div class="cv-studio-inspector-body">
                <section id="aiReviewSection" class="cv-ai-review d-none" aria-label="Kết quả đánh giá CV"><div class="cv-ai-heading"><strong>Đánh giá nội dung bằng AI</strong><span id="aiScoreBadge" class="cv-ai-score"></span></div><ul id="aiSuggestionsList"></ul><p class="small muted">Gợi ý mang tính tham khảo. Đổi nội dung cần đánh giá lại; đổi màu hoặc bố cục giữ nguyên kết quả.</p></section>
                <div id="cv-panel-content" role="tabpanel" aria-labelledby="cv-tab-content">
                    <details class="cv-form-section" open><summary><span>01</span> Thông tin cá nhân</summary><div class="cv-form-section-body">
                        <div class="cv-avatar-control"><img id="imgAvatarForm" src="@(Model.AvatarPath ?? "/images/avatar-placeholder.svg")" alt="Ảnh đại diện CV" /><div><label for="uploadAvatarFile" class="form-label">Ảnh đại diện</label><input type="file" id="uploadAvatarFile" class="form-control form-control-sm" accept="image/png,image/jpeg" /><small class="muted">PNG/JPEG, tối đa 2 MB. Có thể để trống.</small></div></div>
                        @foreach (var f in new[] { ("inName", "Họ và tên *", Model.FullName, 200, "text"), ("inJob", "Vị trí công việc *", Model.JobTitle, 200, "text"), ("inEmail", "Email *", Model.Email, 256, "email"), ("inPhone", "Điện thoại", Model.Phone, 30, "tel"), ("inAddress", "Địa chỉ", Model.Address, 500, "text"), ("inWebsite", "Website / liên kết cá nhân", Model.Website, 500, "text") })
                        { <label class="form-label" for="@f.Item1">@f.Item2</label><input class="form-control form-control-sm" id="@f.Item1" type="@f.Item5" value="@f.Item3" maxlength="@f.Item4" data-cv-content /> }
                    </div></details>
                    <details class="cv-form-section" open><summary><span>02</span> Giới thiệu bản thân</summary><div class="cv-form-section-body"><label for="inSummary" class="form-label">Mục tiêu và điểm mạnh</label><textarea id="inSummary" class="form-control" rows="4" maxlength="4000" data-cv-content>@Model.Summary</textarea></div></details>
                    <details class="cv-form-section" open><summary><span>03</span> Kinh nghiệm làm việc</summary><div class="cv-form-section-body"><div id="experienceContainer"></div><button type="button" class="btn btn-light btn-sm" id="cv-add-experience">+ Thêm kinh nghiệm</button></div></details>
                    <details class="cv-form-section" open><summary><span>04</span> Học vấn</summary><div class="cv-form-section-body"><div id="educationContainer"></div><button type="button" class="btn btn-light btn-sm" id="cv-add-education">+ Thêm học vấn</button></div></details>
                    <details class="cv-form-section" open><summary><span>05</span> Kỹ năng & ngoại ngữ</summary><div class="cv-form-section-body"><label for="inSkills" class="form-label">Kỹ năng — mỗi dòng một kỹ năng</label><textarea id="inSkills" class="form-control" rows="4" maxlength="20000" data-cv-content></textarea><label for="inLang" class="form-label">Ngoại ngữ — mỗi dòng một ngôn ngữ</label><textarea id="inLang" class="form-control" rows="3" maxlength="20000" data-cv-content></textarea></div></details>
                    @foreach (var f in new[] { ("inCertifications", "06", "Chứng chỉ", Model.Certifications), ("inActivities", "07", "Hoạt động / dự án", Model.Activities), ("inInterests", "08", "Sở thích", Model.Interests) })
                    { <details class="cv-form-section"><summary><span>@f.Item2</span> @f.Item3</summary><div class="cv-form-section-body"><label for="@f.Item1" class="form-label">@f.Item3</label><textarea id="@f.Item1" class="form-control" rows="4" maxlength="4000" data-cv-content>@f.Item4</textarea></div></details> }
                    <details class="cv-form-section"><summary><span>09</span> Người tham chiếu</summary><div class="cv-form-section-body"><div id="referenceContainer"></div><button type="button" class="btn btn-light btn-sm" id="cv-add-reference">+ Thêm người tham chiếu</button></div></details>
                </div>
                <div id="cv-panel-layout" role="tabpanel" aria-labelledby="cv-tab-layout" hidden>
                    <div class="cv-layout-intro"><span class="eyebrow">SẮP XẾP THEO CÁCH CỦA BẠN</span><h3>Từng khối, đúng vị trí</h3><p>Kéo khối để đổi thứ tự hoặc chuyển cột. Có thể dùng nút lên, xuống và chuyển cột. Khối chưa có nội dung không xuất hiện trên PDF.</p><button type="button" id="cv-reset-layout" class="btn btn-light btn-sm">Khôi phục bố cục mẫu</button></div>
                    <div id="cv-layout-zones"><section class="cv-layout-column"><h4>Cột chính</h4><ol id="cv-layout-main" class="cv-layout-list" data-drop-zone="main" aria-label="Các khối trong cột chính"></ol></section><section id="cv-layout-side-column" class="cv-layout-column"><h4>Cột phụ</h4><ol id="cv-layout-side" class="cv-layout-list" data-drop-zone="side" aria-label="Các khối trong cột phụ"></ol></section></div>
                    <div id="cv-layout-message" class="small muted" role="status" aria-live="polite"></div>
                    <div class="cv-color-controls"><h3>Màu sắc</h3>@foreach (var f in new[] { ("themeColorPicker", "Màu nhấn", Model.ThemeColor ?? mau.Accent), ("headerBgColorPicker", "Màu nền đầu trang", Model.HeaderColor ?? mau.Header), ("bgColorPicker", "Màu nền giấy", Model.BackgroundColor ?? mau.Background) }) { <label for="@f.Item1">@f.Item2<input id="@f.Item1" type="color" value="@f.Item3" /></label> }</div>
                </div>
            </div>
        </div>
        <section class="cv-studio-preview" aria-label="Xem trước CV"><div class="cv-preview-topline"><span>XEM TRƯỚC · A4</span><div><button type="button" id="cv-zoom-out" class="btn btn-light btn-sm" aria-label="Thu nhỏ CV">−</button><output id="cvZoomValue">70%</output><button type="button" id="cv-zoom-in" class="btn btn-light btn-sm" aria-label="Phóng to CV">+</button><span id="cvPageCount" class="small muted"></span></div></div><div id="cv-preview-viewport" class="cv-preview-viewport"><div id="cv-preview-scaler"><div id="cvSheet"></div></div></div><p id="cv-pagination-note" class="small muted" role="status">Các trang xem trước cũng là các trang được xuất PDF.</p></section>
    </div>
</div>
@section Scripts {
    <script id="cv-editor-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model))</script>
    <script id="cv-template-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(CvTemplateCatalog.Templates))</script>
    <script src="~/lib/html2pdf/html2pdf.bundle.min.js"></script>
    <script src="~/js/cv-builder.js" asp-append-version="true"></script>
}
